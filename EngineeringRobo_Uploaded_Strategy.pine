//@version=6
// Independent screenshot approximation. No original proprietary logic or AI model.
strategy("EngineeringRobo - SL TP Levels r5", overlay=true, max_labels_count=500, max_lines_count=500,
     initial_capital=100000, currency=currency.USD, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.07,
     slippage=2, margin_long=100, margin_short=100,
     calc_on_every_tick=false, calc_on_order_fills=false, process_orders_on_close=false)
// Direct conversion of the newly uploaded indicator; no MNQ tester/session filters.
orderGroup = "Strategy orders"
orderQty = input.float(1.0, "Order quantity (contracts / shares / units)", minval=0.00000001, group=orderGroup, display=display.none)
allowLong = input.bool(true, "Enable BUY trades", group=orderGroup, display=display.none)
allowShort = input.bool(true, "Enable SELL trades", group=orderGroup, display=display.none)
signalMode = input.string("Normal", "Signal direction", options=["Normal", "Inverted (experimental)"], group=orderGroup, tooltip="Normal: Supertrend flips up -> BUY/long; flips down -> SELL/short. The audited losing export used inverted signals. Keep Normal for the intended mapping.", display=display.none)
swapSignals = signalMode == "Inverted (experimental)"
exitGroup = "Per-trade stop and take profit"
stopAtrMult = input.float(1.5, "Stop loss / signal ATR", minval=0.1, step=0.1, group=exitGroup, display=display.none)
targetAtrMult = input.float(2.0, "Take profit / signal ATR", minval=0.1, step=0.1, group=exitGroup, display=display.none)
showTradeLevels = input.bool(true, "Show per-trade entry, stop and TP", group=exitGroup, display=display.none)
retainedTrades = input.int(30, "Trade level history", minval=1, maxval=100, group=exitGroup, display=display.none)
length = input.int(20, "SMA length", minval=2, display=display.none)
slow = input.int(50, "Slow SMA length", minval=3, display=display.none)
piv = input.int(5, "Confirmed pivot strength", minval=1, display=display.none)
mult = input.float(2.5, "Reversal ATR multiplier", minval=0.1, display=display.none)
showPanel = input.bool(true, "Dashboard", display=display.none)
s1 = input.symbol("CRYPTOCAP:TOTAL", "Total market", display=display.none)
s2 = input.symbol("TVC:DXY", "Dollar index", display=display.none)
s3 = input.symbol("BINANCE:BTCUSDT", "BTC reference", display=display.none)
showContextLevels = input.bool(false, "Show pivot support/resistance (context only)", group="Chart context", display=display.none)
atr = ta.atr(14)
ma = ta.sma(close, length)
[st, direction] = ta.supertrend(mult, 10)
rawBuy = ta.crossunder(direction, 0)
rawSell = ta.crossover(direction, 0)
buy = barstate.isconfirmed and (swapSignals ? rawSell : rawBuy)
sell = barstate.isconfirmed and (swapSignals ? rawBuy : rawSell)
// Confirmed pivots are displayed when detected, never backdated to the pivot bar.
ph = ta.pivothigh(high, piv, piv)
pl = ta.pivotlow(low, piv, piv)
boostBuy = barstate.isconfirmed and not na(pl) and ta.rsi(close, 14) < 45
boostSell = barstate.isconfirmed and not na(ph) and ta.rsi(close, 14) > 55
// Snapshot distances once per accepted main signal; relative exits anchor to fills.
var float longStopTicks = na
var float longTargetTicks = na
var float shortStopTicks = na
var float shortTargetTicks = na
submittedLong = false
submittedShort = false
entryAtrReady = not na(atr) and atr > 0 and syminfo.mintick > 0
if buy
    if allowLong and strategy.position_size <= 0 and entryAtrReady
        longStopTicks := math.max(1, math.ceil(stopAtrMult * atr / syminfo.mintick))
        longTargetTicks := math.max(1, math.ceil(targetAtrMult * atr / syminfo.mintick))
        strategy.entry("Long", strategy.long, qty=orderQty, comment="AI BUY", alert_message="EngineeringRobo: target position LONG")
        submittedLong := true
    else if not allowLong and strategy.position_size < 0
        strategy.close("Short", comment="BUY closes short", alert_message="EngineeringRobo: close SHORT")
if sell
    if allowShort and strategy.position_size >= 0 and entryAtrReady
        shortStopTicks := math.max(1, math.ceil(stopAtrMult * atr / syminfo.mintick))
        shortTargetTicks := math.max(1, math.ceil(targetAtrMult * atr / syminfo.mintick))
        strategy.entry("Short", strategy.short, qty=orderQty, comment="AI SELL", alert_message="EngineeringRobo: target position SHORT")
        submittedShort := true
    else if not allowShort and strategy.position_size > 0
        strategy.close("Long", comment="SELL closes long", alert_message="EngineeringRobo: close LONG")
// Each bracket is placed alongside its entry, before waiting for fill detection.
// Profit and loss are tick distances from the actual fill, not moving ATR prices.
if not na(longStopTicks) and not na(longTargetTicks)
    strategy.exit("Long SL TP", from_entry="Long", loss=longStopTicks, profit=longTargetTicks, comment_loss="Stop Loss", comment_profit="AI Take Profit", alert_loss="EngineeringRobo: LONG stop loss", alert_profit="EngineeringRobo: LONG take profit")
if not na(shortStopTicks) and not na(shortTargetTicks)
    strategy.exit("Short SL TP", from_entry="Short", loss=shortStopTicks, profit=shortTargetTicks, comment_loss="Stop Loss", comment_profit="AI Take Profit", alert_loss="EngineeringRobo: SHORT stop loss", alert_profit="EngineeringRobo: SHORT take profit")
closedThisBar = strategy.closedtrades > nz(strategy.closedtrades[1])
profit = closedThisBar and strategy.closedtrades.exit_comment(strategy.closedtrades - 1) == "AI Take Profit"
stopped = closedThisBar and strategy.closedtrades.exit_comment(strategy.closedtrades - 1) == "Stop Loss"
// A plan is dotted until matched to actual open/closed trade records.
// Filled plans become solid and stop at their recorded exit; history stays visible.
type TradePlan
    int signalBar
    int tradeSide
    float stopTicks
    float targetTicks
    line entryLine
    line stopLine
    line targetLine
    label info
    bool filled
    bool done
    int fillBar
var array<TradePlan> tradePlans = array.new<TradePlan>()
f_applyFill(TradePlan plan, int entryBar, float fillPrice, int endBar, bool isClosed, string exitReason) =>
    float sl = fillPrice - plan.tradeSide * plan.stopTicks * syminfo.mintick
    float tp = fillPrice + plan.tradeSide * plan.targetTicks * syminfo.mintick
    line.set_xy1(plan.entryLine, entryBar, fillPrice)
    line.set_xy2(plan.entryLine, math.max(entryBar + 1, endBar), fillPrice)
    line.set_xy1(plan.stopLine, entryBar, sl)
    line.set_xy2(plan.stopLine, math.max(entryBar + 1, endBar), sl)
    line.set_xy1(plan.targetLine, entryBar, tp)
    line.set_xy2(plan.targetLine, math.max(entryBar + 1, endBar), tp)
    line.set_style(plan.entryLine, line.style_solid)
    line.set_style(plan.stopLine, line.style_solid)
    line.set_style(plan.targetLine, line.style_solid)
    line.set_extend(plan.entryLine, isClosed ? extend.none : extend.right)
    line.set_extend(plan.stopLine, isClosed ? extend.none : extend.right)
    line.set_extend(plan.targetLine, isClosed ? extend.none : extend.right)
    line.set_color(plan.entryLine, color.gray)
    line.set_color(plan.stopLine, color.red)
    line.set_color(plan.targetLine, color.lime)
    label.set_xy(plan.info, entryBar, fillPrice)
    string state = isClosed ? "CLOSED: " + exitReason : "FILLED / OPEN"
    label.set_text(plan.info, (plan.tradeSide == 1 ? "LONG " : "SHORT ") + state + "\nEntry " + str.tostring(fillPrice, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick))
    label.set_color(plan.info, plan.tradeSide == 1 ? color.new(color.green, 15) : color.new(color.red, 15))
    label.set_textcolor(plan.info, color.white)
    plan.filled := true
    plan.done := isClosed
    plan.fillBar := entryBar

// Closed-trade records also capture entries and exits occurring within one bar.
if showTradeLevels and closedThisBar and array.size(tradePlans) > 0
    for trade = nz(strategy.closedtrades[1]) to strategy.closedtrades - 1
        int entryBar = strategy.closedtrades.entry_bar_index(trade)
        int tradeSide = strategy.closedtrades.size(trade) > 0 ? 1 : -1
        for offset = 0 to array.size(tradePlans) - 1
            TradePlan plan = array.get(tradePlans, array.size(tradePlans) - 1 - offset)
            bool matches = not plan.done and plan.tradeSide == tradeSide and (plan.filled ? plan.fillBar == entryBar : plan.signalBar < entryBar)
            if matches
                f_applyFill(plan, entryBar, strategy.closedtrades.entry_price(trade), strategy.closedtrades.exit_bar_index(trade), true, strategy.closedtrades.exit_comment(trade))
                break
if showTradeLevels and strategy.opentrades > 0 and array.size(tradePlans) > 0
    for trade = 0 to strategy.opentrades - 1
        int entryBar = strategy.opentrades.entry_bar_index(trade)
        int tradeSide = strategy.opentrades.size(trade) > 0 ? 1 : -1
        for offset = 0 to array.size(tradePlans) - 1
            TradePlan plan = array.get(tradePlans, array.size(tradePlans) - 1 - offset)
            bool matches = not plan.done and plan.tradeSide == tradeSide and (plan.filled ? plan.fillBar == entryBar : plan.signalBar < entryBar)
            if matches
                f_applyFill(plan, entryBar, strategy.opentrades.entry_price(trade), bar_index + 1, false, "")
                break
if showTradeLevels and (submittedLong or submittedShort)
    // Superseded unfilled plans remain dotted and explicitly say NOT FILLED.
    if array.size(tradePlans) > 0
        for index = 0 to array.size(tradePlans) - 1
            TradePlan old = array.get(tradePlans, index)
            if not old.filled and not old.done
                line.set_extend(old.entryLine, extend.none)
                line.set_extend(old.stopLine, extend.none)
                line.set_extend(old.targetLine, extend.none)
                line.set_x2(old.entryLine, bar_index)
                line.set_x2(old.stopLine, bar_index)
                line.set_x2(old.targetLine, bar_index)
                label.set_text(old.info, "NOT FILLED / superseded")
                old.done := true
    int tradeSide = submittedLong ? 1 : -1
    float stopTicks = submittedLong ? longStopTicks : shortStopTicks
    float targetTicks = submittedLong ? longTargetTicks : shortTargetTicks
    float projectedSL = close - tradeSide * stopTicks * syminfo.mintick
    float projectedTP = close + tradeSide * targetTicks * syminfo.mintick
    line e = line.new(bar_index, close, bar_index + 1, close, extend=extend.right, color=color.gray, style=line.style_dotted, force_overlay=true)
    line sl = line.new(bar_index, projectedSL, bar_index + 1, projectedSL, extend=extend.right, color=color.new(color.red, 40), style=line.style_dotted, width=2, force_overlay=true)
    line tp = line.new(bar_index, projectedTP, bar_index + 1, projectedTP, extend=extend.right, color=color.new(color.lime, 40), style=line.style_dotted, width=2, force_overlay=true)
    label info = label.new(bar_index, close, (tradeSide == 1 ? "LONG" : "SHORT") + " SUBMITTED / fill pending\nProjected SL " + str.tostring(projectedSL, format.mintick) + " | TP " + str.tostring(projectedTP, format.mintick), style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.small, force_overlay=true)
    array.push(tradePlans, TradePlan.new(bar_index, tradeSide, stopTicks, targetTicks, e, sl, tp, info, false, false, na))
    while array.size(tradePlans) > retainedTrades
        TradePlan old = array.shift(tradePlans)
        line.delete(old.entryLine)
        line.delete(old.stopLine)
        line.delete(old.targetLine)
        label.delete(old.info)

// Active values below refer only to confirmed filled positions.
activeEntry = strategy.position_size != 0 ? strategy.position_avg_price : na
activeStop = strategy.position_size > 0 ? activeEntry - longStopTicks * syminfo.mintick : strategy.position_size < 0 ? activeEntry + shortStopTicks * syminfo.mintick : na
activeTarget = strategy.position_size > 0 ? activeEntry + longTargetTicks * syminfo.mintick : strategy.position_size < 0 ? activeEntry - shortTargetTicks * syminfo.mintick : na
plot(showTradeLevels ? activeEntry : na, title="Active entry fill", color=color.gray, linewidth=1, style=plot.style_linebr, display=display.data_window)
plot(showTradeLevels ? activeStop : na, title="Active stop loss", color=color.red, linewidth=2, style=plot.style_linebr, display=display.data_window)
plot(showTradeLevels ? activeTarget : na, title="Active take profit", color=color.lime, linewidth=2, style=plot.style_linebr, display=display.data_window)
plotshape(stopped, title="Filled stop loss", text="STOP LOSS", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny, force_overlay=true)

plotshape(buy, title="Buy", text="AI BUY", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(sell, title="Sell", text="AI SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.black, size=size.tiny)
plotshape(boostBuy, title="Boost buy", text="Super Boost Buy", style=shape.triangleup, location=location.belowbar, color=color.lime, textcolor=color.blue, size=size.tiny)
plotshape(boostSell, title="Boost sell", text="Super Boost Sell", style=shape.triangledown, location=location.abovebar, color=color.red, textcolor=color.blue, size=size.tiny)
plotshape(profit, title="Filled take profit", text="AI Take Profit", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.tiny)
var float resistance = na
var float support = na
if barstate.isconfirmed
    if not na(ph)
        resistance := ph
    if not na(pl)
        support := pl
plot(showContextLevels ? resistance : na, "Pivot resistance (context)", color.new(color.gray, 65), 1, plot.style_stepline)
plot(showContextLevels ? support : na, "Pivot support (context)", color.new(color.gray, 65), 1, plot.style_stepline)
// Previous completed source bars; higher-timeframe values do not use future data.
f_trend(string symbol, string tf) =>
    request.security(symbol, tf, close[1] > ta.sma(close, slow)[1] ? 1 : -1, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
f_metrics(string symbol) =>
    request.security(symbol, timeframe.period, [100 * ta.atr(14)[1] / close[1], ta.rsi(close, 14)[1], volume[1] > ta.sma(volume, 96)[1] ? 1 : 0, ta.change(close)[1], ta.mfi(hlc3, 14)[1]], ignore_invalid_symbol=true)
var table panel = table.new(position.middle_right, 5, 14, border_width=1, border_color=color.white)
navy = color.rgb(61, 73, 116)
f_cell(int col, int row, string txt, color bg) =>
    table.cell(panel, col, row, txt, bgcolor=bg, text_color=bg == navy or bg == color.blue ? color.white : color.black, text_size=size.small)
// Requests run on every bar so series history remains available.
btcReturn = request.security(s3, timeframe.period, ta.change(close)[1], ignore_invalid_symbol=true)
for col = 1 to 4
    symbol = col == 1 ? syminfo.tickerid : col == 2 ? s1 : col == 3 ? s2 : s3
    [volatility, rsi, volumeHigh, priceReturn, money] = f_metrics(symbol)
    correlation = ta.correlation(priceReturn, btcReturn, 30)
    int votes = 0
    for row = 4 to 8
        tf = row == 4 ? "1W" : row == 5 ? "1D" : row == 6 ? "180" : row == 7 ? "45" : "15"
        trend = f_trend(symbol, tf)
        votes += nz(trend)
        if barstate.islast and showPanel
            f_cell(col, row, na(trend) ? "N/A" : trend == 1 ? "BULLISH" : "BEARISH", na(trend) ? color.gray : trend == 1 ? color.green : color.red)
    if barstate.islast and showPanel
        f_cell(col, 0, col == 1 ? syminfo.ticker : col == 2 ? "TOTAL" : col == 3 ? "DXY" : "BTCUSDT", navy)
        f_cell(col, 1, na(volumeHigh) ? "N/A" : volumeHigh == 1 ? "HIGH" : "LOW", color.yellow)
        f_cell(col, 2, str.tostring(volatility, "#.##") + "%", color.yellow)
        f_cell(col, 3, str.tostring(correlation, "#.##"), color.yellow)
        f_cell(col, 9, votes > 0 ? "BULLISH" : "BEARISH", votes > 0 ? color.green : color.red)
        f_cell(col, 10, (rsi > 70 ? "Overbought " : rsi < 30 ? "Oversold " : "Neutral ") + str.tostring(rsi, "#.#"), color.gray)
        f_cell(col, 11, na(money) ? "N/A" : money > 50 ? "IN" : "OUT", na(money) ? color.gray : money > 50 ? color.green : color.red)
if barstate.islast and showPanel
    names = array.from("DASHBOARD", "Volume / 96 bars", "ATR volatility %", "Return corr to BTC", "1W", "1D", "3H", "45M", "15M", "Majority trend", "RSI", "MFI proxy", "Social score", "Approximation")
    for row = 0 to 13
        f_cell(0, row, array.get(names, row), navy)
    f_cell(2, 12, "N/A: no social feed", color.gray)
    f_cell(2, 13, "Independent rules", color.orange)
// Fill markers use broker-emulator positions, not raw entry signals.
filledLong = (strategy.position_size > 0 and nz(strategy.position_size[1], 0) <= 0) or (closedThisBar and strategy.closedtrades.entry_bar_index(strategy.closedtrades - 1) == bar_index and strategy.closedtrades.size(strategy.closedtrades - 1) > 0)
filledShort = (strategy.position_size < 0 and nz(strategy.position_size[1], 0) >= 0) or (closedThisBar and strategy.closedtrades.entry_bar_index(strategy.closedtrades - 1) == bar_index and strategy.closedtrades.size(strategy.closedtrades - 1) < 0)
filledFlat = strategy.position_size == 0 and (nz(strategy.position_size[1], 0) != 0 or closedThisBar)
plotshape(filledLong, title="Actual long entry", text="FILLED LONG", style=shape.labelup, location=location.belowbar, color=color.blue, textcolor=color.white, size=size.small, force_overlay=true)
plotshape(filledShort, title="Actual short entry", text="FILLED SHORT", style=shape.labeldown, location=location.abovebar, color=color.purple, textcolor=color.white, size=size.small, force_overlay=true)
plotshape(filledFlat, title="Actual position close", text="POSITION CLOSED", style=shape.xcross, location=location.abovebar, color=color.orange, textcolor=color.orange, size=size.small, force_overlay=true)
plot(strategy.position_size, title="Filled position quantity", color=color.blue, display=display.status_line + display.data_window)
plot(strategy.closedtrades, title="Actual closed trade count", color=color.orange, display=display.status_line + display.data_window)

// For strategy alerts, select order fills and use {{strategy.order.alert_message}}.

// Surface the effective direction and actual trade count without changing order rules.
var table executionStatus = table.new(position.top_right, 1, 3, border_width=1)
if barstate.islast
    table.cell(executionStatus, 0, 0, "Signal direction: " + signalMode, bgcolor=swapSignals ? color.orange : color.green, text_color=color.white, text_size=size.small)
    table.cell(executionStatus, 0, 1, "BUY long | SELL short | Fixed SL + TP", bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
    table.cell(executionStatus, 0, 2, "Closed: " + str.tostring(strategy.closedtrades) + " | Position: " + str.tostring(strategy.position_size), bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
