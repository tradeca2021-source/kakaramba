//@version=6
strategy("BTC RBO v75 Cost-Aware Fibonacci Entries (Perpetual)", shorttitle="BTC RBO v75 Fib", overlay=true, pyramiding=3, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=100, margin_short=100, max_lines_count=500, max_boxes_count=500, max_labels_count=500, use_bar_magnifier=true, commission_type=strategy.commission.percent, commission_value=0.06, slippage=2, process_orders_on_close=false)

// --- LIBRARY IMPORT ---
// External dependency: access to traderjoeb/PropFirm_News_Dates/6 is required.
import traderjoeb/PropFirm_News_Dates/6 as newsDates
// ----------------------

// ==========================
// Inputs
// ==========================
// 1. Trading Schedule & Sessions
grp_schedule = "Trading Schedule & Sessions"
useTimeRestrictionsNum = input.int(1, title="Use Time & Date Restrictions (0=No, 1=Yes)", minval=0, maxval=1, group=grp_schedule, tooltip="If turned off, the strategy ignores the allowed session, EOD liquidation, and news dates.")
useTimeRestrictions = useTimeRestrictionsNum == 1
allowedSession = input.session("0000-0000", title="Allowed Trading Session", group=grp_schedule, tooltip="New trades will ONLY open during this session (EST).")
useBlockedSessionInt = input.int(0, title="Use Blocked Intra-Day Session (0=No, 1=Yes)", minval=0, maxval=1, group=grp_schedule, tooltip="If Yes, blocks new trades during the specific time window below.")
useBlockedSession = useBlockedSessionInt == 1
blockedIntraDaySessionStr = input.string("0700-0800, 1200-1300, 1400-1630, 1900-2100, 2200-0100", title="Blocked Intra-Day Session", group=grp_schedule, tooltip="Comma-separated list of time windows to block new trades (e.g. '1100-1200, 1930-0100').")

forceCloseOnSessionEndInt = input.int(0, title="Force Close Open Trades when Session Ends (0=No, 1=Yes)", minval=0, maxval=1, group=grp_schedule, tooltip="If 1, open trades are instantly market sold when the allowed session ends or when entering a blocked window. If 0, only new entries are blocked.")
forceCloseOnSessionEnd = forceCloseOnSessionEndInt == 1
useEodLiquidation = input.bool(false, title="Use EOD Liquidation", group=grp_schedule)
eodTimeStr = input.session("1630-1645", title="EOD Liquidation Session", group=grp_schedule, tooltip="Any open trades are force-closed during this time (EST).")
userNoTradeDays = input.string("", title="Additional No Trade Days (YYYY-MM-DD)", group=grp_schedule, tooltip="Comma-separated list of dates to completely block trading. Core FOMC dates are automatically loaded from the library.")
userNewsExclusionWindows = input.string("", title="Additional News Exclusion Windows (YYYY-MM-DD HHMM-HHMM)", group=grp_schedule, tooltip="Blocks trading during a specific time window. Core Tier 1 dates are automatically loaded from the library.")
grp_days = "Trade Days"
tradeMonday = input.bool(true, title="Trade Monday   ", inline="mon", group=grp_days)
blockMondayTime = input.string("", title="    Block Time", inline="mon", group=grp_days, tooltip="Time window to block specifically on this day (e.g., '1000-1100'). Leave empty to trade normally.")

tradeTuesday = input.bool(true, title="Trade Tuesday  ", inline="tue", group=grp_days)
blockTuesdayTime = input.string("", title="    Block Time", inline="tue", group=grp_days)

tradeWednesday = input.bool(true, title="Trade Wednesday", inline="wed", group=grp_days)
blockWednesdayTime = input.string("", title="    Block Time", inline="wed", group=grp_days)

tradeThursday = input.bool(true, title="Trade Thursday ", inline="thu", group=grp_days)
blockThursdayTime = input.string("", title="    Block Time", inline="thu", group=grp_days)

tradeFriday = input.bool(true, title="Trade Friday   ", inline="fri", group=grp_days)
blockFridayTime = input.string("", title="    Block Time", inline="fri", group=grp_days)

tradeSaturday = input.bool(true, title="Trade Saturday", group=grp_days)
blockSaturdayTime = input.string("", title="Saturday Block Time", group=grp_days)

tradeSunday = input.bool(true, title="Trade Sunday   ", inline="sun", group=grp_days)
blockSundayTime = input.string("", title="    Block Time", inline="sun", group=grp_days)



// 2. News & Event Toggles
grp_news_tier1 = "News Toggles: Tier 1 (Market Breakers)"
blockCPI = input.bool(true, title="Block CPI Days", group=grp_news_tier1)
blockNFP = input.bool(true, title="Block NFP Days", group=grp_news_tier1)
blockFOMC = input.bool(true, title="Block FOMC", group=grp_news_tier1)
fomcBlockMode = input.string("Decision Day: 12:00-16:00 ET", title="FOMC Block Mode", options=["Full Meeting Days", "Decision Day: 12:00-16:00 ET"], group=grp_news_tier1, tooltip="Full Meeting Days blocks both days of each FOMC meeting. Decision Day mode blocks new entries from 12:00 PM through 4:00 PM ET on the decision day and force-closes any open position at 1:45 PM ET.")

grp_news_tier2 = "News Toggles: Tier 2 (High Impact)"
blockPPI = input.bool(false, title="Block PPI Days", group=grp_news_tier2)
blockISMMfg = input.bool(false, title="Block ISM Manufacturing", group=grp_news_tier2)
blockISMSrv = input.bool(true, title="Block ISM Services", group=grp_news_tier2)
blockJolts = input.bool(false, title="Block JOLTS", group=grp_news_tier2)
blockMichSent = input.bool(false, title="Block Mich Consumer Sentiment", group=grp_news_tier2)
string baseNewsWindows = ""
if blockCPI
    baseNewsWindows += newsDates.getCPI() + ", "
if blockPPI
    baseNewsWindows += newsDates.getPPI() + ", "
if blockNFP
    baseNewsWindows += newsDates.getNFP() + ", "
if blockISMMfg
    baseNewsWindows += newsDates.getISMMfg() + ", "
if blockISMSrv
    baseNewsWindows += newsDates.getISMSrv() + ", "
if blockJolts
    baseNewsWindows += newsDates.getJOLTS() + ", "
if blockMichSent
    baseNewsWindows += newsDates.getMichSent() + ", "

string baseNoTradeDays = ""
bool useFomcFullMeetingDays = blockFOMC and fomcBlockMode == "Full Meeting Days"
bool useFomcDecisionWindow = blockFOMC and fomcBlockMode == "Decision Day: 12:00-16:00 ET"
if useFomcFullMeetingDays
    baseNoTradeDays += newsDates.getFOMC() + ", "

noTradeDays = baseNoTradeDays + (userNoTradeDays == "" ? "" : userNoTradeDays)
newsExclusionWindows = baseNewsWindows + (userNewsExclusionWindows == "" ? "" : userNewsExclusionWindows)

// 3. Prop Firm Compliance
grp_compliance = "Prop Firm Compliance"
dailyLimitType = input.string("Fixed $", title="Daily Limit Type", options=["Fixed $", "Percentage %"], group=grp_compliance, tooltip="Fixed $ = Calculates limit based on a fixed dollar amount. Percentage % = Calculates limit based on your starting equity.")
dailyLossLimit = input.float(550, title="Daily Loss Entry Lockout ($ or %)", group=grp_compliance, tooltip="Once daily P&L reaches this loss amount, pending entries are canceled and new positions are blocked until the next trading day. Existing positions remain managed normally.")
useDailyHardStopInt = input.int(1, title="Use Daily Liquidation (0=No, 1=Yes)", minval=0, maxval=1, group=grp_compliance, tooltip="If Yes, instantly closes OPEN trades if the total daily loss hits the liquidation threshold.")
useDailyHardStop = useDailyHardStopInt == 1
dailyHardStopLimit = input.float(1000, title="Daily Loss Liquidation Threshold ($ or %)", group=grp_compliance, tooltip="Evaluated on candle close. If total daily P&L is at or below this loss, all open trades are market closed.")
useDailyProfitKillswitchInt = input.int(0, title="Use Daily Profit Killswitch (0=No, 1=Yes)", minval=0, maxval=1, group=grp_compliance, tooltip="If Yes, stops trading and closes open positions when daily profit target is hit.")
useDailyProfitKillswitch = useDailyProfitKillswitchInt == 1
dailyProfitLimit = input.float(2800, title="Daily Profit Limit ($ or %)", group=grp_compliance, tooltip="Target profit for the day.")
usePerTradeProfitKillswitchInt = input.int(0, title="Use Per-Trade Profit Killswitch (0=No, 1=Yes)", minval=0, maxval=1, group=grp_compliance, tooltip="If Yes, instantly exits the trade if the single-trade profit hits the limit.")
usePerTradeProfitKillswitch = usePerTradeProfitKillswitchInt == 1
perTradeProfitLimit = input.float(2800, title="Per-Trade Profit Limit ($ or %)", group=grp_compliance, tooltip="Target profit for a single trade.")
usePerTradeHardStopInt = input.int(1, title="Use Per-Trade Hard Stop (0=No, 1=Yes)", minval=0, maxval=1, group=grp_compliance, tooltip="If Yes, instantly market sells the trade if the single-trade loss exceeds the Per-Trade Hard Stop Limit, regardless of candle close.")
usePerTradeHardStop = usePerTradeHardStopInt == 1
perTradeHardStopLimit = input.float(1.0, title="Per-Trade Hard Stop Limit (%)", group=grp_compliance, step=0.1, tooltip="If a single trade loses this percentage of current account equity, it is market sold immediately.")
maxConsLosses = input.int(3, title="Max Consecutive Losses Per Day", minval=0, group=grp_compliance, tooltip="0 = Off. Stop trading for the day after N losses in a row.")
propFirmDrawdownLimit = input.float(3000, title="Prop Firm Trailing Drawdown ($)", group=grp_compliance, tooltip="Used for the Prop Firm Metrics dashboard to calculate your live buffer against the trailing threshold.")


// 4. Trend & Confirmation Filters
grp_trend = "Trend & Confirmation Filters"
useAdxFilterInt = input.int(1, title="Use ADX Trend Filter (0=Off, 1=On)", minval=0, maxval=1, group=grp_trend, tooltip="0 = Off. 1 = On (Only takes trades if the ADX value is >= the minimum threshold).")
adxLength = input.int(14, title="ADX Length", group=grp_trend, tooltip="Number of bars used in the ADX calculation. 14 is the standard default.")
adxThreshold = input.int(25, title="ADX Minimum Threshold", group=grp_trend, tooltip="Only take trades if the ADX is ABOVE this value. (20-25 is typical for confirming a trend).")
useVwapFilterInt = input.int(1, title="Use VWAP Filter (0=Off, 1=On)", minval=0, maxval=1, group=grp_trend, tooltip="1 = Only take Longs if close > VWAP. Only take Shorts if close < VWAP.")
useVwapFilter = useVwapFilterInt == 1
vwapType = input.string("Daily (24/7)", title="VWAP Type", options=["RTH (Anchored 09:30 AM)", "Session Auto-Anchor (03:00 / 09:30)", "Daily (24/7)"], group=grp_trend, tooltip="Determines how VWAP is anchored. Session Auto-Anchor resets at the NY or London open depending on current time.")
disableVwapAtOpenInt = input.int(1, title="Disable VWAP at NY Open (0=No, 1=Yes)", minval=0, maxval=1, group=grp_trend, tooltip="If Yes, VWAP filter is ignored for the first X minutes of the NY Session (09:30 AM EST).")
disableVwapAtOpen = disableVwapAtOpenInt == 1
disableVwapAtLondonOpenInt = input.int(0, title="Disable VWAP at London Open (0=No, 1=Yes)", minval=0, maxval=1, group=grp_trend, tooltip="If Yes, VWAP filter is ignored for the first X minutes of the London Session (03:00 AM EST).")
disableVwapAtLondonOpen = disableVwapAtLondonOpenInt == 1
disableVwapMinutes = input.int(30, title="Disable VWAP Duration (Minutes)", group=grp_trend, tooltip="Applies to both NY and London disables if activated.")

// Advanced Entry Filters
grp_adv = "Advanced Entry Filters (Chop & Exhaustion)"
useMaxRangeFilterInt = input.int(1, title="Use Max Breakout Range Filter (0=Off, 1=On)", minval=0, maxval=1, group=grp_adv, tooltip="Blocks entries if the FVG forming candle is > X times the current ATR (Exhaustion move).")
useMaxRangeFilter = useMaxRangeFilterInt == 1
maxRangeAtrMult = input.float(4.75, title="Max Breakout Range (ATR Multiplier)", group=grp_adv, step=0.1, tooltip="Cancels the trade if the breakout candle is larger than this many ATRs. Prevents chasing massive outlier candles.")
useMinLongRvolInt = input.int(1, title="Use Minimum Long RVOL (0=Off, 1=On)", minval=0, maxval=1, group=grp_adv, tooltip="Blocks new long FVG setups when the FVG-forming candle's relative volume is below the threshold. Applies to standard and Sweep long setups.")
useMinLongRvol = useMinLongRvolInt == 1
minLongRvol = input.float(1.9, title="Minimum Long RVOL", minval=0.0, step=0.1, group=grp_adv, tooltip="Minimum relative volume required on the long FVG-forming candle. 0 = Disabled.")




// --- EXHAUSTION SCALING ---

useWickRatioFilterInt = input.int(1, title="Use Wick Ratio Filter (0=Off, 1=On)", minval=0, maxval=1, group=grp_adv, tooltip="Blocks entries if the FVG forming candle has a wick larger than X% of its total size (Chop/Indecision).")
useWickRatioFilter = useWickRatioFilterInt == 1
maxWickRatioPct = input.float(60.0, title="Max Wick Ratio (%)", group=grp_adv, minval=0, maxval=100, tooltip="Cancels the trade if the breakout candle's wick makes up more than this percentage of the total candle body. Avoids trading into rejection candles.")




// Smart Exhaustion Guard
grp_smart_exhaustion = "Smart Exhaustion Guard"
useExhaustionGuardInt = input.int(1, title="Use Smart Exhaustion Guard (0=Off, 1=On)", minval=0, maxval=1, group=grp_smart_exhaustion, tooltip="If On, cancels trades during the configured time windows if they trigger an exhaustion climax (High Volume + High VWAP Extension).")
useExhaustionGuard = useExhaustionGuardInt == 1
exhaustionSessionStr = input.string("0500-0600,0900-1100,1300-1400", title="Active Time Windows", group=grp_smart_exhaustion, tooltip="Comma-separated time windows (EST). The default values represent the statistically proven 'Trap Hours' where algorithmic mean-reversion is highest.")
exhaustionVwapAtr = input.float(4.0, title="Exhaustion VWAP Distance (ATR)", group=grp_smart_exhaustion, step=0.1, tooltip="The minimum ATR distance from VWAP to be considered overextended.")
exhaustionRvol = input.float(3.0, title="Exhaustion RVOL Multiplier", group=grp_smart_exhaustion, step=0.1, tooltip="The minimum Relative Volume multiplier to be considered climax volume.")

grp_pullback_vol = "Pullback Volume Guardrail"
useLongPbVolFilterInt = input.int(1, title="Block Longs if Pullback Volume > Limit (0=Off, 1=On)", minval=0, maxval=1, group=grp_pullback_vol, tooltip="If On, blocks long entries if the pullback volume ratio exceeds the limit.")
useLongPbVolFilter = useLongPbVolFilterInt == 1
maxLongPbVolRatio = input.float(0.75, title="Max Long Pullback Vol Ratio", step=0.05, group=grp_pullback_vol)

grp_onh_trap = "Overnight High Trap Guardrail"
useLongOnhTrapFilterInt = input.int(1, title="Block Longs at Overnight High Resistance (0=Off, 1=On)", minval=0, maxval=1, group=grp_onh_trap, tooltip="If On, blocks long entries if the entry price is within the specified distance of the Overnight High.")
useLongOnhTrapFilter = useLongOnhTrapFilterInt == 1
longOnhTrapMinAtr = input.float(-2.0, title="Min Distance from ONH (ATR)", step=0.1, group=grp_onh_trap, tooltip="Distance in ATRs. -2.0 means the entry is 2 ATRs ABOVE the ONH.")
longOnhTrapMaxAtr = input.float(1.0, title="Max Distance from ONH (ATR)", step=0.1, group=grp_onh_trap, tooltip="Distance in ATRs. 1.0 means the entry is 1 ATR BELOW the ONH.")

// 5. Breakouts > Swing
grp_swing = "Breakouts › Swing"
swingTimeframe = input.timeframe("15", title="Swing Timeframe", group=grp_swing, tooltip="The higher timeframe used to detect swing highs and lows. The strategy runs on 1m but identifies structural turning points on this timeframe (e.g. 15m swing highs/lows).")
swingLookback = input.int(2, "Swing Lookback", group=grp_swing, tooltip="How many bars on each side of a candle are needed to confirm it as a swing point. A lookback of 2 means 2 bars left + the swing bar + 2 bars right (5 bars total on the Swing Timeframe).")

// 6. Breakouts > ORB
grp_orb = "Breakouts › ORB"
rearmOrbInt = input.int(1, title="Rearm ORB (0=No, 1=Yes)", minval=0, maxval=1, group=grp_orb, tooltip="If enabled, an ORB can fire a second breakout after the first one. Price must re-enter the range and meet the Rearm Mode criteria before the ORB re-arms. Useful for catching failed breakout reversals.")
rearmOrb = rearmOrbInt == 1
rearmOrbMode = input.int(1, title="Rearm Mode (1=Midpoint, 2=Opposite, 3=Closes)", minval=1, maxval=3, group=grp_orb, tooltip="1 = Price must touch ORB midpoint to reset. 2 = Price must touch opposite ORB side. 3 = Consecutive candle closes inside ORB.")
rearmOrbCandles = input.int(3, title="Rearm Consecutive Closes", group=grp_orb, tooltip="If Mode 3 is selected, how many consecutive candles must close inside the ORB to reset it.")

// 7. Breakouts > ORB > NY Session
grp_orb_ny = "Breakouts › ORB › NY Session"
useNyOrbInt = input.int(1, title="Use NY ORB (0=No, 1=Yes)", minval=0, maxval=1, group=grp_orb_ny, tooltip="Tracks the high and low of the first X minutes after the NY open (09:30 AM EST). These levels become breakout triggers — a close above the ORB high signals bullish, below the ORB low signals bearish.")
useNyOrb = useNyOrbInt == 1
nyOrbDuration = input.string("5", title="NY ORB Duration (Minutes)", options=["5", "10", "15", "30"], group=grp_orb_ny, tooltip="How many minutes after the NY open (09:30 AM) to build the Opening Range. A 5-minute ORB captures the initial auction; 15-30 minutes captures more of the opening balance.")
nyOrbValidSession = input.session("0930-1100", title="NY ORB Valid Session", group=grp_orb_ny, tooltip="NY ORB breakouts are only considered valid during this time window. Once this window closes, the ORB is permanently invalidated for the day.")
useNyOrbOverextensionGuardInt = input.int(1, title="Block Overextended NY ORB Setups (0=No, 1=Yes)", minval=0, maxval=1, group=grp_orb_ny, tooltip="Blocks NY ORB-derived setups when the FVG formation close is too far beyond the broken ORB level. Does not affect Swing, Daily, or London ORB setups.")
useNyOrbOverextensionGuard = useNyOrbOverextensionGuardInt == 1
nyOrbMaxBreakAtr = input.float(1.0, title="NY ORB Max Break Distance (ATR)", minval=0.1, step=0.1, group=grp_orb_ny, tooltip="Maximum allowed NY ORB break distance in ATRs. A setup at or beyond this distance is cancelled. 1.0 blocks the overextended NY ORB cases identified in the v32 export.")

// 8. Breakouts > ORB > London Session
grp_orb_ldn = "Breakouts › ORB › London Session"
useLondonOrbInt = input.int(1, title="Use London ORB (0=No, 1=Yes)", minval=0, maxval=1, group=grp_orb_ldn, tooltip="Tracks the high and low of the first X minutes after the London open (03:00 AM EST / 08:00 London). These levels become breakout triggers for the European session.")
useLondonOrb = useLondonOrbInt == 1
londonOrbDuration = input.string("5", title="London ORB Duration (Minutes)", options=["5", "10", "15", "30"], group=grp_orb_ldn, tooltip="How many minutes after the London open (03:00 AM EST) to build the Opening Range.")
londonOrbValidSession = input.session("0300-0330", title="London ORB Valid Session", group=grp_orb_ldn, tooltip="London ORB breakouts are only considered valid during this time window. Once this window closes, the ORB is permanently invalidated for the day.")
ldnOrbSlMult = input.float(1.0, title="London ORB ATR Stop Modifier", step=0.1, group=grp_orb_ldn, tooltip="Multiplies your base ATR Stop Loss during the London ORB Valid Session. 1.0 = No change. 1.5 = Stop loss is 50% wider.")

// 9. Breakouts > Daily High/Low
grp_daily = "Breakouts › Daily High/Low"
useDailyHlInt = input.int(1, title="Use Daily High/Low (0=No, 1=Yes)", minval=0, maxval=1, group=grp_daily, tooltip="Tracks the running Highest High and Lowest Low of the day during the tracking session. Once a level survives long enough without being broken (see Confirmation Bars), it becomes an established breakout level — similar to a swing point but based on time survival rather than structural reversal.")
useDailyHl = useDailyHlInt == 1
ignorePremarketDailyHLInt = input.int(0, title="Ignore Premarket for Daily H/L (0=No, 1=Yes)", minval=0, maxval=1, group=grp_daily, tooltip="If Yes, the daily high and low will ONLY be tracked during the tracking session. Spikes outside this session will not overwrite the Daily H/L.")
ignorePremarketDailyHL = ignorePremarketDailyHLInt == 1
invalidateDailyHlOnWickInt = input.int(1, title="Invalidate Daily H/L on Wick (0=No, 1=Yes)", minval=0, maxval=1, group=grp_daily, tooltip="If Yes, a wick-only breach freezes the established Daily H/L as a gray dashed invalidation line and starts a new 45-minute candidate. If No, wick-only breaches are ignored; only a close beyond the level resets it.")
invalidateDailyHlOnWick = invalidateDailyHlOnWickInt == 1
dailyHlSession = input.session("0930-1600", title="Daily High/Low Tracking Session", group=grp_daily, tooltip="Highs and lows are only tracked during this session window (e.g. 09:30-16:00 skips premarket). Levels established before this window carry over but won't update until the session reopens.")
dailyConfirmMins = input.int(30, title="Daily H/L Confirmation (Minutes)", group=grp_daily, tooltip="How many real-time minutes the day's high or low must survive without being broken before it becomes an established breakout level. This uses timestamps, so '30' means exactly 30 minutes regardless of whether you're on a 1m or 5m chart.")

// Sweeps / Mean Reversion
grp_sweep = "Sweeps / Mean Reversion"
useSweepsInt = input.int(1, title="Trade HTF Liquidity Sweeps (0=No, 1=Yes)", minval=0, maxval=1, group=grp_sweep, tooltip="1=On. Look for price to sweep HTF swings (Green/Red lines) and then reverse, forming an FVG in the opposite direction. Uses all standard FVG entry/exit logic.")
useSweeps = useSweepsInt == 1
sweepWindow = input.int(41, title="Sweep FVG Window", minval=1, group=grp_sweep, tooltip="How many bars after a sweep can pass before an FVG must form. Reversals often chop around longer than breakouts.")
minSweepScoreToEnter = input.int(54, title="Minimum Sweep Score to Enter", minval=0, maxval=100, group=grp_sweep, tooltip="Minimum score the FVG must have to trigger a Sweep trade. Usually set higher than the main minimum score to filter out weak reversals.")
minSweepVolScoreToEnter = input.int(14, title="Minimum Sweep Volume Score", minval=0, maxval=100, group=grp_sweep, tooltip="Sweeps with low volume are often fakeouts. A minimum of 15 is recommended.")
minSweepRvol = input.float(2.0, title="Minimum Sweep RVol", minval=0.0, step=0.1, group=grp_sweep, tooltip="Minimum Relative Volume (RVol) required for the reversal FVG candle. 0 = Disabled.")
tradeShortSweepsInt = input.int(0, title="Trade Short Sweeps (0=No, 1=Yes)", minval=0, maxval=1, group=grp_sweep, tooltip="Enable bearish liquidity-sweep setups. Default retains the original strategy setting.")
tradeShortSweeps = tradeShortSweepsInt == 1
maxSweepVwapDist = input.float(5.5, title="Max Sweep VWAP Distance (ATRs)", minval=0.0, step=1.0, group=grp_sweep, tooltip="If price sweeps a level but is more than this many ATRs away from VWAP, the reversal is ignored because the 'magnetism' is too weak. 0 = Disabled.")
maxSweepDuration = input.int(22, title="Max Sweep Duration (Bars)", minval=0, group=grp_sweep, tooltip="If price stays beyond the swing level for more than this many bars, it is considered a trend change rather than a liquidity sweep, and the reversal setup is disabled. 0 = Disabled.")


// 9B. Fibonacci Confluence Engine
grp_fib = "Fibonacci Confluence Engine"
useFibConfluenceInt = input.int(1, title="Use Fibonacci Confluence (0=Off, 1=On)", minval=0, maxval=1, group=grp_fib, tooltip="Adds directional Fibonacci context to FVG/ORB/Swing setups. Balanced mode blocks counter-impulse and badly overextended setups without requiring every trade to touch 61.8%.")
useFibConfluence = useFibConfluenceInt == 1
fibMode = input.string("Weighted", title="Fib Confluence Mode", options=["Weighted", "Strict Golden Zone"], group=grp_fib, tooltip="Weighted = Fibonacci improves setup quality without requiring a Golden Zone touch. Only severe invalidation/overextension is blocked. Strict Golden Zone = direction + FVG midpoint must overlap the 23.6%-61.8% continuation zone.")
fibScoreBonus = input.float(8.0, title="Maximum Fib Score Bonus", minval=0.0, maxval=20.0, step=1.0, group=grp_fib, tooltip="Adds quality points to an already valid FVG. Golden-zone alignment receives the largest bonus; directional alignment receives a smaller bonus. Base FVG qualification is still required.")
fibLookback = input.int(120, title="Fib Impulse Lookback (Bars)", minval=20, maxval=1000, group=grp_fib)
fibToleranceAtr = input.float(0.25, title="Fib Zone Tolerance (ATR)", minval=0.0, maxval=2.0, step=0.05, group=grp_fib)
fibMaxExtensionOpt = input.string("1.272", title="Maximum Entry Extension", options=["1.0", "1.272", "1.618"], group=grp_fib, tooltip="Blocks chasing entries beyond this extension of the detected impulse. 1.272 is a balanced default for BTC continuation setups.")
fibMaxExtension = fibMaxExtensionOpt == "1.0" ? 1.0 : fibMaxExtensionOpt == "1.618" ? 1.618 : 1.272
showFibConfluence = input.bool(true, title="Show Active Fibonacci", group=grp_fib)
showFibSignals = input.bool(true, title="Show Fib BUY/SELL Confluence Markers", group=grp_fib)
useFibActionEntry = input.bool(true, title="Allow FIB BUY/SELL Continuation Entry", group=grp_fib, tooltip="When enabled, a Fib-qualified FVG may enter on a strong continuation confirmation without requiring a deep FVG penetration. All session, VWAP, ADX, exhaustion, ORB-extension, risk and prop-firm guards still apply.")
fibActionConfirmBars = input.int(4, title="Fib Action Confirmation Window (Bars)", minval=1, maxval=20, group=grp_fib, tooltip="Maximum bars after the Fib-qualified FVG arms in which a continuation BUY/SELL may trigger.")
fibActionMinScore = input.float(55.0, title="Minimum Score for Fib Action Entry", minval=0.0, maxval=100.0, step=1.0, group=grp_fib)
fibActionBodyAtr = input.float(0.15, title="Minimum Confirmation Body (ATR)", minval=0.0, maxval=2.0, step=0.05, group=grp_fib, tooltip="Requires the continuation confirmation candle body to have meaningful displacement. 0.15 ATR is intentionally moderate for BTC.")
fibActionRequireGolden = input.bool(false, title="Require Golden-Zone Alignment for Fib Action Entry", group=grp_fib, tooltip="Off = directional Fib alignment is enough. On = only FVGs overlapping the Fib continuation/Golden Zone can use the fast actionable entry path.")

// 10. FVG Qualification & Constraints
grp_fvg = "FVG Qualification & Constraints"
atrLength = input.int(14, "ATR Length", minval=1, group=grp_fvg, tooltip="The length used for ATR calculations across the entire strategy (FVG Score, Stop Loss, and Take Profits). 14 is standard, but 30 or 60 may be better for 1-minute charts.")
minFvgScore = input.int(55, "Minimum FVG Strength (0-100)", group=grp_fvg, tooltip="Scores FVGs based on ATR, Volume, and Displacement Ratio. 50 is a good baseline. 75+ is extremely strong.")
fvgVolWeight = input.int(32, "FVG Volume Weight (%)", minval=0, maxval=100, group=grp_fvg, tooltip="Percentage of the FVG Score that comes from volume.")
fvgDispWeight = input.int(24, "FVG Displacement Weight (%)", minval=0, maxval=100, group=grp_fvg, tooltip="Percentage of the FVG Score that comes from displacement (candle body size vs wicks). The remaining percentage automatically goes to ATR.")
fvgWindow = input.int(6, "FVG Search Window (Bars)", group=grp_fvg, tooltip="How many bars after the breakout can the FVG form before the setup is cancelled?")
setupTimeout = input.int(30, "Pending Setup Timeout (Bars)", group=grp_fvg, tooltip="Cancel the pending limit order if price doesn't hit your entry within this many bars of the FVG forming. 0 = Infinite.")
cancelOnFvgCloseInt = input.int(0, "Cancel Setup on FVG Close (0=No, 1=Yes)", minval=0, maxval=1, group=grp_fvg, tooltip="Cancel pending setups if a candle closes completely through the FVG (wrong side).")
cancelOnFvgClose = cancelOnFvgCloseInt == 1
cancelOnOppFvgInt = input.int(1, "Cancel Pending on Opposite FVG (0=No, 1=Yes)", minval=0, maxval=1, group=grp_fvg, tooltip="Cancel pending setups if an opposite FVG forms while waiting for entry.")
cancelOnOppFvg = cancelOnOppFvgInt == 1

// 11. Entry Execution
grp_entry = "Entry Execution"
entryType = input.int(0, title="Entry Execution (0=Rejection, 1=Blind Limit, 2=Rej Limit)", minval=0, maxval=2, group=grp_entry, tooltip="0=Wait for price to reject the FVG to enter. 1=Place limit order blindly inside FVG. 2=Wait for rejection, then place limit at the rejection price.")
fvgPenetrationPct = input.float(35.0, title="FVG Penetration Depth (%)", minval=0.0, maxval=100.0, step=10.0, group=grp_entry, tooltip="0% = Top of FVG (No penetration). 100% = Bottom of FVG (Full penetration). 50% = Midpoint.")
useFvgTouchRefreshInt = input.int(1, title="Require Recent FVG Touch (0=Off, 1=On)", minval=0, maxval=1, group=grp_entry, tooltip="For Rejection and Rej Limit entries: when On, the FVG must be touched on the entry candle or either of the prior two bars. Each new touch refreshes this two-bar window. Off restores the prior latched-touch behavior.")
useFvgTouchRefresh = useFvgTouchRefreshInt == 1
fvgTouchRefreshBars = input.int(2, title="Recent FVG Touch Window (Bars)", minval=0, group=grp_entry, tooltip="Number of bars after the most recent FVG touch that remain eligible for a Rejection or Rej Limit entry. 0 = touch candle only.")

// 12. Position Sizing & Risk
grp_risk = "Position Sizing & Risk"
useDynamicSizingInt = input.int(1, title="Use Dynamic Sizing (0=Off, 1=On)", minval=0, maxval=1, group=grp_risk, tooltip="0 = Use fixed base-coin quantity. 1 = Auto-calculate position size based on Risk Per Trade % and Stop Loss distance.")
useDynamicSizing = useDynamicSizingInt == 1
riskPerTrade = input.float(0.15, title="Risk Per Trade (%)", step=0.05, group=grp_risk, tooltip="Percentage of total equity to risk per trade. Position sizing is calculated dynamically based on the stop loss distance.")
useDynamicRiskScoreInt = input.int(0, title="Scale Risk by FVG Score (0=No, 1=Yes)", minval=0, maxval=1, group=grp_risk, tooltip="If Yes, risk is dynamically scaled based on the FVG strength score.")
useDynamicRiskScore = useDynamicRiskScoreInt == 1
maxBtcQty = input.float(1.0, "Max/Fixed Base Quantity", minval=0.00000001, group=grp_risk, tooltip="For linear perpetual charts with quantity in the base coin. Fixed quantity when dynamic sizing is off; maximum when on. Also capped to available equity at 1x margin.")
btcQtyStep = input.float(0.001, "Base Quantity Step", minval=0.00000001, group=grp_risk, tooltip="Set to your exchange base-coin quantity increment; orders smaller than one step are skipped.")

// 13. Experimental FVG Combo Risk Caps
grp_directional_quality_risk = "Experimental: FVG Combo Risk Caps"
useLongWeakFvgComboRiskCapInt = input.int(1, title="Use Long Weak-FVG Combo Risk Cap (0=Off, 1=On)", minval=0, maxval=1, group=grp_directional_quality_risk, tooltip="Reduces long risk only when all three conditions are true: low FVG RVOL, small FVG gap, and deep maximum penetration.")
longWeakFvgComboMaxRvol = input.float(2.5, title="Long Weak-FVG Combo Maximum RVOL", minval=0, step=0.1, group=grp_directional_quality_risk)
longWeakFvgComboMaxGap = input.float(10.0, title="Long Weak-FVG Combo Maximum Gap", minval=0, step=0.25, group=grp_directional_quality_risk)
longWeakFvgComboMinPenetration = input.float(83.0, title="Long Weak-FVG Combo Minimum Penetration (%)", minval=0, step=1, group=grp_directional_quality_risk)
longWeakFvgComboRiskMultiplier = input.float(0.5, title="Long Weak-FVG Combo Risk Multiplier", minval=0.1, maxval=1.0, step=0.05, group=grp_directional_quality_risk)

useShortWeakFvgComboRiskCapInt = input.int(1, title="Use Short Weak-FVG Combo Risk Cap (0=Off, 1=On)", minval=0, maxval=1, group=grp_directional_quality_risk, tooltip="Reduces short risk only when all three conditions are true: small FVG gap, deep maximum penetration, and a large extension below VWAP.")
shortWeakFvgComboMaxGap = input.float(14.0, title="Short Weak-FVG Combo Maximum Gap", minval=0, step=0.25, group=grp_directional_quality_risk)
shortWeakFvgComboMinPenetration = input.float(85.0, title="Short Weak-FVG Combo Minimum Penetration (%)", minval=0, step=1, group=grp_directional_quality_risk)
shortWeakFvgComboMinVwapExtension = input.float(5.0, title="Short Weak-FVG Combo Minimum VWAP Extension (ATR)", minval=0, step=0.1, group=grp_directional_quality_risk, tooltip="For shorts, the cap triggers only when the FVG formation is this many ATRs or more below VWAP.")
shortWeakFvgComboRiskMultiplier = input.float(0.5, title="Short Weak-FVG Combo Risk Multiplier", minval=0.1, maxval=1.0, step=0.05, group=grp_directional_quality_risk)
stopLossType = input.int(3, title="Stop Loss Type (0=FVG, 1=Breakout Candle, 2=Micro Swing, 3=ATR from Close, 4=Boundary+ATR, 5=Entry+ATR)", minval=0, maxval=5, group=grp_risk, tooltip="0=Below FVG. 1=Below Breakout Candle. 2=Below Micro Swing Low. 3=ATR distance from Breakout Close. 4=Boundary of Range + ATR. 5=Entry Price + ATR.")
atrStopMult = input.float(1.5, title="ATR Stop Loss Multiplier", group=grp_risk, tooltip="Multiplier used to calculate the stop loss distance if Stop Loss Type is set to 3, 4, or 5.")
nyOrbSlMult = input.float(1.0, title="NY ORB ATR Stop Modifier", step=0.1, group=grp_orb_ny, tooltip="Multiplies your base ATR Stop Loss during the NY ORB Valid Session. 1.0 = No change. 1.5 = Stop loss is 50% wider.")

// Dynamic ATR Stop Logic
bool is_ny_orb_window = not na(time(timeframe.period, nyOrbValidSession, "America/New_York"))
bool is_ldn_orb_window = not na(time(timeframe.period, londonOrbValidSession, "America/New_York"))
float effAtrStopMult = is_ny_orb_window ? (atrStopMult * nyOrbSlMult) : (is_ldn_orb_window ? (atrStopMult * ldnOrbSlMult) : atrStopMult)
stopLossBehavior = input.int(1, title="Stop Loss Behavior (0=On Candle Close, 1=Hard Stop on Wick)", minval=0, maxval=1, group=grp_risk, tooltip="0 = Stop Loss only triggers if the 1m candle closes past the stop price. 1 = Instant market exit on wick (Hard Stop).")

// 14. Exits, Partials & Trailing Stop
grp_exits = "Exits, Partials & Trailing Stop"
exitStrategyType = input.string("Original Multi-Target", title="Exit Strategy Type", options=["Original Multi-Target", "Bar-by-Bar Trail"], group=grp_exits, tooltip="Original uses TP1/TP2. Bar-by-Bar goes all-in/all-out and trails the lowest/highest of the last 2 candles once TP1 distance is hit.")
barTrailBufferTicks = input.int(2, title="Bar Trail Buffer (Ticks)", group=grp_exits)
useTrailingStopInt = input.int(1, title="Use Trailing Stop (0=Off, 1=On)", minval=0, maxval=1, group=grp_exits, tooltip="0 = Fixed TP limit. 1 = Disable hard TP and let winners run using a trailing stop.")
useTrailingStop = useTrailingStopInt == 1
riskReward = input.float(1.0, title="Hard Take Profit Target (Multiplier)", group=grp_exits, tooltip="The fixed Take Profit limit. (Ignored if 'Use Trailing Stop' is set to 1)")

partialMode = input.int(2, title="Partial Profits (0=Off, 1=TP1, 2=TP1+TP2)", minval=0, maxval=2, group=grp_exits, tooltip="Configure up to two scaling targets before trailing the runner.")
tp1Target = input.float(2.0, title="TP1 Target (Multiplier)", step=0.1, group=grp_exits, tooltip="Target distance (in ATRs or R-Multiples depending on \'Distance Calculation\') for the first partial exit.")
tp1Pct = input.int(10, title="TP1 Size (%)", minval=1, maxval=99, step=10, group=grp_exits, tooltip="Percentage of the total position size to exit at this target.")
tp2Target = input.float(4.1, title="TP2 Target (Multiplier)", step=0.1, group=grp_exits, tooltip="Target multiplier (R-Mult or ATR) for the second partial exit.")
tp2Pct = input.int(20, title="TP2 Size (%)", minval=1, maxval=99, step=10, group=grp_exits, tooltip="Percentage of the total position size to exit at this target.")

trailActivation = input.float(4.3, title="Trail Activation (Multiplier)", step=0.1, group=grp_exits, tooltip="How many R (or ATRs) in profit before the trail starts following price.")
trailOffsetMult = input.float(0.8, title="Trail Offset (Multiplier)", step=0.1, group=grp_exits, tooltip="How far behind the peak price the trailing stop will follow.")

slToBreakevenInt = input.int(1, title="Move SL to Break-Even (0=Off, 1=At TP1, 2=At TP2, 3=Step BE, 4=Half Risk at TP1, 5=At Trail Act, 6=Half Risk at TP2)", minval=0, maxval=6, group=grp_exits, tooltip="1=BE at TP1 Price. 2=BE at TP2 Price. 3=Step BE. 4=Cut Risk in Half at TP1. 5=BE at Trailing Stop Activation Price. 6=Cut Risk in Half at TP2.")
beActivationMode = input.int(0, title="BE Activation (0=Wick, 1=Candle Close)", minval=0, maxval=1, group=grp_exits, tooltip="0 = Stop Loss moves instantly when the target is wicked. 1 = Stop Loss only moves if the 1m candle closes beyond the target.")
beOffsetTicks = input.int(0, title="Break-Even Offset (Ticks)", group=grp_exits, tooltip="Moves the Break-Even stop loss this many ticks beyond your entry price to cover commissions/slippage. Only applies to Break-Even moves, not initial Stop Loss.")

exitOnOppFvgInt = input.int(2, title="Exit on Opposite FVG (0=Off, 1=Any FVG, 2=Strong Only)", minval=0, maxval=2, group=grp_exits, tooltip="1 = Any opposite FVG kills the trade. 2 = Only kills the trade if the opposite FVG is at least 50% as strong as your entry FVG.")
oppFvgStrengthFactor = input.float(0.7, title="Strong Opposite FVG Strength Factor", step=0.1, group=grp_exits, tooltip="If Exit on Opposite FVG is set to 2, the opposing FVG must have a score >= (entry FVG score * this factor) to kill the trade.")

exitDistanceType = input.int(1, title="Distance Calculation (0=R-Mult, 1=ATR)", minval=0, maxval=1, group=grp_exits, tooltip="0 = Multipliers use Stop Loss distance. 1 = Multipliers use market ATR.")

// 14. UI & Dashboard
grp_ui = "UI & Dashboard"
showPropFirmMetrics = input.bool(true, title="Show Prop Firm Metrics Dashboard", group=grp_ui)
showTradeBoxes = input.bool(true, title="Draw Trade Risk/Reward Boxes", group=grp_ui)
showOrbBox = input.bool(true, title="Show ORB Zone Box", group=grp_ui)
extendOrbBox = input.bool(true, title="Extend ORB Box to Valid Session End", group=grp_ui, tooltip="If true, the ORB box will draw forward until the ORB Valid Session expires (e.g. 12:00 PM), and then stop.")
showSetupIndicators = input.bool(true, title="Show Setup Indicators", group=grp_ui, tooltip="Shows a valid setup and when it becomes invalid")
showStopLine = input.bool(true, title="Show Stop Loss", group=grp_ui, tooltip="Shows the stop loss line that cancels a setup or exits a position")
showEslLine = input.bool(true, title="Show Emergency SL (ESL)", group=grp_ui, tooltip="Shows a red dashed line representing your per-trade hard stop (failsafe) distance.")
showVwapLine = input.bool(true, title="Show VWAP Line", group=grp_ui)
showOfflineDots = input.bool(true, title="Show Online/Offline Dots", group=grp_ui, tooltip="Shows a red or green dot with a tooltip when the bot changes its online/offline status.")

// 15. Debug
grp_debug = "DEBUG"
showOrbBreaks = input.bool(false, title="Show ORB breaks", group=grp_debug, tooltip="Display a 💥 emoji on the candle that breaks the ORB.")
showAllFvgs = input.bool(false, title="Show All FVGs", group=grp_debug, tooltip="Draws a box for every single FVG that forms today, regardless of strength or breakout rules.")
showFvgTooltips = input.bool(false, title="Show FVG Score Tooltips", group=grp_debug, tooltip="Displays a tooltip breaking down the gap's strength when hovering over the FVG box.")
exportDataToComments = input.bool(false, title="Export Data to Comments (For CSV)", group=grp_debug, tooltip="If true, trade comments will be replaced with a JSON string of all internal metrics. Use this to export the List of Trades to CSV for deep analysis.")

// 16. Execution & Webhooks
grp_exec = "Execution & Webhooks"
webhookTickerOverride = input.string("", title="Webhook Market Symbol Override", group=grp_exec, tooltip="Empty uses chart base coin + quote currency (BTCUSDT, ETHUSDT). Set an override when your execution service requires a different perpetual identifier. Verify derivatives support and base-coin quantity units before using alerts.")
webhookTicker = webhookTickerOverride == "" ? syminfo.basecurrency + syminfo.currency : webhookTickerOverride
webhookStopMode = input.int(1, title="Webhook Broker Stop Mode (0=None, 1=ESL Failsafe)", minval=0, maxval=1, group=grp_exec, tooltip="0 = No broker stop. 1 = Places a fixed Emergency Stop Loss (ESL) at entry. On partial exits, the resting stop is cancelled and reapplied 3 seconds later against the remaining position. REQUIREMENT: enable 'Use Per-Trade Hard Stop' and set a positive limit.")
exitPlacementDelay = input.int(500, title="TP/SL Placement Delay (ms)", group=grp_exec, tooltip="Wait this many milliseconds after entering a trade before placing TP/SL orders. Prevents broker rejections on rapid entries/exits.")

// --- Prop Firm Logic Handlers ---
// 1. Session and Date Filters
var int[] noTradeTimestamps = array.new_int()
var int[] newsTargetStarts = array.new_int()
var int[] newsTargetEnds = array.new_int()
var int[] newsTargetPres = array.new_int()
var int[] fomcDecisionTimestamps = array.new_int()

f_init_session_arrays() =>
    if useTimeRestrictions
        if str.length(noTradeDays) > 0
            string[] exclusionArray = str.split(noTradeDays, ",")
            if array.size(exclusionArray) > 0
                for i = 0 to array.size(exclusionArray) - 1
                    string cleanStr = str.replace_all(array.get(exclusionArray, i), " ", "")
                    if str.length(cleanStr) >= 10
                        int y = int(str.tonumber(str.substring(cleanStr, 0, 4)))
                        int m = int(str.tonumber(str.substring(cleanStr, 5, 7)))
                        int d = int(str.tonumber(str.substring(cleanStr, 8, 10)))
                        int ts = timestamp("America/New_York", y, m, d, 0, 0)
                        array.push(noTradeTimestamps, ts)

        if useFomcDecisionWindow
            string[] fomcDecisionDays = str.split(newsDates.getFOMCDecisionDays(), ",")
            if array.size(fomcDecisionDays) > 0
                for i = 0 to array.size(fomcDecisionDays) - 1
                    string cleanStr = str.replace_all(array.get(fomcDecisionDays, i), " ", "")
                    if str.length(cleanStr) >= 10
                        int y = int(str.tonumber(str.substring(cleanStr, 0, 4)))
                        int m = int(str.tonumber(str.substring(cleanStr, 5, 7)))
                        int d = int(str.tonumber(str.substring(cleanStr, 8, 10)))
                        int ts = timestamp("America/New_York", y, m, d, 0, 0)
                        array.push(fomcDecisionTimestamps, ts)
        
        if str.length(newsExclusionWindows) > 0
            string cleanStr = str.replace_all(newsExclusionWindows, ", ", ",")
            string[] windowArray = str.split(cleanStr, ",")
            if array.size(windowArray) > 0
                for i = 0 to array.size(windowArray) - 1
                    string item = array.get(windowArray, i)
                    if str.length(item) < 10
                        continue
                    if str.substring(item, 0, 1) == " "
                        item := str.substring(item, 1, str.length(item))
                    string[] parts = str.split(item, " ")
                    if array.size(parts) >= 2
                        string datePart = array.get(parts, 0)
                        string timePart = array.get(parts, 1)
                        string[] times = str.split(timePart, "-")
                        if array.size(times) == 2
                            string startStr = array.get(times, 0)
                            string endStr = array.get(times, 1)
                            if str.length(startStr) == 4 and str.length(endStr) == 4
                                int y = int(str.tonumber(str.substring(datePart, 0, 4)))
                                int m = int(str.tonumber(str.substring(datePart, 5, 7)))
                                int d = int(str.tonumber(str.substring(datePart, 8, 10)))
                                
                                int startH = int(str.tonumber(str.substring(startStr, 0, 2)))
                                int startM = int(str.tonumber(str.substring(startStr, 2, 4)))
                                int endH = int(str.tonumber(str.substring(endStr, 0, 2)))
                                int endM = int(str.tonumber(str.substring(endStr, 2, 4)))
                                
                                int targetStart = timestamp("America/New_York", y, m, d, startH, startM)
                                int targetEnd = timestamp("America/New_York", y, m, d, endH, endM)
                                
                                if targetStart > targetEnd
                                    int tomorrow_noon = timestamp("America/New_York", y, m, d, 12, 0) + 86400000
                                    int ty = year(tomorrow_noon, "America/New_York")
                                    int tm = month(tomorrow_noon, "America/New_York")
                                    int td = dayofmonth(tomorrow_noon, "America/New_York")
                                    targetEnd := timestamp("America/New_York", ty, tm, td, endH, endM)
                                    
                                int targetPre = targetStart - (15 * 60000)
                                
                                array.push(newsTargetStarts, targetStart)
                                array.push(newsTargetEnds, targetEnd)
                                array.push(newsTargetPres, targetPre)

    // --- Sort Arrays for O(1) Queue ---
    array.sort(noTradeTimestamps)
    
    if array.size(newsTargetStarts) > 0
        int[] sorted_indices = array.sort_indices(newsTargetStarts)
        int[] temp_starts = array.copy(newsTargetStarts)
        int[] temp_ends = array.copy(newsTargetEnds)
        int[] temp_pres = array.copy(newsTargetPres)
        for i = 0 to array.size(sorted_indices) - 1
            int idx = array.get(sorted_indices, i)
            array.set(newsTargetStarts, i, array.get(temp_starts, idx))
            array.set(newsTargetEnds, i, array.get(temp_ends, idx))
            array.set(newsTargetPres, i, array.get(temp_pres, idx))



if barstate.isfirst
    f_init_session_arrays()

int currentDayStart = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 0, 0)
bool isNewsDay = useTimeRestrictions and array.size(noTradeTimestamps) > 0 and array.includes(noTradeTimestamps, currentDayStart)
bool isFomcDecisionDay = useTimeRestrictions and useFomcDecisionWindow and array.includes(fomcDecisionTimestamps, currentDayStart)
int fomcBlockStart = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 12, 0)
int fomcBlockEnd = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 16, 0)
int fomcLiquidationTime = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 13, 45)
bool isFomcDecisionWindow = isFomcDecisionDay and time_close >= fomcBlockStart and time < fomcBlockEnd
bool isFomcLiquidationTime = isFomcDecisionDay and time < fomcBlockEnd and time_close >= fomcLiquidationTime

bool isWindowExcluded = false
bool isNearingWindow = false
if useTimeRestrictions and array.size(newsTargetStarts) > 0
    while array.size(newsTargetStarts) > 0 and time > array.get(newsTargetEnds, 0)
        array.shift(newsTargetStarts)
        array.shift(newsTargetEnds)
        array.shift(newsTargetPres)
        
    int check_len = math.min(array.size(newsTargetStarts), 5)
    if check_len > 0
        for i = 0 to check_len - 1
            int targetEnd = array.get(newsTargetEnds, i)
            int targetPre = array.get(newsTargetPres, i)
            int targetStart = array.get(newsTargetStarts, i)
            
            if time_close > targetStart and time_close <= targetEnd
                isWindowExcluded := true
            if time_close >= targetPre and time_close <= targetStart
                isNearingWindow := true

// 2. Day of Week Filter
int dow = dayofweek(time, "America/New_York")
bool is_allowed_dow = not useTimeRestrictions or (dow == dayofweek.monday and tradeMonday) or (dow == dayofweek.tuesday and tradeTuesday) or (dow == dayofweek.wednesday and tradeWednesday) or (dow == dayofweek.thursday and tradeThursday) or (dow == dayofweek.friday and tradeFriday) or (dow == dayofweek.saturday and tradeSaturday) or (dow == dayofweek.sunday and tradeSunday)


// 4. Consecutive Loss Killswitch
var int current_loss_streak = 0
bool isNewDay = ta.change(time("1D", "0000-0000:1234567", "America/New_York")) != 0


if isNewDay
    current_loss_streak := 0

var float closed_equity_before_trade = na
if strategy.position_size != 0 and (strategy.position_size > 0 ? strategy.position_size[1] <= 0 : strategy.position_size[1] >= 0)
    closed_equity_before_trade := strategy.initial_capital + strategy.netprofit

bool position_closed_or_reversed = (strategy.position_size == 0 and nz(strategy.position_size[1], 0) != 0) or (strategy.position_size > 0 and nz(strategy.position_size[1], 0) < 0) or (strategy.position_size < 0 and nz(strategy.position_size[1], 0) > 0)
if position_closed_or_reversed
    float trade_net = (strategy.initial_capital + strategy.netprofit) - nz(closed_equity_before_trade, strategy.initial_capital + strategy.netprofit)
    if trade_net < 0
        current_loss_streak += 1
    else if trade_net > 0
        current_loss_streak := 0

bool max_losses_hit = maxConsLosses > 0 and current_loss_streak >= maxConsLosses

var string cleanBlockedSessionStr = ""

if barstate.isfirst
    if str.length(blockedIntraDaySessionStr) > 0
        cleanBlockedSessionStr := str.replace_all(blockedIntraDaySessionStr, " ", "") + ":1234567"

f_check_blocked_session() =>
    bool blocked = false
    if useTimeRestrictions
        if useBlockedSession and str.length(cleanBlockedSessionStr) > 0
            if not na(time(timeframe.period, cleanBlockedSessionStr, "America/New_York"))
                blocked := true
                
        // Check Day-Specific Blocks
        if is_allowed_dow and dow == dayofweek.monday and str.length(blockMondayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockMondayTime, " ", "") + ":2", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.tuesday and str.length(blockTuesdayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockTuesdayTime, " ", "") + ":3", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.wednesday and str.length(blockWednesdayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockWednesdayTime, " ", "") + ":4", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.thursday and str.length(blockThursdayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockThursdayTime, " ", "") + ":5", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.friday and str.length(blockFridayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockFridayTime, " ", "") + ":6", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.saturday and str.length(blockSaturdayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockSaturdayTime, " ", "") + ":7", "America/New_York"))
                blocked := true
        else if is_allowed_dow and dow == dayofweek.sunday and str.length(blockSundayTime) > 0
            if not na(time(timeframe.period, str.replace_all(blockSundayTime, " ", "") + ":1", "America/New_York"))
                blocked := true
    blocked

bool isBlockedSession = f_check_blocked_session()
// Adaptive execution support: 1m / 2m / 3m / 5m / 10m / 15m charts are permitted.
// ATR-normalized filters retain price-distance adaptation across these intraday timeframes.
bool isValidTimeframe = timeframe.isminutes and timeframe.multiplier <= 15
bool isValidSwingTimeframe = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(swingTimeframe)
bool inSession = isValidTimeframe and not isNewsDay and not isFomcDecisionWindow and not isWindowExcluded and not isNearingWindow and is_allowed_dow and not max_losses_hit and not isBlockedSession and (not useTimeRestrictions or not na(time(timeframe.period, allowedSession + ":1234567", "America/New_York")))
bool isEod = useTimeRestrictions and useEodLiquidation and not na(time(timeframe.period, eodTimeStr + ":1234567", "America/New_York"))

// Fee assumptions must match Strategy Properties; Pine cannot read those settings.
grp_costs = "Execution Costs & Entry Quality"
useCostFilter = input.bool(true, "Filter Entries by Trading Costs", group=grp_costs, tooltip="Skip entries whose first planned profit distance is too small relative to estimated round-trip fees and slippage. Does not predict profitability.")
estFeePct = input.float(0.06, "Estimated Fee Per Side (%)", minval=0.0, step=0.01, group=grp_costs)
estSlippageTicks = input.int(2, "Estimated Slippage Per Side (Ticks)", minval=0, group=grp_costs)
minTargetCostRatio = input.float(2.0, "Minimum Target / Round-Trip Cost", minval=1.0, step=0.1, group=grp_costs)
includeCostsInRisk = input.bool(true, "Include Estimated Costs in Risk Sizing", group=grp_costs)
useCostBreakeven = input.bool(true, "Include Estimated Costs in Break-Even", group=grp_costs, tooltip="Applies when a break-even mode is enabled. Includes estimated fees and slippage plus the existing tick offset.")

f_roundtrip_cost(float price) =>
    price * (estFeePct / 100.0) * 2.0 + syminfo.mintick * estSlippageTicks * 2.0

// Linear base-coin quantities; inverse contracts are not supported.
f_floor_qty(float q) =>
    math.round(math.floor(math.max(0.0, q) / btcQtyStep + 1e-9) * btcQtyStep, 8)

f_position_qty(float raw, float price) =>
    float requested = useDynamicSizing ? math.min(raw, maxBtcQty) : maxBtcQty
    float affordable = price > 0 and syminfo.pointvalue > 0 ? math.max(0.0, strategy.equity) / (price * syminfo.pointvalue * 1.001) : 0.0
    f_floor_qty(math.min(requested, affordable))

// Use the same gate for each entry path; retain sizing estimates for setup drawings.
f_entry_qty(float raw, float price, float stop, float atr, bool isLong) =>
    float riskDistance = math.abs(price - stop)
    bool validStop = not na(stop) and price > 0 and (isLong ? stop < price : stop > price)
    float costs = f_roundtrip_cost(price)
    float distanceBase = exitDistanceType == 1 ? atr : riskDistance
    float firstTarget = partialMode > 0 or exitStrategyType == "Bar-by-Bar Trail" ? distanceBase * tp1Target : useTrailingStop ? distanceBase * trailActivation : riskDistance * riskReward
    bool costOk = not useCostFilter or (not na(firstTarget) and firstTarget >= costs * minTargetCostRatio)
    float adjustedRaw = includeCostsInRisk and useDynamicSizing and riskDistance > 0 ? raw * riskDistance / (riskDistance + costs) : raw
    validStop and costOk ? f_position_qty(adjustedRaw, price) : 0.0

// Calculate Partial Quantities
f_get_qtys(float qty) =>
    float total = f_floor_qty(qty)
    float reserve = useTrailingStop ? math.min(btcQtyStep, total) : 0.0
    float tp1 = partialMode > 0 ? f_floor_qty(math.min(total * tp1Pct / 100.0, math.max(0.0, total - reserve))) : 0.0
    float tp2 = partialMode == 2 ? f_floor_qty(math.min(total * tp2Pct / 100.0, math.max(0.0, total - tp1 - reserve))) : 0.0
    float runner = f_floor_qty(math.max(0.0, total - tp1 - tp2))
    if partialMode == 0 or exitStrategyType == "Bar-by-Bar Trail"
        tp1 := 0.0
        tp2 := 0.0
        runner := total
    [tp1, tp2, runner]


f_get_webhook_sl(bool is_long, float ep, float sl, float q) =>
    float final_sl = na
    if webhookStopMode == 1 and q > 0 and usePerTradeHardStop and perTradeHardStopLimit > 0
        float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (q * syminfo.pointvalue)
        final_sl := is_long ? ep - failsafe_dist : ep + failsafe_dist
    if not na(final_sl)
        final_sl := math.round_to_mintick(final_sl)
    final_sl



var float trade_q1 = na
var float trade_q2 = na
var float trade_qR = na


var string current_trade_uuid = ""

// ==========================
// TradersPost JSON Builder
var float sl_price = na
var float trade_sl_price = na
// ==========================
f_tp_json(bool is_entry, string debug_str, string uuid, float sl_price_val = na, string sentiment_str = "flat", string order_type = "market", float limit_p = na) =>
    string cancel_block = ""
    string sl_block = ""
    string sentiment_block = ',\n  "sentiment": "' + sentiment_str + '"'
    if not is_entry
        cancel_block := ',\n  "cancel": true,\n  "ignoreTradingWindows": true'
    else if not na(sl_price_val)
        sl_block := ',\n  "stopLoss": { "type": "stop", "stopPrice": ' + str.tostring(sl_price_val) + ' }'
        
    string limit_block = ""
    if order_type == "limit" and not na(limit_p)
        limit_block := ',\n  "limitPrice": ' + str.tostring(limit_p)
        
    string action_str = "{{strategy.order.action}}" // TradingView automatically assigns "buy" or "sell" even for exits
    string core_fields = '{\n  "ticker": "' + webhookTicker + '",\n  "action": "' + action_str + '"' + sentiment_block + ',\n  "orderType": "' + order_type + '",\n  "price": {{close}}' + limit_block + ',\n  "quantity": {{strategy.order.contracts}},\n  "time": "{{timenow}}"' + sl_block + cancel_block + ','
    string extras_fields = '\n  "extras": {\n    "strategy_version": "v75-CostAware",\n    "order_id": "{{strategy.order.id}}",\n    "position_after_trade": "{{strategy.market_position}}",\n    "trade_uuid": "' + uuid + '",\n    "debug": "' + debug_str + '"\n  }\n}'
    core_fields + extras_fields


f_tp_partial_exit_json(string dbg_str, string uuid, float exit_qty, float remaining_qty, float stop_price, string sentiment_str) =>
    string s1 = '{\n  "ticker": "' + webhookTicker + '",\n  "action": "{{strategy.order.action}}",\n  "sentiment": "' + sentiment_str + '",\n  "orderType": "market",\n  "quantity": ' + str.tostring(exit_qty, "#.########") + ',\n  "cancel": true,\n  "cancelOrderType": "stop",\n  "ignoreTradingWindows": true,\n  "extras": { "debug": "' + dbg_str + '" }\n}'
    s1

f_replacement_stop_json(float remaining_qty, float stop_price) =>
    string s2 = '{\n  "ticker": "' + webhookTicker + '",\n  "action": "exit",\n  "orderType": "stop",\n  "stopPrice": ' + str.tostring(stop_price) + ',\n  "quantity": ' + str.tostring(remaining_qty, "#.########") + ',\n  "delay": 3,\n  "cancel": false,\n  "ignoreTradingWindows": true,\n  "extras": { "debug": "Replace Stop" }\n}'
    s2
var float[] active_webhook_sl_arr = array.new_float(1, na)

f_do_partial_exit(string id, string dir, float exit_qty, float remaining_qty, float limit_p, float stop_p, string comment_profit, string comment_loss, string dbg, string uuid, string sentiment) =>
    float active_webhook_sl = array.get(active_webhook_sl_arr, 0)
    string act_sentiment = remaining_qty == 0 ? "flat" : sentiment
    string alert_p = webhookStopMode == 1 ? f_tp_partial_exit_json(dbg, uuid, exit_qty, remaining_qty, active_webhook_sl, act_sentiment) : f_tp_json(false, dbg, uuid, na, act_sentiment)
    string alert_l = f_tp_json(false, dbg + " (Stop)", uuid + "-SL", na, act_sentiment)
    strategy.exit(id, from_entry=dir, qty=exit_qty, limit=limit_p, stop=stop_p, comment_loss=comment_loss, comment_profit=comment_profit, alert_profit=alert_p, alert_loss=alert_l)

f_do_trailing_exit(string id, string dir, float exit_qty, float remaining_qty, float limit_p, float stop_p, float trail_p, float trail_off, string comment_profit, string comment_loss, string dbg, string uuid, string sentiment) =>
    float active_webhook_sl = array.get(active_webhook_sl_arr, 0)
    string act_sentiment = remaining_qty == 0 ? "flat" : sentiment
    string alert_p = webhookStopMode == 1 ? f_tp_partial_exit_json(dbg, uuid, exit_qty, remaining_qty, active_webhook_sl, act_sentiment) : f_tp_json(false, dbg, uuid, na, act_sentiment)
    string alert_l = f_tp_json(false, dbg + " (Stop)", uuid + "-SL", na, act_sentiment)
    string alert_t = f_tp_json(false, dbg + " (Trail)", uuid + "-TR", na, act_sentiment)
    strategy.exit(id, from_entry=dir, qty=exit_qty, limit=limit_p, stop=stop_p, trail_price=trail_p, trail_offset=trail_off, comment_loss=comment_loss, comment_profit=comment_profit, alert_profit=alert_p, alert_loss=alert_l, alert_trailing=alert_t)

// ==========================
// Execution & Webhook Wrappers
// ==========================
f_cancel_all(string dir) =>
    strategy.cancel(dir)

f_close_all(string dir, string cmt, string alert_msg) =>
    strategy.close(dir, comment=cmt, alert_message=alert_msg)

f_execute_entry(string dir, float ep, float sl, float qty, string comment_str, string dbg_str, string uuid, string sentiment_str, string ord_type) =>
    float webhook_sl = f_get_webhook_sl(dir == "Long", ep, sl, qty)
    array.set(active_webhook_sl_arr, 0, webhook_sl)
    bool is_long = dir == "Long"
    if ord_type == "limit"
        strategy.entry(dir, is_long ? strategy.long : strategy.short, qty=qty, limit=ep, comment=comment_str, alert_message=f_tp_json(true, dbg_str, uuid, webhook_sl, sentiment_str, ord_type, ep))
    else
        strategy.entry(dir, is_long ? strategy.long : strategy.short, qty=qty, comment=comment_str, alert_message=f_tp_json(true, dbg_str, uuid, webhook_sl, sentiment_str, ord_type, na))

// ==========================
// Daily Killswitch Logic
// ==========================
var float daily_start_equity = na
if na(daily_start_equity) or isNewDay
    daily_start_equity := strategy.equity

float dailyPnL = strategy.equity - nz(daily_start_equity, strategy.equity)
float actDlsL = dailyLimitType == "Percentage %" ? nz(daily_start_equity, strategy.initial_capital) * (dailyLossLimit / 100) : dailyLossLimit
float actDhsL = dailyLimitType == "Percentage %" ? nz(daily_start_equity, strategy.initial_capital) * (dailyHardStopLimit / 100) : dailyHardStopLimit
float actDplL = dailyLimitType == "Percentage %" ? nz(daily_start_equity, strategy.initial_capital) * (dailyProfitLimit / 100) : dailyProfitLimit

bool hardStopHit = useDailyHardStop and actDhsL > 0 and dailyPnL <= -actDhsL
bool maxProfitHit = useDailyProfitKillswitch and actDplL > 0 and dailyPnL >= actDplL
bool dailyKillswitch = (actDlsL > 0 and dailyPnL <= -actDlsL) or hardStopHit or maxProfitHit

if dailyKillswitch or not inSession
    f_cancel_all("Long")
    f_cancel_all("Short")
    if hardStopHit
        if strategy.position_size > 0
            f_close_all("Long", "Daily Hard Stop Hit", f_tp_json(false, "Daily Hard Stop", current_trade_uuid + "-DHS"))
        if strategy.position_size < 0
            f_close_all("Short", "Daily Hard Stop Hit", f_tp_json(false, "Daily Hard Stop", current_trade_uuid + "-DHS"))
    if maxProfitHit
        if strategy.position_size > 0
            f_close_all("Long", "MaxProfit", f_tp_json(false, "Max Profit", current_trade_uuid + "-MP"))
        if strategy.position_size < 0
            f_close_all("Short", "MaxProfit", f_tp_json(false, "Max Profit", current_trade_uuid + "-MP"))

// ==========================
// HTF Liquidity (Swing Points)
// ==========================

f_swingHigh_locked() => [ta.pivothigh(high, swingLookback, swingLookback)[1], time[swingLookback + 1]]
f_swingLow_locked() => [ta.pivotlow(low, swingLookback, swingLookback)[1], time[swingLookback + 1]]

[htf_ph, ph_time] = request.security(syminfo.tickerid, swingTimeframe, f_swingHigh_locked(), lookahead=barmerge.lookahead_on)
[htf_pl, pl_time] = request.security(syminfo.tickerid, swingTimeframe, f_swingLow_locked(), lookahead=barmerge.lookahead_on)

var float bsl = na
var float ssl = na
var line bsl_line = na
var line ssl_line = na
var int last_drawn_ph_time = na
var int last_drawn_pl_time = na

// ==========================
// Opening Range Breakout (ORB)
// ==========================
// --- NY ORB State ---
var float ny_orb_high = na
var float ny_orb_low = na
var line ny_orb_high_line = na
var line ny_orb_low_line = na
var bool ny_orb_established = false
var int ny_closes_inside_orb = 0
var int london_closes_inside_orb = 0
var box ny_orb_box = box(na)

string ny_orb_session_str = switch nyOrbDuration
    "5" => "0930-0935:1234567"
    "10" => "0930-0940:1234567"
    "15" => "0930-0945:1234567"
    "30" => "0930-1000:1234567"

bool in_ny_orb_window = not na(time(timeframe.period, ny_orb_session_str, "America/New_York"))
var bool was_in_ny_orb = false
var bool nyBullArmed = false
var bool nyBearArmed = false

if in_ny_orb_window and not was_in_ny_orb
    ny_orb_high := high
    ny_orb_low := low
    ny_orb_established := false
    ny_closes_inside_orb := 0
    if not na(ny_orb_high_line)
        line.delete(ny_orb_high_line)
    if not na(ny_orb_low_line)
        line.delete(ny_orb_low_line)
    if showOrbBox and useNyOrb
        ny_orb_box := box.new(bar_index, ny_orb_high, bar_index, ny_orb_low, border_color=color.new(color.gray, 50), border_style=line.style_dashed, bgcolor=color.new(color.gray, 90), text="NY ORB", text_color=color.gray, text_size=size.small)
        
if in_ny_orb_window and useNyOrb
    ny_orb_high := math.max(ny_orb_high, high)
    ny_orb_low := math.min(ny_orb_low, low)
    if showOrbBox
        box.set_top(ny_orb_box, ny_orb_high)
        box.set_bottom(ny_orb_box, ny_orb_low)
        box.set_right(ny_orb_box, bar_index)

if not in_ny_orb_window and was_in_ny_orb
    ny_orb_established := true
    if useNyOrb and isValidTimeframe
        ny_orb_high_line := line.new(x1=time[1], y1=ny_orb_high, x2=time, y2=ny_orb_high, xloc=xloc.bar_time, color=color.blue, style=line.style_dashed, width=1, extend=extend.none)
        nyBullArmed := true
        ny_orb_low_line := line.new(x1=time[1], y1=ny_orb_low, x2=time, y2=ny_orb_low, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1, extend=extend.none)
        nyBearArmed := true

was_in_ny_orb := in_ny_orb_window
bool in_ny_valid_session = not na(time(timeframe.period, nyOrbValidSession, "America/New_York"))

if ny_orb_established and showOrbBox and extendOrbBox and in_ny_valid_session and useNyOrb
    box.set_right(ny_orb_box, bar_index)

if ny_orb_established and in_ny_valid_session and useNyOrb
    if not na(ny_orb_high_line)
        line.set_x2(ny_orb_high_line, time)
    if not na(ny_orb_low_line)
        line.set_x2(ny_orb_low_line, time)

// --- London ORB State ---
var float london_orb_high = na
var float london_orb_low = na
var line london_orb_high_line = na
var line london_orb_low_line = na
var bool ldnBullArmed = false
var bool ldnBearArmed = false
var bool london_orb_established = false
var box london_orb_box = box(na)

string london_orb_session_str = switch londonOrbDuration
    "5" => "0300-0305:1234567"
    "10" => "0300-0310:1234567"
    "15" => "0300-0315:1234567"
    "30" => "0300-0330:1234567"

bool in_london_orb_window = not na(time(timeframe.period, london_orb_session_str, "America/New_York"))
var bool was_in_london_orb = false

if in_london_orb_window and not was_in_london_orb
    london_orb_high := high
    london_orb_low := low
    london_orb_established := false
    london_closes_inside_orb := 0
    if not na(london_orb_high_line)
        line.delete(london_orb_high_line)
    if not na(london_orb_low_line)
        line.delete(london_orb_low_line)
    if showOrbBox and useLondonOrb
        london_orb_box := box.new(bar_index, london_orb_high, bar_index, london_orb_low, border_color=color.new(color.gray, 50), border_style=line.style_dashed, bgcolor=color.new(color.gray, 90), text="LND ORB", text_color=color.gray, text_size=size.small)
        
if in_london_orb_window and useLondonOrb
    london_orb_high := math.max(london_orb_high, high)
    london_orb_low := math.min(london_orb_low, low)
    if showOrbBox
        box.set_top(london_orb_box, london_orb_high)
        box.set_bottom(london_orb_box, london_orb_low)
        box.set_right(london_orb_box, bar_index)

if not in_london_orb_window and was_in_london_orb
    london_orb_established := true
    if useLondonOrb and isValidTimeframe
        london_orb_high_line := line.new(x1=time[1], y1=london_orb_high, x2=time, y2=london_orb_high, xloc=xloc.bar_time, color=color.blue, style=line.style_dashed, width=1, extend=extend.none)
        ldnBullArmed := true
        london_orb_low_line := line.new(x1=time[1], y1=london_orb_low, x2=time, y2=london_orb_low, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1, extend=extend.none)
        ldnBearArmed := true

was_in_london_orb := in_london_orb_window
bool in_london_valid_session = not na(time(timeframe.period, londonOrbValidSession, "America/New_York"))

if london_orb_established and showOrbBox and extendOrbBox and in_london_valid_session and useLondonOrb
    box.set_right(london_orb_box, bar_index)

if london_orb_established and in_london_valid_session and useLondonOrb
    if not na(london_orb_high_line)
        line.set_x2(london_orb_high_line, time)
    if not na(london_orb_low_line)
        line.set_x2(london_orb_low_line, time)


var int bar_of_bull_break_swing = na
var int bar_of_bear_break_swing = na
var int bar_of_bull_break_daily = na
var int bar_of_bear_break_daily = na
var int bar_of_bull_sweep = na
var int bar_of_bear_sweep = na
var int bar_of_first_bull_sweep = na
var int bar_of_first_bear_sweep = na
var float swept_ssl_line = na
var float swept_bsl_line = na
var int ny_bar_of_bull_break_orb = na
var int ny_bar_of_bear_break_orb = na
var int lnd_bar_of_bull_break_orb = na
var int lnd_bar_of_bear_break_orb = na

// ==========================
// ORB Rearm State Management
// ==========================
float ny_orb_midpoint = (ny_orb_high + ny_orb_low) / 2

if rearmOrb and useNyOrb and ny_orb_established
    if close < ny_orb_high and close > ny_orb_low
        ny_closes_inside_orb += 1
    else
        ny_closes_inside_orb := 0
        
    bool reset_bull = false
    bool reset_bear = false
    
    if rearmOrbMode == 1 // Midpoint
        if low <= ny_orb_midpoint
            reset_bull := true
        if high >= ny_orb_midpoint
            reset_bear := true
    else if rearmOrbMode == 2 // Opposite Side
        if low <= ny_orb_low
            reset_bull := true
        if high >= ny_orb_high
            reset_bear := true
    else if rearmOrbMode == 3 // Consecutive Closes
        if ny_closes_inside_orb >= rearmOrbCandles
            reset_bull := true
            reset_bear := true
            
    if not nyBullArmed and reset_bull
        // Removed line re-creation
        nyBullArmed := true
        ny_bar_of_bull_break_orb := na
        
    if not nyBearArmed and reset_bear
        // Removed line re-creation
        nyBearArmed := true
        ny_bar_of_bear_break_orb := na

float london_orb_midpoint = (london_orb_high + london_orb_low) / 2

if rearmOrb and useLondonOrb and london_orb_established
    if close < london_orb_high and close > london_orb_low
        london_closes_inside_orb += 1
    else
        london_closes_inside_orb := 0
        
    bool reset_bull = false
    bool reset_bear = false
    
    if rearmOrbMode == 1 // Midpoint
        if low <= london_orb_midpoint
            reset_bull := true
        if high >= london_orb_midpoint
            reset_bear := true
    else if rearmOrbMode == 2 // Opposite Side
        if low <= london_orb_low
            reset_bull := true
        if high >= london_orb_high
            reset_bear := true
    else if rearmOrbMode == 3 // Consecutive Closes
        if london_closes_inside_orb >= rearmOrbCandles
            reset_bull := true
            reset_bear := true
            
    if not ldnBullArmed and reset_bull
        // Removed line re-creation
        ldnBullArmed := true
        lnd_bar_of_bull_break_orb := na
        
    if not ldnBearArmed and reset_bear
        // Removed line re-creation
        ldnBearArmed := true
        lnd_bar_of_bear_break_orb := na

// ==========================
// Breakout Evaluation
// ==========================
// --- ORB Breakouts ---
bool ny_bull_break = useNyOrb and ny_orb_established and in_ny_valid_session and close > ny_orb_high and close[1] <= ny_orb_high and nyBullArmed
bool ny_bear_break = useNyOrb and ny_orb_established and in_ny_valid_session and close < ny_orb_low and close[1] >= ny_orb_low and nyBearArmed

bool london_bull_break = useLondonOrb and london_orb_established and in_london_valid_session and close > london_orb_high and close[1] <= london_orb_high and ldnBullArmed
bool london_bear_break = useLondonOrb and london_orb_established and in_london_valid_session and close < london_orb_low and close[1] >= london_orb_low and ldnBearArmed

bull_break_orb = ny_bull_break or london_bull_break
bear_break_orb = ny_bear_break or london_bear_break

// Moved to line 842 to evaluate after swing points are updated

var float old_ny_orb_high = na
var float old_ny_orb_low = na
var float old_lnd_orb_high = na
var float old_lnd_orb_low = na

if ny_bull_break
    old_ny_orb_high := ny_orb_high
    if not na(ny_orb_high_line)
        // line.set_style(ny_orb_high_line, line.style_dotted)
        // line.set_extend(ny_orb_high_line, extend.none)
        // line.set_x2(ny_orb_high_line, time)
        if showOrbBreaks
            label.new(x=time, y=na, text="💥", style=label.style_label_down, color=color.new(color.yellow, 50), textcolor=color.black, xloc=xloc.bar_time, yloc=yloc.abovebar, size=size.small)
        // ny_orb_high_line := na
        nyBullArmed := false

if london_bull_break
    old_lnd_orb_high := london_orb_high
    if not na(london_orb_high_line)
        // line.set_style(london_orb_high_line, line.style_dotted)
        // line.set_extend(london_orb_high_line, extend.none)
        // line.set_x2(london_orb_high_line, time)
        if showOrbBreaks
            label.new(x=time, y=na, text="💥", style=label.style_label_down, color=color.new(color.yellow, 50), textcolor=color.black, xloc=xloc.bar_time, yloc=yloc.abovebar, size=size.small)
        // london_orb_high_line := na
        ldnBullArmed := false

if ny_bear_break
    old_ny_orb_low := ny_orb_low
    if not na(ny_orb_low_line)
        // line.set_style(ny_orb_low_line, line.style_dotted)
        // line.set_extend(ny_orb_low_line, extend.none)
        // line.set_x2(ny_orb_low_line, time)
        if showOrbBreaks
            label.new(x=time, y=na, text="💥", style=label.style_label_up, color=color.new(color.yellow, 50), textcolor=color.black, xloc=xloc.bar_time, yloc=yloc.belowbar, size=size.small)
        // ny_orb_low_line := na
        nyBearArmed := false

if london_bear_break
    old_lnd_orb_low := london_orb_low
    if not na(london_orb_low_line)
        // line.set_style(london_orb_low_line, line.style_dotted)
        // line.set_extend(london_orb_low_line, extend.none)
        // line.set_x2(london_orb_low_line, time)
        if showOrbBreaks
            label.new(x=time, y=na, text="💥", style=label.style_label_up, color=color.new(color.yellow, 50), textcolor=color.black, xloc=xloc.bar_time, yloc=yloc.belowbar, size=size.small)
        // london_orb_low_line := na
        ldnBearArmed := false


// ==========================
// Daily High/Low (CDH / CDL)
// ==========================
bool in_daily_session = not na(time(timeframe.period, dailyHlSession, "America/New_York"))
var bool was_in_daily_session = false
bool isNewDailySession = in_daily_session and not was_in_daily_session
was_in_daily_session := in_daily_session

var float current_dh = na
var int bar_of_dh = na
var int time_of_dh = na

bool is_overnight = not na(time(timeframe.period, "1800-0930:1234567", "America/New_York"))
var float current_onh = na
var float current_onl = na
if is_overnight
    if not is_overnight[1]
        current_onh := high
        current_onl := low
    else
        current_onh := math.max(current_onh, high)
        current_onl := math.min(current_onl, low)
var bool dh_established = false
var line cdh_line = na

var float current_dl = na
var int bar_of_dl = na
var int time_of_dl = na
var bool dl_established = false
var line cdl_line = na
var line[] daily_invalidation_lines = array.new_line()

f_keep_daily_invalidation_line(line invalidated_line) =>
    array.push(daily_invalidation_lines, invalidated_line)
    if array.size(daily_invalidation_lines) > 200
        line.delete(array.shift(daily_invalidation_lines))

if isNewDailySession
    current_dh := high
    bar_of_dh := bar_index
    time_of_dh := time
    current_dl := low
    bar_of_dl := bar_index
    time_of_dl := time
    dh_established := false
    dl_established := false
    if not na(cdh_line)
        line.delete(cdh_line)
    if not na(cdl_line)
        line.delete(cdl_line)
    cdh_line := na
    cdl_line := na

// Evaluate Breakouts BEFORE updating extremes
bull_break_daily = useDailyHl and dh_established and close > current_dh and close[1] <= current_dh
bear_break_daily = useDailyHl and dl_established and close < current_dl and close[1] >= current_dl

var float old_cdh = na
var float old_cdl = na

if bull_break_daily
    old_cdh := current_dh
if bear_break_daily
    old_cdl := current_dl

// Update Extremes
if high > current_dh and (not ignorePremarketDailyHL or in_daily_session)
    if dh_established
        if close > current_dh
            if not na(cdh_line)
                line.set_color(cdh_line, color.green)
                line.set_style(cdh_line, line.style_dotted)
                line.set_extend(cdh_line, extend.none)
                line.set_x2(cdh_line, time)
                line.set_width(cdh_line, 1)
            current_dh := high
            bar_of_dh := bar_index
            time_of_dh := time
            dh_established := false
            cdh_line := na
        else if invalidateDailyHlOnWick
            if not na(cdh_line)
                line.set_color(cdh_line, color.gray)
                line.set_style(cdh_line, line.style_dashed)
                line.set_extend(cdh_line, extend.none)
                line.set_x2(cdh_line, time)
                line.set_width(cdh_line, 1)
                f_keep_daily_invalidation_line(cdh_line)
            current_dh := high
            bar_of_dh := bar_index
            time_of_dh := time
            dh_established := false
            cdh_line := na
    else
        current_dh := high
        bar_of_dh := bar_index
        time_of_dh := time
        dh_established := false
        cdh_line := na

if low < current_dl and (not ignorePremarketDailyHL or in_daily_session)
    if dl_established
        if close < current_dl
            if not na(cdl_line)
                line.set_color(cdl_line, color.red)
                line.set_style(cdl_line, line.style_dotted)
                line.set_extend(cdl_line, extend.none)
                line.set_x2(cdl_line, time)
                line.set_width(cdl_line, 1)
            current_dl := low
            bar_of_dl := bar_index
            time_of_dl := time
            dl_established := false
            cdl_line := na
        else if invalidateDailyHlOnWick
            if not na(cdl_line)
                line.set_color(cdl_line, color.gray)
                line.set_style(cdl_line, line.style_dashed)
                line.set_extend(cdl_line, extend.none)
                line.set_x2(cdl_line, time)
                line.set_width(cdl_line, 1)
                f_keep_daily_invalidation_line(cdl_line)
            current_dl := low
            bar_of_dl := bar_index
            time_of_dl := time
            dl_established := false
            cdl_line := na
    else
        current_dl := low
        bar_of_dl := bar_index
        time_of_dl := time
        dl_established := false
        cdl_line := na

if useDailyHl
    if not dh_established and (time - time_of_dh) >= (dailyConfirmMins * 60 * 1000)
        dh_established := true
        cdh_line := line.new(x1=time_of_dh, y1=current_dh, x2=time, y2=current_dh, xloc=xloc.bar_time, color=color.green, style=line.style_dashed, width=1, extend=extend.right)
    if not dl_established and (time - time_of_dl) >= (dailyConfirmMins * 60 * 1000)
        dl_established := true
        cdl_line := line.new(x1=time_of_dl, y1=current_dl, x2=time, y2=current_dl, xloc=xloc.bar_time, color=color.red, style=line.style_dashed, width=1, extend=extend.right)

// Track most recent structural swing highs
if not na(htf_ph) and nz(ph_time) != nz(last_drawn_ph_time)
    bsl := htf_ph
    last_drawn_ph_time := ph_time
    if not na(bsl_line)
        line.delete(bsl_line)
    if isValidSwingTimeframe
        bsl_line := line.new(x1=ph_time, y1=bsl, x2=time, y2=bsl, xloc=xloc.bar_time, color=color.green, style=line.style_solid, width=2, extend=extend.right)

// Track most recent structural swing lows
if not na(htf_pl) and nz(pl_time) != nz(last_drawn_pl_time)
    ssl := htf_pl
    last_drawn_pl_time := pl_time
    if not na(ssl_line)
        line.delete(ssl_line)
    if isValidSwingTimeframe
        ssl_line := line.new(x1=pl_time, y1=ssl, x2=time, y2=ssl, xloc=xloc.bar_time, color=color.red, style=line.style_solid, width=2, extend=extend.right)

// Global Chart Variables
chart_atr = ta.atr(atrLength)

// ==========================
// Fibonacci Confluence Engine
// Uses the most recent rolling impulse extreme. No future pivots/lookahead.
// ==========================
float fibImpulseHigh = ta.highest(high, fibLookback)
float fibImpulseLow = ta.lowest(low, fibLookback)
int fibHighAgo = ta.highestbars(high, fibLookback)
int fibLowAgo = ta.lowestbars(low, fibLookback)
float fibImpulseRange = math.max(fibImpulseHigh - fibImpulseLow, syminfo.mintick)
bool fibBullImpulse = fibHighAgo < fibLowAgo
bool fibBearImpulse = fibLowAgo < fibHighAgo
float fibTol = chart_atr * fibToleranceAtr

float fibBull23 = fibImpulseHigh - fibImpulseRange * 0.236
float fibBull38 = fibImpulseHigh - fibImpulseRange * 0.382
float fibBull50 = fibImpulseHigh - fibImpulseRange * 0.500
float fibBull62 = fibImpulseHigh - fibImpulseRange * 0.618
float fibBull79 = fibImpulseHigh - fibImpulseRange * 0.786
float fibBullExt127 = fibImpulseLow + fibImpulseRange * 1.272
float fibBullExt161 = fibImpulseLow + fibImpulseRange * 1.618

float fibBear23 = fibImpulseLow + fibImpulseRange * 0.236
float fibBear38 = fibImpulseLow + fibImpulseRange * 0.382
float fibBear50 = fibImpulseLow + fibImpulseRange * 0.500
float fibBear62 = fibImpulseLow + fibImpulseRange * 0.618
float fibBear79 = fibImpulseLow + fibImpulseRange * 0.786
float fibBearExt127 = fibImpulseHigh - fibImpulseRange * 1.272
float fibBearExt161 = fibImpulseHigh - fibImpulseRange * 1.618

float fibLongMaxPrice = fibMaxExtension == 1.0 ? fibImpulseHigh : fibMaxExtension == 1.272 ? fibBullExt127 : fibBullExt161
float fibShortMinPrice = fibMaxExtension == 1.0 ? fibImpulseLow : fibMaxExtension == 1.272 ? fibBearExt127 : fibBearExt161

bool fibLongDirectionalOK = fibBullImpulse and close[1] >= fibBull79 - fibTol and close[1] <= fibLongMaxPrice + fibTol
bool fibShortDirectionalOK = fibBearImpulse and close[1] <= fibBear79 + fibTol and close[1] >= fibShortMinPrice - fibTol

// Weighted mode uses Fibonacci as confluence, not as a constantly moving live gate.
// Only severe overextension / deep invalidation is blocked. This prevents a valid
// armed RBO/FVG setup from disappearing simply because the rolling impulse updates.
bool fibLongHardOK = not useFibConfluence or close[1] <= fibLongMaxPrice + fibTol
bool fibShortHardOK = not useFibConfluence or close[1] >= fibShortMinPrice - fibTol

plot(showFibConfluence and fibBullImpulse ? fibImpulseHigh : na, "Fib Bull 0% / High", color=color.new(color.aqua, 15), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBullImpulse ? fibBull38 : na, "Fib Bull 38.2", color=color.new(color.yellow, 35), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBullImpulse ? fibBull50 : na, "Fib Bull 50", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBullImpulse ? fibBull62 : na, "Fib Bull 61.8", color=color.new(color.yellow, 5), linewidth=2, style=plot.style_linebr)
plot(showFibConfluence and fibBearImpulse ? fibImpulseLow : na, "Fib Bear 0% / Low", color=color.new(color.fuchsia, 15), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBearImpulse ? fibBear38 : na, "Fib Bear 38.2", color=color.new(color.yellow, 35), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBearImpulse ? fibBear50 : na, "Fib Bear 50", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
plot(showFibConfluence and fibBearImpulse ? fibBear62 : na, "Fib Bear 61.8", color=color.new(color.yellow, 5), linewidth=2, style=plot.style_linebr)
chart_vol_ma = ta.sma(volume, 20)[1]
chart_b_gap = low - high[2]
chart_br_gap = low[2] - high
chart_c2_s = high[1] - low[1]

// Dynamic Routing Engine (HTF Removed)


// ==========================
// Micro Swing Tracking for Stop Loss
// ==========================
var float recent_micro_pl = na
var float recent_micro_ph = na
float pl_micro = ta.pivotlow(low, 2, 2)
if not na(pl_micro)
    recent_micro_pl := pl_micro
float ph_micro = ta.pivothigh(high, 2, 2)
if not na(ph_micro)
    recent_micro_ph := ph_micro

// ==========================
// Breakout Logic & Line Locking
// ==========================
// --- Swing Point Breakouts ---
bull_break_swing = not na(bsl) and close > bsl and close[1] <= bsl
bear_break_swing = not na(ssl) and close < ssl and close[1] >= ssl

bull_break_trigger_swing = bull_break_swing
bear_break_trigger_swing = bear_break_swing
bull_break_trigger_daily = bull_break_daily
bear_break_trigger_daily = bear_break_daily

bull_sweep = not na(ssl) and low < ssl
bear_sweep = not na(bsl) and high > bsl
bull_sweep_trigger = bull_sweep
bear_sweep_trigger = bear_sweep
bull_break_trigger_orb = bull_break_orb
bear_break_trigger_orb = bear_break_orb

var float broken_bsl_swing = na
var float broken_ssl_swing = na
var float broken_cdh_daily = na
var float broken_cdl_daily = na
var float ny_broken_orb_high = na
var float lnd_broken_orb_high = na
var float ny_broken_orb_low = na
var float lnd_broken_orb_low = na

// Lock in Bullish Breakout
if bull_break_trigger_swing
    broken_bsl_swing := bsl
    if not na(bsl_line)
        line.set_color(bsl_line, color.green)
        line.set_style(bsl_line, line.style_dotted)
        line.set_extend(bsl_line, extend.none) 
        line.set_x2(bsl_line, time) 
        line.set_width(bsl_line, 1) 
        bsl_line := na 
    bsl := na 

if bull_break_trigger_daily
    broken_cdh_daily := old_cdh 

if ny_bull_break
    ny_broken_orb_high := old_ny_orb_high
if london_bull_break
    lnd_broken_orb_high := old_lnd_orb_high

// Lock in Bearish Breakout
if bear_break_trigger_swing
    broken_ssl_swing := ssl
    if not na(ssl_line)
        line.set_color(ssl_line, color.red)
        line.set_style(ssl_line, line.style_dotted)
        line.set_extend(ssl_line, extend.none) 
        line.set_x2(ssl_line, time) 
        line.set_width(ssl_line, 1) 
        ssl_line := na 
    ssl := na 

if bear_break_trigger_daily
    broken_cdl_daily := old_cdl 

if ny_bear_break
    ny_broken_orb_low := old_ny_orb_low
if london_bear_break
    lnd_broken_orb_low := old_lnd_orb_low

// VWAP Filter
bool is_new_ny = hour(time, "America/New_York") == 9 and minute(time, "America/New_York") == 30
bool is_new_london = hour(time, "America/New_York") == 3 and minute(time, "America/New_York") == 0
bool is_auto_anchor = vwapType == "Session Auto-Anchor (03:00 / 09:30)" and (is_new_ny or is_new_london)
bool is_new_rth = vwapType == "RTH (Anchored 09:30 AM)" and is_new_ny

var float sum_src_vol = 0.0
var float sum_vol = 0.0

bool is_rth_vwap = vwapType == "RTH (Anchored 09:30 AM)"
bool is_rth_session = (hour(time, "America/New_York") == 9 and minute(time, "America/New_York") >= 30) or (hour(time, "America/New_York") >= 10 and hour(time, "America/New_York") < 16)
bool should_accumulate = not is_rth_vwap or is_rth_session

if is_new_rth or is_auto_anchor or bar_index == 0
    sum_src_vol := hlc3 * volume
    sum_vol := volume
else if should_accumulate
    sum_src_vol += hlc3 * volume
    sum_vol += volume

float manual_rth_vwap = (is_rth_vwap and not is_rth_session) ? na : (sum_vol > 0 ? sum_src_vol / sum_vol : na)
float vwapValue = vwapType == "Daily (24/7)" ? ta.vwap : manual_rth_vwap
float vwapCurrentM = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
bool isNyOpenIgnore = disableVwapAtOpen and vwapCurrentM >= 570 and vwapCurrentM < (570 + disableVwapMinutes)
bool isLondonOpenIgnore = disableVwapAtLondonOpen and vwapCurrentM >= 180 and vwapCurrentM < (180 + disableVwapMinutes)
bool vwapLongOk = not useVwapFilter or isNyOpenIgnore or isLondonOpenIgnore or close > vwapValue
bool vwapShortOk = not useVwapFilter or isNyOpenIgnore or isLondonOpenIgnore or close < vwapValue

// ==========================
// FVG Strength Scoring Engine (0-100)
// ==========================

float vol_weight = fvgVolWeight
float disp_weight = fvgDispWeight
float atr_weight = math.max(0, 100.0 - vol_weight - disp_weight)

// 1. ATR Score (Dynamic)
bull_atr_ratio = chart_atr > 0 ? chart_b_gap / chart_atr : 0
bear_atr_ratio = chart_atr > 0 ? chart_br_gap / chart_atr : 0
bull_atr_score = math.min(atr_weight, math.max(0, (bull_atr_ratio - 0.2) / 0.8 * atr_weight))
bear_atr_score = math.min(atr_weight, math.max(0, (bear_atr_ratio - 0.2) / 0.8 * atr_weight))

// 2. Volume Score (Dynamic)
vol_ratio = chart_vol_ma > 0 ? volume[1] / chart_vol_ma : 0
vol_score = math.min(vol_weight, math.max(0, (vol_ratio - 1.0) / 1.0 * vol_weight))

// 3. Displacement Ratio Score (Dynamic)
bull_disp_ratio = chart_c2_s > 0 ? chart_b_gap / chart_c2_s : 0
bear_disp_ratio = chart_c2_s > 0 ? chart_br_gap / chart_c2_s : 0
bull_ratio_score = math.min(disp_weight, math.max(0, (bull_disp_ratio - 0.2) / 0.6 * disp_weight))
bear_ratio_score = math.min(disp_weight, math.max(0, (bear_disp_ratio - 0.2) / 0.6 * disp_weight))

// Total Composite Scores
bull_score = bull_atr_score + vol_score + bull_ratio_score
bear_score = bear_atr_score + vol_score + bear_ratio_score

// --- FVG TOOLTIP HELPER ---
f_fvg_tooltip(float _tot, float _atr, float _vol, float _disp, float _crg_mult, float _rvol, float _vwap, float _rej_wck, bool _r_ok, bool _w_ok, bool _a_s, bool _a_d, bool _a_o, bool _in_s, bool _is_f) =>
    string res = "FVG Score Breakdown\nTotal: " + str.tostring(math.round(_tot)) + "\nATR: " + str.tostring(math.round(_atr)) + "\nVolume: " + str.tostring(math.round(_vol)) + "\nDisplacement: " + str.tostring(math.round(_disp))
    res := res + "\nBrk ATR Mult: " + str.tostring(_crg_mult, "#.##") + "x" + "\nRVOL: " + str.tostring(_rvol, "#.##") + "x" + "\nVWAP Dist: " + (math.sign(_vwap) > 0 ? "+" : "") + str.tostring(_vwap, "#.##") + "x ATR" + "\nRej Wick: " + str.tostring(_rej_wck, "#.#") + "%"
    res := res + "\n---\nFilters:\nRange OK: " + (_r_ok ? "Yes" : "No")
    res := res + "\nWick Ratio OK: " + (_w_ok ? "Yes" : "No")
    res := res + "\nMidpoint > Struct: " + ((_a_s or _a_d or _a_o) ? "Yes" : "No")
    res := res + "\nIn Session: " + (_in_s ? "Yes" : "No")
    res := res + "\nFlat/No Pend: " + (_is_f ? "Yes" : "No")
    res
// --------------------------

// ==========================================
// VISUAL MARKERS & DRAWINGS
// ==========================================
f_draw_cancel_marker(bool is_long, string reason) =>
    if showSetupIndicators
        yloc_val = is_long ? yloc.abovebar : yloc.belowbar
        label.new(x=bar_index, y=na, text="❌", style=label.style_none, tooltip=reason, size=size.normal, yloc=yloc_val)

f_draw_armed_marker(bool is_long) =>
    if showSetupIndicators
        yloc_val = is_long ? yloc.belowbar : yloc.abovebar
        label.new(x=bar_index, y=na, text="✔️", style=label.style_none, tooltip="Setup Armed\nWaiting for pullback...", size=size.normal, yloc=yloc_val)

// ==========================================

bull_fvg = chart_b_gap > 0 and bull_score >= minFvgScore
bear_fvg = chart_br_gap > 0 and bear_score >= minFvgScore


// --- DIAGNOSTICS FOR CSV EXPORT ---
float current_rsi = ta.rsi(close, 14)
[_, _, current_adx_val] = ta.dmi(adxLength, adxLength)
float breakout_crange = high[1] - low[1]
float breakout_uwick = high[1] - math.max(open[1], close[1])
float breakout_lwick = math.min(open[1], close[1]) - low[1]
float breakout_maxwick = math.max(breakout_uwick, breakout_lwick)
float breakout_wick_ratio = breakout_crange > 0 ? (breakout_maxwick / breakout_crange) * 100 : 0
// ----------------------------------


// ==========================
// Advanced Entry Filters
// ==========================
float adv_candle_range = high[1] - low[1]
float adv_upper_wick = high[1] - math.max(open[1], close[1])
float adv_lower_wick = math.min(open[1], close[1]) - low[1]
float adv_max_wick = math.max(adv_upper_wick, adv_lower_wick)

bool rangeOk = (not useMaxRangeFilter) or (adv_candle_range <= (chart_atr * maxRangeAtrMult))
bool wickRatioOk = (not useWickRatioFilter) or (adv_candle_range == 0) or ((adv_max_wick / adv_candle_range) * 100 <= maxWickRatioPct)

float breakout_vwap_dist = chart_atr > 0 ? ((close[1] - vwapValue[1]) / chart_atr) : 0
float breakout_rvol = vol_ratio
bool long_min_rvol_ok = not useMinLongRvol or minLongRvol == 0 or breakout_rvol >= minLongRvol
float breakout_bull_rej_wick = adv_candle_range > 0 ? (adv_upper_wick / adv_candle_range) * 100 : 0
float breakout_bear_rej_wick = adv_candle_range > 0 ? (adv_lower_wick / adv_candle_range) * 100 : 0

bull_fvg := bull_fvg and rangeOk and wickRatioOk
bear_fvg := bear_fvg and rangeOk and wickRatioOk

bull_fvg_trigger = bull_fvg
bear_fvg_trigger = bear_fvg

// --- Sweep Specific Filters ---
sweepVwapDistOk = maxSweepVwapDist == 0 or (chart_atr > 0 and math.abs(close[1] - vwapValue[1]) / chart_atr <= maxSweepVwapDist)
sweepRvolOk = minSweepRvol == 0 or breakout_rvol >= minSweepRvol

sweep_bull_fvg = chart_b_gap > 0 and bull_score >= minSweepScoreToEnter and vol_score >= minSweepVolScoreToEnter and rangeOk and wickRatioOk and sweepVwapDistOk and sweepRvolOk
sweep_bear_fvg = tradeShortSweeps and chart_br_gap > 0 and bear_score >= minSweepScoreToEnter and vol_score >= minSweepVolScoreToEnter and rangeOk and wickRatioOk and sweepVwapDistOk and sweepRvolOk
sweep_bull_fvg_trigger = sweep_bull_fvg
sweep_bear_fvg_trigger = sweep_bear_fvg




if bull_break_trigger_swing and inSession
    bar_of_bull_break_swing := bar_index
if bear_break_trigger_swing and inSession
    bar_of_bear_break_swing := bar_index
if bull_break_trigger_daily and inSession
    bar_of_bull_break_daily := bar_index
if bear_break_trigger_daily and inSession
    bar_of_bear_break_daily := bar_index
if bull_sweep_trigger and inSession
    if na(bar_of_first_bull_sweep)
        bar_of_first_bull_sweep := bar_index
    bar_of_bull_sweep := bar_index
    swept_ssl_line := ssl
else if close >= ssl
    bar_of_first_bull_sweep := na

if bear_sweep_trigger and inSession
    if na(bar_of_first_bear_sweep)
        bar_of_first_bear_sweep := bar_index
    bar_of_bear_sweep := bar_index
    swept_bsl_line := bsl
else if close <= bsl
    bar_of_first_bear_sweep := na
if ny_bull_break and inSession
    ny_bar_of_bull_break_orb := bar_index
if ny_bear_break and inSession
    ny_bar_of_bear_break_orb := bar_index
if london_bull_break and inSession
    lnd_bar_of_bull_break_orb := bar_index
if london_bear_break and inSession
    lnd_bar_of_bear_break_orb := bar_index

var string pending_long_uuid = ""
var string pending_short_uuid = ""
var int pending_long_fvg_time = na
var int pending_short_fvg_time = na
var bool pending_long_is_sweep = false
var bool pending_short_is_sweep = false
var bool waiting_bullish_pullback = false
var bool waiting_bearish_pullback = false
var bool waiting_long_rejection_limit = false
var bool waiting_short_rejection_limit = false
var bool bullish_box_touched = false
var bool bearish_box_touched = false
var int bullish_fvg_touch_bar = na
var int bearish_fvg_touch_bar = na
var int bullish_fvg_touch_time = na
var int bearish_fvg_touch_time = na
var int bullish_first_fvg_touch_bar = na
var int bearish_first_fvg_touch_bar = na
var int bullish_fvg_touch_count = 0
var int bearish_fvg_touch_count = 0
var float bullish_max_pen_before_last_touch_price = na
var float bearish_max_pen_before_last_touch_price = na
var int bar_of_bull_fvg = na
var int bar_of_bear_fvg = na

var float pending_long_atr = na
var float pending_long_score = na
var float pending_short_atr = na
var float pending_short_score = na

var float pending_long_atr_score = na

f_get_risk(float score) =>
    float r = riskPerTrade
    if useDynamicRiskScore and not na(score)
        if score >= 80
            r := riskPerTrade * 2.0
        else if score >= 75
            r := riskPerTrade * 1.5
        else if score >= 65
            r := riskPerTrade * 1.0
        else
            r := riskPerTrade * 0.5
    if usePerTradeHardStop and perTradeHardStopLimit > 0
        r := math.min(r, perTradeHardStopLimit)
    r

var float pending_long_vol_score = na
var float pending_long_raw_vol = na
var float pending_long_gap_dom = na
var float pending_long_ratio_score = na
var float pending_long_gap = na
var string pending_long_break_type = na

var float pending_short_atr_score = na
var float pending_short_vol_score = na
var float pending_short_raw_vol = na
var float pending_short_gap_dom = na
var float pending_short_ratio_score = na
var float pending_short_gap = na
var string pending_short_break_type = na

var float pending_long_rsi = na
var float pending_long_adx = na
var float pending_long_crange = na
var float pending_long_vwap_dist = na
var float pending_long_rvol = na
var float pending_long_rej_wck = na
var float pending_long_wick = na
var bool pending_long_news = false
var float pending_long_max_pen_price = na
var float pending_short_max_pen_price = na
var float pending_long_form_open = na
var float pending_long_form_high = na
var float pending_long_form_low = na
var float pending_long_form_close = na
var float pending_long_form_body_pct = na
var float pending_long_form_directional_close = na
var float pending_long_fvg_height_atr = na
var float pending_long_break_level = na
var int pending_long_form_tod = na

var float pending_short_rsi = na
var float pending_short_adx = na
var float pending_short_crange = na
var float pending_short_vwap_dist = na
var float pending_short_rvol = na
var float pending_short_rej_wck = na
var float pending_short_wick = na
var bool pending_short_news = false
var float pending_short_form_open = na
var float pending_short_form_high = na
var float pending_short_form_low = na
var float pending_short_form_close = na
var float pending_short_form_body_pct = na
var float pending_short_form_directional_close = na
var float pending_short_fvg_height_atr = na
var float pending_short_break_level = na
var int pending_short_form_tod = na


var bool pending_long_fib_ok = true
var bool pending_short_fib_ok = true
var float pending_long_fib_high = na
var float pending_long_fib_low = na
var float pending_short_fib_high = na
var float pending_short_fib_low = na
var bool pending_long_fib_directional = false
var bool pending_short_fib_directional = false
var bool pending_long_fib_golden = false
var bool pending_short_fib_golden = false

var float fvg_top = na
var float fvg_bottom = na
var float req_pen_price = na
var float active_fvg_score = na
var line debug_sl_line = na
var label debug_sl_label = na
var line debug_esl_line = na
var label debug_esl_label = na

float bull_midpoint = (low + high[2]) / 2
bool mostly_above_swing = not na(bar_of_bull_break_swing) and not na(broken_bsl_swing) and (bar_index - bar_of_bull_break_swing) <= fvgWindow and bull_midpoint > broken_bsl_swing
bool mostly_above_daily = not na(bar_of_bull_break_daily) and not na(broken_cdh_daily) and (bar_index - bar_of_bull_break_daily) <= fvgWindow and bull_midpoint > broken_cdh_daily
bool ny_mostly_above_orb = not na(ny_bar_of_bull_break_orb) and not na(ny_broken_orb_high) and (bar_index - ny_bar_of_bull_break_orb) <= fvgWindow and bull_midpoint > ny_broken_orb_high
bool lnd_mostly_above_orb = not na(lnd_bar_of_bull_break_orb) and not na(lnd_broken_orb_high) and (bar_index - lnd_bar_of_bull_break_orb) <= fvgWindow and bull_midpoint > lnd_broken_orb_high
bool mostly_above_orb = ny_mostly_above_orb or lnd_mostly_above_orb
bool sweep_duration_bull_ok = maxSweepDuration == 0 or (na(bar_of_first_bull_sweep) ? true : (bar_of_bull_sweep - bar_of_first_bull_sweep) <= maxSweepDuration)
bool mostly_above_sweep = sweep_duration_bull_ok and not na(bar_of_bull_sweep) and (bar_index - bar_of_bull_sweep) <= sweepWindow

bool is_flat_and_no_pending = strategy.position_size == 0 and not waiting_bullish_pullback and not waiting_bearish_pullback and not waiting_long_rejection_limit and not waiting_short_rejection_limit

// Rejected setup audit. Each raw FVG is counted once against the first gate it fails.
var int audit_long_raw = 0
var int audit_short_raw = 0
var int audit_long_score = 0
var int audit_short_score = 0
var int audit_long_range = 0
var int audit_short_range = 0
var int audit_long_wick = 0
var int audit_short_wick = 0
var int audit_long_schedule = 0
var int audit_short_schedule = 0
var int audit_long_daily_lock = 0
var int audit_short_daily_lock = 0
var int audit_long_busy = 0
var int audit_short_busy = 0
var int audit_long_no_level = 0
var int audit_short_no_level = 0
var int audit_long_armed = 0
var int audit_short_armed = 0
var int audit_long_opposing_fvg = 0
var int audit_short_opposing_fvg = 0
var int audit_long_stop_close = 0
var int audit_short_stop_close = 0
var int audit_long_timeout = 0
var int audit_short_timeout = 0
var int audit_long_vwap = 0
var int audit_short_vwap = 0
var int audit_long_adx = 0
var int audit_short_adx = 0
var int audit_long_exhaustion = 0
var int audit_short_exhaustion = 0
var int audit_long_ny_orb_extension = 0
var int audit_long_pb_vol = 0
var int audit_long_min_rvol = 0
var int audit_short_ny_orb_extension = 0

bool long_has_trigger_source = (bull_fvg_trigger and (mostly_above_swing or mostly_above_daily or mostly_above_orb)) or (sweep_bull_fvg_trigger and useSweeps and mostly_above_sweep)
bool fibLongGoldenFvg = fibBullImpulse and bull_midpoint >= fibBull62 - fibTol and bull_midpoint <= fibBull23 + fibTol
float fibLongQualityBonus = not useFibConfluence ? 0.0 : fibLongGoldenFvg ? fibScoreBonus : fibLongDirectionalOK ? fibScoreBonus * 0.50 : 0.0
bool fibLongSetupOK = not useFibConfluence or (fibLongHardOK and (fibMode == "Weighted" or (fibLongDirectionalOK and fibLongGoldenFvg)))
float bull_score_with_fib = math.min(100.0, bull_score + fibLongQualityBonus)
if barstate.isconfirmed and chart_b_gap > 0
    audit_long_raw += 1
    if bull_score < minFvgScore
        audit_long_score += 1
    else if not rangeOk
        audit_long_range += 1
    else if not wickRatioOk
        audit_long_wick += 1
    else if not inSession
        audit_long_schedule += 1
    else if dailyKillswitch
        audit_long_daily_lock += 1
    else if not is_flat_and_no_pending
        audit_long_busy += 1
    else if not long_has_trigger_source
        audit_long_no_level += 1
    else if not long_min_rvol_ok
        audit_long_min_rvol += 1
        f_draw_cancel_marker(true, "Blocked: Long RVOL " + str.tostring(breakout_rvol, "#.##") + " < " + str.tostring(minLongRvol, "#.##"))

f_get_directional_quality_risk_multiplier(bool is_long, float fvg_rvol, float fvg_gap, float max_penetration, float fvg_vwap_dist) =>
    float multiplier = 1.0
    if is_long and useLongWeakFvgComboRiskCapInt == 1 and fvg_rvol < longWeakFvgComboMaxRvol and fvg_gap < longWeakFvgComboMaxGap and max_penetration > longWeakFvgComboMinPenetration
        multiplier := longWeakFvgComboRiskMultiplier
    if not is_long and useShortWeakFvgComboRiskCapInt == 1 and fvg_gap < shortWeakFvgComboMaxGap and max_penetration > shortWeakFvgComboMinPenetration and fvg_vwap_dist <= -shortWeakFvgComboMinVwapExtension
        multiplier := shortWeakFvgComboRiskMultiplier
    multiplier

// Opposing FVG Overrides

if (is_flat_and_no_pending and inSession and not dailyKillswitch and long_min_rvol_ok and fibLongSetupOK and ((bull_fvg_trigger and (mostly_above_swing or mostly_above_daily or mostly_above_orb)) or (sweep_bull_fvg_trigger and useSweeps and mostly_above_sweep)))
    audit_long_armed += 1
    waiting_bullish_pullback := true
    pending_long_max_pen_price := na
    f_draw_armed_marker(true)
    pending_long_uuid := str.tostring(time) + "-" + str.tostring(bar_index)
    pending_long_fvg_time := time[1]
    pending_long_is_sweep := sweep_bull_fvg_trigger and not (bull_fvg_trigger and (mostly_above_swing or mostly_above_daily or mostly_above_orb))
    waiting_bearish_pullback := false
    bullish_box_touched := false
    bearish_box_touched := false
    bullish_fvg_touch_bar := na
    bearish_fvg_touch_bar := na
    bullish_fvg_touch_time := na
    bearish_fvg_touch_time := na
    bullish_first_fvg_touch_bar := na
    bearish_first_fvg_touch_bar := na
    bullish_fvg_touch_count := 0
    bearish_fvg_touch_count := 0
    bullish_max_pen_before_last_touch_price := na
    bearish_max_pen_before_last_touch_price := na
    bar_of_bull_fvg := bar_index
    active_fvg_score := bull_score_with_fib
    pending_long_score := bull_score_with_fib
    pending_long_fib_ok := fibLongSetupOK
    pending_long_fib_high := fibImpulseHigh
    pending_long_fib_low := fibImpulseLow
    pending_long_fib_directional := fibLongDirectionalOK
    pending_long_fib_golden := fibLongGoldenFvg
    pending_long_atr := chart_atr
    pending_long_atr_score := bull_atr_score
    pending_long_vol_score := vol_score
    pending_long_raw_vol := volume[1]
    pending_long_gap_dom := (high[1] - low[1]) > 0 ? chart_b_gap / (high[1] - low[1]) * 100 : 0
    pending_long_ratio_score := bull_ratio_score
    pending_long_gap := chart_b_gap
    pending_long_break_type := mostly_above_swing ? "Swing" : mostly_above_daily ? "Daily" : ny_mostly_above_orb ? "NY_ORB" : lnd_mostly_above_orb ? "L_ORB" : "None"
    pending_long_rsi := current_rsi
    pending_long_adx := current_adx_val
    pending_long_crange := breakout_crange
    pending_long_vwap_dist := breakout_vwap_dist
    pending_long_rvol := breakout_rvol
    pending_long_rej_wck := breakout_bull_rej_wick
    pending_long_wick := breakout_wick_ratio
    pending_long_news := isNewsDay or isWindowExcluded
    pending_long_form_open := open[1]
    pending_long_form_high := high[1]
    pending_long_form_low := low[1]
    pending_long_form_close := close[1]
    float long_form_range = high[1] - low[1]
    pending_long_form_body_pct := long_form_range > 0 ? math.abs(close[1] - open[1]) / long_form_range * 100 : 0
    pending_long_form_directional_close := long_form_range > 0 ? (close[1] - low[1]) / long_form_range * 100 : 0
    pending_long_fvg_height_atr := chart_atr > 0 ? chart_b_gap / chart_atr : na
    pending_long_break_level := mostly_above_swing ? broken_bsl_swing : mostly_above_daily ? broken_cdh_daily : ny_mostly_above_orb ? ny_broken_orb_high : lnd_mostly_above_orb ? lnd_broken_orb_high : na
    pending_long_form_tod := hour(time[1], "America/New_York") * 60 + minute(time[1], "America/New_York")
    fvg_top := low
    fvg_bottom := high[2]
    float pen_pct = fvgPenetrationPct / 100.0
    req_pen_price := fvg_top - ((fvg_top - fvg_bottom) * pen_pct)

    if stopLossType == 0
        sl_price := fvg_bottom
    else if stopLossType == 1
        sl_price := low[1]
    else if stopLossType == 2
        sl_price := not na(recent_micro_pl) ? recent_micro_pl : fvg_bottom
    else if stopLossType == 3
        sl_price := close - (chart_atr  * effAtrStopMult) 
    else if stopLossType == 4
        sl_price := fvg_bottom - (chart_atr  * effAtrStopMult) 
    else if stopLossType == 5
        sl_price := req_pen_price - (chart_atr  * effAtrStopMult)
    
    // History tracking - Do not delete

    if showStopLine
        debug_sl_line := line.new(x1=bar_index, y1=sl_price, x2=bar_index + 15, y2=sl_price, color=color.new(color.fuchsia, 0), style=line.style_dashed, width=2)
        debug_sl_label := label.new(x=bar_index + 15, y=sl_price, text="SL", style=label.style_none, textcolor=color.fuchsia, size=size.normal, yloc=yloc.price)
    if showEslLine and usePerTradeHardStop and perTradeHardStopLimit > 0
        float est_risk = math.abs(req_pen_price - sl_price)
        float projected_pen = math.max(0, fvgPenetrationPct)
        float projected_mult = f_get_directional_quality_risk_multiplier(true, breakout_rvol, chart_b_gap, projected_pen, breakout_vwap_dist)
        float est_riskAmount = strategy.equity * (f_get_risk(active_fvg_score) * projected_mult / 100)
        float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
        float est_qty = f_position_qty(est_qtyRaw, req_pen_price)
        if est_qty > 0
            float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
            float esl_price = req_pen_price - failsafe_dist
            debug_esl_line := line.new(x1=bar_index, y1=esl_price, x2=bar_index + 15, y2=esl_price, color=color.new(color.red, 0), style=line.style_dashed, width=2)
            debug_esl_label := label.new(x=bar_index + 15, y=esl_price, text="ESL", style=label.style_none, textcolor=color.red, size=size.normal, yloc=yloc.price)
    if mostly_above_swing
        bar_of_bull_break_swing := na 
    if mostly_above_daily
        bar_of_bull_break_daily := na
    if mostly_above_orb
        ny_bar_of_bull_break_orb := na
        lnd_bar_of_bull_break_orb := na

float bear_midpoint = (low[2] + high) / 2
bool mostly_below_swing = not na(bar_of_bear_break_swing) and not na(broken_ssl_swing) and (bar_index - bar_of_bear_break_swing) <= fvgWindow and bear_midpoint < broken_ssl_swing
bool mostly_below_daily = not na(bar_of_bear_break_daily) and not na(broken_cdl_daily) and (bar_index - bar_of_bear_break_daily) <= fvgWindow and bear_midpoint < broken_cdl_daily
bool ny_mostly_below_orb = not na(ny_bar_of_bear_break_orb) and not na(ny_broken_orb_low) and (bar_index - ny_bar_of_bear_break_orb) <= fvgWindow and bear_midpoint < ny_broken_orb_low
bool lnd_mostly_below_orb = not na(lnd_bar_of_bear_break_orb) and not na(lnd_broken_orb_low) and (bar_index - lnd_bar_of_bear_break_orb) <= fvgWindow and bear_midpoint < lnd_broken_orb_low
bool mostly_below_orb = ny_mostly_below_orb or lnd_mostly_below_orb
bool sweep_duration_bear_ok = maxSweepDuration == 0 or (na(bar_of_first_bear_sweep) ? true : (bar_of_bear_sweep - bar_of_first_bear_sweep) <= maxSweepDuration)
bool mostly_below_sweep = sweep_duration_bear_ok and not na(bar_of_bear_sweep) and (bar_index - bar_of_bear_sweep) <= sweepWindow

bool short_has_trigger_source = (bear_fvg_trigger and (mostly_below_swing or mostly_below_daily or mostly_below_orb)) or (sweep_bear_fvg_trigger and useSweeps and mostly_below_sweep)
bool fibShortGoldenFvg = fibBearImpulse and bear_midpoint <= fibBear62 + fibTol and bear_midpoint >= fibBear23 - fibTol
float fibShortQualityBonus = not useFibConfluence ? 0.0 : fibShortGoldenFvg ? fibScoreBonus : fibShortDirectionalOK ? fibScoreBonus * 0.50 : 0.0
bool fibShortSetupOK = not useFibConfluence or (fibShortHardOK and (fibMode == "Weighted" or (fibShortDirectionalOK and fibShortGoldenFvg)))
float bear_score_with_fib = math.min(100.0, bear_score + fibShortQualityBonus)

plotshape(showFibSignals and long_has_trigger_source and fibLongSetupOK and is_flat_and_no_pending and inSession, title="Fib BUY Confluence", text="FIB BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 10), textcolor=color.black, size=size.tiny)
plotshape(showFibSignals and short_has_trigger_source and fibShortSetupOK and is_flat_and_no_pending and inSession, title="Fib SELL Confluence", text="FIB SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny)
if barstate.isconfirmed and chart_br_gap > 0
    audit_short_raw += 1
    if bear_score < minFvgScore
        audit_short_score += 1
    else if not rangeOk
        audit_short_range += 1
    else if not wickRatioOk
        audit_short_wick += 1
    else if not inSession
        audit_short_schedule += 1
    else if dailyKillswitch
        audit_short_daily_lock += 1
    else if not is_flat_and_no_pending
        audit_short_busy += 1
    else if not short_has_trigger_source
        audit_short_no_level += 1

// ALL FVGs DRAWING (DEBUG)
// ==========================================
f_draw_debug_fvgs() =>
    if showAllFvgs
        bool is_today = year(time) == year(timenow) and month(time) == month(timenow) and dayofmonth(time) == dayofmonth(timenow)
        if is_today
            if chart_b_gap > 0
                box.new(left=bar_index - 2, top=low, right=bar_index+5, bottom=high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 85), text=str.tostring(math.round(bull_score)), text_color=color.green, text_size=size.normal)
                if showFvgTooltips
                    label.new(x=bar_index + 1, y=math.avg(low, high[2]), text="ℹ️", color=color.new(color.white, 100), style=label.style_label_center, tooltip=f_fvg_tooltip(bull_score, bull_atr_score, vol_score, bull_ratio_score, (chart_atr > 0 ? breakout_crange / chart_atr : 0), breakout_rvol, breakout_vwap_dist, breakout_bull_rej_wick, rangeOk, wickRatioOk, mostly_above_swing, mostly_above_daily, mostly_above_orb, inSession, is_flat_and_no_pending), size=size.small)
            if chart_br_gap > 0
                box.new(left=bar_index - 2, top=low[2], right=bar_index+5, bottom=high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 85), text=str.tostring(math.round(bear_score)), text_color=color.red, text_size=size.normal)
                if showFvgTooltips
                    label.new(x=bar_index + 1, y=math.avg(low[2], high), text="ℹ️", color=color.new(color.white, 100), style=label.style_label_center, tooltip=f_fvg_tooltip(bear_score, bear_atr_score, vol_score, bear_ratio_score, (chart_atr > 0 ? breakout_crange / chart_atr : 0), breakout_rvol, breakout_vwap_dist, breakout_bear_rej_wick, rangeOk, wickRatioOk, mostly_below_swing, mostly_below_daily, mostly_below_orb, inSession, is_flat_and_no_pending), size=size.small)

f_draw_debug_fvgs()
// ==========================================

    
if (is_flat_and_no_pending and inSession and not dailyKillswitch and fibShortSetupOK and ((bear_fvg_trigger and (mostly_below_swing or mostly_below_daily or mostly_below_orb)) or (sweep_bear_fvg_trigger and useSweeps and mostly_below_sweep)))
    audit_short_armed += 1
    waiting_bearish_pullback := true
    pending_short_max_pen_price := na
    f_draw_armed_marker(false)
    pending_short_uuid := str.tostring(time) + "-" + str.tostring(bar_index)
    pending_short_fvg_time := time[1]
    pending_short_is_sweep := sweep_bear_fvg_trigger and not (bear_fvg_trigger and (mostly_below_swing or mostly_below_daily or mostly_below_orb))
    waiting_bullish_pullback := false
    bearish_box_touched := false
    bullish_box_touched := false
    bearish_fvg_touch_bar := na
    bullish_fvg_touch_bar := na
    bearish_fvg_touch_time := na
    bullish_fvg_touch_time := na
    bearish_first_fvg_touch_bar := na
    bullish_first_fvg_touch_bar := na
    bearish_fvg_touch_count := 0
    bullish_fvg_touch_count := 0
    bearish_max_pen_before_last_touch_price := na
    bullish_max_pen_before_last_touch_price := na
    bar_of_bear_fvg := bar_index
    active_fvg_score := bear_score_with_fib
    pending_short_score := bear_score_with_fib
    pending_short_fib_ok := fibShortSetupOK
    pending_short_fib_high := fibImpulseHigh
    pending_short_fib_low := fibImpulseLow
    pending_short_fib_directional := fibShortDirectionalOK
    pending_short_fib_golden := fibShortGoldenFvg
    pending_short_atr := chart_atr
    pending_short_atr_score := bear_atr_score
    pending_short_vol_score := vol_score
    pending_short_raw_vol := volume[1]
    pending_short_gap_dom := (high[1] - low[1]) > 0 ? chart_br_gap / (high[1] - low[1]) * 100 : 0
    pending_short_ratio_score := bear_ratio_score
    pending_short_gap := chart_br_gap
    pending_short_break_type := mostly_below_swing ? "Swing" : mostly_below_daily ? "Daily" : ny_mostly_below_orb ? "NY_ORB" : lnd_mostly_below_orb ? "L_ORB" : "None"
    pending_short_rsi := current_rsi
    pending_short_adx := current_adx_val
    pending_short_crange := breakout_crange
    pending_short_vwap_dist := breakout_vwap_dist
    pending_short_rvol := breakout_rvol
    pending_short_rej_wck := breakout_bear_rej_wick
    pending_short_wick := breakout_wick_ratio
    pending_short_news := isNewsDay or isWindowExcluded
    pending_short_form_open := open[1]
    pending_short_form_high := high[1]
    pending_short_form_low := low[1]
    pending_short_form_close := close[1]
    float short_form_range = high[1] - low[1]
    pending_short_form_body_pct := short_form_range > 0 ? math.abs(close[1] - open[1]) / short_form_range * 100 : 0
    pending_short_form_directional_close := short_form_range > 0 ? (high[1] - close[1]) / short_form_range * 100 : 0
    pending_short_fvg_height_atr := chart_atr > 0 ? chart_br_gap / chart_atr : na
    pending_short_break_level := mostly_below_swing ? broken_ssl_swing : mostly_below_daily ? broken_cdl_daily : ny_mostly_below_orb ? ny_broken_orb_low : lnd_mostly_below_orb ? lnd_broken_orb_low : na
    pending_short_form_tod := hour(time[1], "America/New_York") * 60 + minute(time[1], "America/New_York")
    fvg_top := low[2]
    fvg_bottom := high
    float pen_pct_s = fvgPenetrationPct / 100.0
    req_pen_price := fvg_bottom + ((fvg_top - fvg_bottom) * pen_pct_s)

    if stopLossType == 0
        sl_price := fvg_top
    else if stopLossType == 1
        sl_price := high[1]
    else if stopLossType == 2
        sl_price := not na(recent_micro_ph) ? recent_micro_ph : fvg_top
    else if stopLossType == 3
        sl_price := close + (chart_atr  * effAtrStopMult) 
    else if stopLossType == 4
        sl_price := fvg_top + (chart_atr  * effAtrStopMult) 
    else if stopLossType == 5
        sl_price := req_pen_price + (chart_atr  * effAtrStopMult)

    // History tracking - Do not delete

    if showStopLine
        debug_sl_line := line.new(x1=bar_index, y1=sl_price, x2=bar_index + 15, y2=sl_price, color=color.new(color.fuchsia, 0), style=line.style_dashed, width=2)
        debug_sl_label := label.new(x=bar_index + 15, y=sl_price, text="SL", style=label.style_none, textcolor=color.fuchsia, size=size.normal, yloc=yloc.price)
    if showEslLine and usePerTradeHardStop and perTradeHardStopLimit > 0
        float est_risk = math.abs(sl_price - req_pen_price)
        float projected_pen = math.max(0, fvgPenetrationPct)
        float projected_mult = f_get_directional_quality_risk_multiplier(false, breakout_rvol, chart_b_gap, projected_pen, breakout_vwap_dist)
        float est_riskAmount = strategy.equity * (f_get_risk(active_fvg_score) * projected_mult / 100)
        float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
        float est_qty = f_position_qty(est_qtyRaw, req_pen_price)
        if est_qty > 0
            float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
            float esl_price = req_pen_price + failsafe_dist
            debug_esl_line := line.new(x1=bar_index, y1=esl_price, x2=bar_index + 15, y2=esl_price, color=color.new(color.red, 0), style=line.style_dashed, width=2)
            debug_esl_label := label.new(x=bar_index + 15, y=esl_price, text="ESL", style=label.style_none, textcolor=color.red, size=size.normal, yloc=yloc.price)
    if mostly_below_swing
        bar_of_bear_break_swing := na
    if mostly_below_daily
        bar_of_bear_break_daily := na 
    if mostly_below_orb
        ny_bar_of_bear_break_orb := na
        lnd_bar_of_bear_break_orb := na

if not inSession
    waiting_bullish_pullback := false
    waiting_bearish_pullback := false
    waiting_long_rejection_limit := false
    waiting_short_rejection_limit := false

var box bull_fvg_box = na
var box bear_fvg_box = na

if waiting_bullish_pullback and not waiting_bullish_pullback[1]
    bull_fvg_box := box.new(left=bar_index - 2, top=fvg_top, right=bar_index+15, bottom=fvg_bottom, border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80))
    box.set_text(bull_fvg_box, str.tostring(math.round(bull_score)))
    box.set_text_color(bull_fvg_box, color.new(color.green, 0))
    box.set_text_size(bull_fvg_box, size.normal)
    if showFvgTooltips
        label.new(x=bar_index + 6, y=math.avg(fvg_top, fvg_bottom), text="ℹ️", color=color.new(color.white, 100), style=label.style_label_center, tooltip=f_fvg_tooltip(bull_score, bull_atr_score, vol_score, bull_ratio_score, (chart_atr > 0 ? breakout_crange / chart_atr : 0), breakout_rvol, breakout_vwap_dist, breakout_bull_rej_wick, rangeOk, wickRatioOk, mostly_above_swing, mostly_above_daily, mostly_above_orb, inSession, is_flat_and_no_pending), size=size.small)

if waiting_bearish_pullback and not waiting_bearish_pullback[1]
    bear_fvg_box := box.new(left=bar_index - 2, top=fvg_top, right=bar_index+15, bottom=fvg_bottom, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 80))
    box.set_text(bear_fvg_box, str.tostring(math.round(bear_score)))
    box.set_text_color(bear_fvg_box, color.new(color.red, 0))
    box.set_text_size(bear_fvg_box, size.normal)
    if showFvgTooltips
        label.new(x=bar_index + 6, y=math.avg(fvg_top, fvg_bottom), text="ℹ️", color=color.new(color.white, 100), style=label.style_label_center, tooltip=f_fvg_tooltip(bear_score, bear_atr_score, vol_score, bear_ratio_score, (chart_atr > 0 ? breakout_crange / chart_atr : 0), breakout_rvol, breakout_vwap_dist, breakout_bear_rej_wick, rangeOk, wickRatioOk, mostly_below_swing, mostly_below_daily, mostly_below_orb, inSession, is_flat_and_no_pending), size=size.small)

// Track if the FVG box has been touched recently (Operates strictly on the 1m chart!)
if waiting_bullish_pullback and bar_index > bar_of_bull_fvg and low <= req_pen_price
    bullish_box_touched := true
    if na(bullish_first_fvg_touch_bar)
        bullish_first_fvg_touch_bar := bar_index
    if not na(bullish_fvg_touch_bar)
        bullish_max_pen_before_last_touch_price := pending_long_max_pen_price
    bullish_fvg_touch_bar := bar_index
    bullish_fvg_touch_time := time
    bullish_fvg_touch_count += 1

if waiting_bearish_pullback and bar_index > bar_of_bear_fvg and high >= req_pen_price
    bearish_box_touched := true
    if na(bearish_first_fvg_touch_bar)
        bearish_first_fvg_touch_bar := bar_index
    if not na(bearish_fvg_touch_bar)
        bearish_max_pen_before_last_touch_price := pending_short_max_pen_price
    bearish_fvg_touch_bar := bar_index
    bearish_fvg_touch_time := time
    bearish_fvg_touch_count += 1

// ==========================
if waiting_bullish_pullback or waiting_long_rejection_limit
    pending_long_max_pen_price := na(pending_long_max_pen_price) ? low : math.min(pending_long_max_pen_price, low)

if waiting_bearish_pullback or waiting_short_rejection_limit
    pending_short_max_pen_price := na(pending_short_max_pen_price) ? high : math.max(pending_short_max_pen_price, high)

// Opposing FVG Invalidation Logic
// ==========================
if waiting_bullish_pullback and bear_fvg_trigger and cancelOnOppFvg
    audit_long_opposing_fvg += 1
    waiting_bullish_pullback := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(true, "Cancelled by Opposing Bear FVG")
    f_cancel_all("Long")
    if not na(bull_fvg_box)
        box.set_right(bull_fvg_box, bar_index)
    box.new(left=bar_index - 2, top=low[2], right=bar_index+5, bottom=high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 80), text="Opposing FVG (" + str.tostring(math.round(bear_score)) + ")", text_color=color.white, text_size=size.normal)

if waiting_long_rejection_limit and bear_fvg_trigger and cancelOnOppFvg
    audit_long_opposing_fvg += 1
    waiting_long_rejection_limit := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(true, "Cancelled by Opposing Bear FVG")
    f_cancel_all("Long")
    if not na(bull_fvg_box)
        box.set_right(bull_fvg_box, bar_index)
    box.new(left=bar_index - 2, top=low[2], right=bar_index+5, bottom=high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 80), text="Opposing FVG (" + str.tostring(math.round(bear_score)) + ")", text_color=color.white, text_size=size.normal)

if waiting_bearish_pullback and bull_fvg_trigger and cancelOnOppFvg
    audit_short_opposing_fvg += 1
    waiting_bearish_pullback := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(false, "Cancelled by Opposing Bull FVG")
    f_cancel_all("Short")
    if not na(bear_fvg_box)
        box.set_right(bear_fvg_box, bar_index)
    box.new(left=bar_index - 2, top=low, right=bar_index+5, bottom=high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80), text="Opposing FVG (" + str.tostring(math.round(bull_score)) + ")", text_color=color.white, text_size=size.normal)

if waiting_short_rejection_limit and bull_fvg_trigger and cancelOnOppFvg
    audit_short_opposing_fvg += 1
    waiting_short_rejection_limit := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(false, "Cancelled by Opposing Bull FVG")
    f_cancel_all("Short")
    if not na(bear_fvg_box)
        box.set_right(bear_fvg_box, bar_index)
    box.new(left=bar_index - 2, top=low, right=bar_index+5, bottom=high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80), text="Opposing FVG (" + str.tostring(math.round(bull_score)) + ")", text_color=color.white, text_size=size.normal)

// Stop loss cancellation logic
if waiting_bullish_pullback and (close < sl_price or (cancelOnFvgClose and close < fvg_bottom))
    audit_long_stop_close += 1
    waiting_bullish_pullback := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(true, "Cancelled: Price closed below Stop Loss Guard")
    f_cancel_all("Long")
    if not na(bull_fvg_box)
        box.set_right(bull_fvg_box, bar_index)
if waiting_bearish_pullback and (close > sl_price or (cancelOnFvgClose and close > fvg_top))
    audit_short_stop_close += 1
    waiting_bearish_pullback := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(false, "Cancelled: Price closed above Stop Loss Guard")
    f_cancel_all("Short")
    if not na(bear_fvg_box)
        box.set_right(bear_fvg_box, bar_index)

// Time-based Stale Setup Cancellation
if setupTimeout > 0
    if waiting_bullish_pullback and (bar_index - bar_of_bull_fvg) > setupTimeout
        audit_long_timeout += 1
        waiting_bullish_pullback := false
        if strategy.position_size == 0
            active_fvg_score := na
        f_draw_cancel_marker(true, "Cancelled by Timeout")
        f_cancel_all("Long")
        if not na(bull_fvg_box)
            box.set_right(bull_fvg_box, bar_index)
        
    if waiting_long_rejection_limit and (bar_index - bar_of_bull_fvg) > setupTimeout
        audit_long_timeout += 1
        waiting_long_rejection_limit := false
        if strategy.position_size == 0
            active_fvg_score := na
        f_draw_cancel_marker(true, "Cancelled by Timeout")
        f_cancel_all("Long")
        if not na(bull_fvg_box)
            box.set_right(bull_fvg_box, bar_index)
        
    if waiting_bearish_pullback and (bar_index - bar_of_bear_fvg) > setupTimeout
        audit_short_timeout += 1
        waiting_bearish_pullback := false
        if strategy.position_size == 0
            active_fvg_score := na
        f_draw_cancel_marker(false, "Cancelled by Timeout")
        f_cancel_all("Short")
        if not na(bear_fvg_box)
            box.set_right(bear_fvg_box, bar_index)

    if waiting_short_rejection_limit and (bar_index - bar_of_bear_fvg) > setupTimeout
        audit_short_timeout += 1
        waiting_short_rejection_limit := false
        if strategy.position_size == 0
            active_fvg_score := na
        f_draw_cancel_marker(false, "Cancelled by Timeout")
        f_cancel_all("Short")
        if not na(bear_fvg_box)
            box.set_right(bear_fvg_box, bar_index)

if waiting_long_rejection_limit and (close < sl_price or (cancelOnFvgClose and close < fvg_bottom))
    audit_long_stop_close += 1
    waiting_long_rejection_limit := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(true, "Cancelled: Price closed below Stop Loss Guard")
    f_cancel_all("Long")
    if not na(bull_fvg_box)
        box.set_right(bull_fvg_box, bar_index)
if waiting_short_rejection_limit and (close > sl_price or (cancelOnFvgClose and close > fvg_top))
    audit_short_stop_close += 1
    waiting_short_rejection_limit := false
    if strategy.position_size == 0
        active_fvg_score := na
    f_draw_cancel_marker(false, "Cancelled: Price closed above Stop Loss Guard")
    f_cancel_all("Short")
    if not na(bear_fvg_box)
        box.set_right(bear_fvg_box, bar_index)

// ==========================
// Rejection Candle Entry Logic
// ==========================
is_green = close > open
is_red = close < open
total_range = high - low
lower_wick = math.min(open, close) - low
upper_wick = high - math.max(open, close)
is_rejection_long = is_green or (total_range > 0 and lower_wick >= 0.5 * total_range)
is_rejection_short = is_red or (total_range > 0 and upper_wick >= 0.5 * total_range)

// HTF Bias Filter
// ==========================
// ADX Calculation
// ==========================
[diplus, diminus, current_adx] = ta.dmi(adxLength, adxLength)
bool adxOk = (useAdxFilterInt == 0) or (current_adx >= adxThreshold)


// Calculate dynamic risk

float active_fvg_height = not na(fvg_top) and not na(fvg_bottom) ? math.abs(fvg_top - fvg_bottom) : na
float long_max_penetration = not na(active_fvg_height) and active_fvg_height > 0 and not na(pending_long_max_pen_price) ? (fvg_top - pending_long_max_pen_price) / active_fvg_height * 100 : 0
float short_max_penetration = not na(active_fvg_height) and active_fvg_height > 0 and not na(pending_short_max_pen_price) ? (pending_short_max_pen_price - fvg_bottom) / active_fvg_height * 100 : 0
float long_quality_risk_multiplier = f_get_directional_quality_risk_multiplier(true, nz(pending_long_rvol), nz(pending_long_gap), long_max_penetration, nz(pending_long_vwap_dist))
float short_quality_risk_multiplier = f_get_directional_quality_risk_multiplier(false, nz(pending_short_rvol), nz(pending_short_gap), short_max_penetration, nz(pending_short_vwap_dist))
float actualLongRisk = f_get_risk(active_fvg_score) * long_quality_risk_multiplier
float actualShortRisk = f_get_risk(active_fvg_score) * short_quality_risk_multiplier


// ==========================
// Debug Event Table
// ==========================
// --- CSV DATA EXPORT HELPER ---

// ==========================================
// PREDICTIVE MACRO FEATURES (FOR DEBUG CSV)
// ==========================================
float chart_ema20 = ta.ema(close, 20)
float chart_sma50 = ta.sma(close, 50)
float chart_sma200 = ta.sma(close, 200)

[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)

var int consecutive_green = 0
var int consecutive_red = 0
consecutive_green := close > open ? consecutive_green + 1 : 0
consecutive_red := close < open ? consecutive_red + 1 : 0

float atr_slope_5 = chart_atr - chart_atr[5]
// ==========================================

f_entry_debug_suffix(bool is_long, float ep, float sl, float qty) =>
    if not exportDataToComments
        is_long ? "Long" : "Short"
    else
        int touch_bar = is_long ? bullish_fvg_touch_bar : bearish_fvg_touch_bar
        int touch_time = is_long ? bullish_fvg_touch_time : bearish_fvg_touch_time
        int touch_age = not na(touch_bar) ? bar_index - touch_bar : na
        int first_touch_bar = is_long ? bullish_first_fvg_touch_bar : bearish_first_fvg_touch_bar
        int first_touch_age = not na(first_touch_bar) ? bar_index - first_touch_bar : na
        int touch_count = is_long ? bullish_fvg_touch_count : bearish_fvg_touch_count
        float max_pen_before_last_touch_price = is_long ? bullish_max_pen_before_last_touch_price : bearish_max_pen_before_last_touch_price
        float fvg_height = math.abs(fvg_top - fvg_bottom)
        float max_pen_before_last_touch = fvg_height > 0 and not na(max_pen_before_last_touch_price) ? (is_long ? (fvg_top - max_pen_before_last_touch_price) : (max_pen_before_last_touch_price - fvg_bottom)) / fvg_height * 100 : na
        float esl_price = f_get_webhook_sl(is_long, ep, sl, qty)
        float sl_dist = math.abs(ep - sl)
        float esl_dist = not na(esl_price) ? math.abs(ep - esl_price) : na
        float esl_vs_sl = sl_dist > 0 and not na(esl_dist) ? esl_dist / sl_dist : na
        float score_risk_pct = f_get_risk(active_fvg_score)
        float quality_risk_mult = is_long ? long_quality_risk_multiplier : short_quality_risk_multiplier
        float effective_risk_pct = score_risk_pct * quality_risk_mult
        float risk_budget = strategy.equity * (effective_risk_pct / 100)
        float per_btc_risk = sl_dist * syminfo.pointvalue
        float raw_qty = per_btc_risk > 0 ? f_floor_qty(risk_budget / per_btc_risk) : na
        "\",\"e_sl_price\":\"" + str.tostring(sl, "#.##") + "\",\"e_esl_price\":\"" + str.tostring(esl_price, "#.##") + "\",\"e_esl_vs_sl\":\"" + str.tostring(esl_vs_sl, "#.####") + "\",\"e_touch_age\":\"" + str.tostring(touch_age) + "\",\"e_first_touch_age\":\"" + str.tostring(first_touch_age) + "\",\"e_touch_count\":\"" + str.tostring(touch_count) + "\",\"e_max_pen_before_last_touch\":\"" + str.tostring(max_pen_before_last_touch, "#.##") + "\",\"e_touch_time\":\"" + str.tostring(touch_time) + "\",\"e_req_pen_price\":\"" + str.tostring(req_pen_price, "#.##") + "\",\"e_score_risk_pct\":\"" + str.tostring(score_risk_pct, "#.####") + "\",\"e_quality_risk_mult\":\"" + str.tostring(quality_risk_mult, "#.####") + "\",\"e_effective_risk_pct\":\"" + str.tostring(effective_risk_pct, "#.####") + "\",\"e_risk_budget\":\"" + str.tostring(risk_budget, "#.##") + "\",\"e_raw_qty\":\"" + str.tostring(raw_qty)

f_build_data_string(bool is_long, string base_comment, float _ep, float _sl) =>
    if not exportDataToComments
        base_comment
    else
        float score = is_long ? pending_long_score : pending_short_score
        float atr_s = is_long ? pending_long_atr_score : pending_short_atr_score
        float vol_s = is_long ? pending_long_vol_score : pending_short_vol_score
        float ratio_s = is_long ? pending_long_ratio_score : pending_short_ratio_score
        float gap = is_long ? pending_long_gap : pending_short_gap
        string b_type = is_long ? pending_long_break_type : pending_short_break_type
        
        float sl_dist = math.abs(_ep - _sl)
        float orb_sz = b_type == "NY_ORB" ? math.abs(ny_orb_high - ny_orb_low) : b_type == "L_ORB" ? math.abs(london_orb_high - london_orb_low) : b_type == "Swing" ? math.abs(recent_micro_ph - recent_micro_pl) : 0
        
        string dir_str = (is_long ? "L" : "S") + base_comment
        
        float pending_raw_vol = is_long ? pending_long_raw_vol : pending_short_raw_vol
        float pb_v_rat = pending_raw_vol > 0 ? volume / pending_raw_vol : 0
        float pending_gap_dom = is_long ? pending_long_gap_dom : pending_short_gap_dom
        float dist_onh_atr = not na(current_onh) and chart_atr > 0 ? (current_onh - close) / chart_atr : na
        float dist_onl_atr = not na(current_onl) and chart_atr > 0 ? (close - current_onl) / chart_atr : na

        float rsi_s = is_long ? pending_long_rsi : pending_short_rsi
        float adx_s = is_long ? pending_long_adx : pending_short_adx
        float crg_s = is_long ? pending_long_crange : pending_short_crange
        float vwap_s = is_long ? pending_long_vwap_dist : pending_short_vwap_dist
        float rvol_s = is_long ? pending_long_rvol : pending_short_rvol
        int fvg_time_s = is_long ? pending_long_fvg_time : pending_short_fvg_time
        float rej_wck_s = is_long ? pending_long_rej_wck : pending_short_rej_wck
        float wick_s = is_long ? pending_long_wick : pending_short_wick
        bool news_s = is_long ? pending_long_news : pending_short_news
        string news_str = news_s ? "Yes" : "No"
        bool swp_s = is_long ? pending_long_is_sweep : pending_short_is_sweep
        string swp_str = (swp_s ? "Yes" : "No") + "\",\"rej_l_raw\":" + str.tostring(audit_long_raw) + ",\"rej_s_raw\":" + str.tostring(audit_short_raw) + ",\"rej_l_score\":" + str.tostring(audit_long_score) + ",\"rej_s_score\":" + str.tostring(audit_short_score) + ",\"rej_l_range\":" + str.tostring(audit_long_range) + ",\"rej_s_range\":" + str.tostring(audit_short_range) + ",\"rej_l_wick\":" + str.tostring(audit_long_wick) + ",\"rej_s_wick\":" + str.tostring(audit_short_wick) + ",\"rej_l_sched\":" + str.tostring(audit_long_schedule) + ",\"rej_s_sched\":" + str.tostring(audit_short_schedule) + ",\"rej_l_daily\":" + str.tostring(audit_long_daily_lock) + ",\"rej_s_daily\":" + str.tostring(audit_short_daily_lock) + ",\"rej_l_busy\":" + str.tostring(audit_long_busy) + ",\"rej_s_busy\":" + str.tostring(audit_short_busy) + ",\"rej_l_level\":" + str.tostring(audit_long_no_level) + ",\"rej_s_level\":" + str.tostring(audit_short_no_level) + ",\"rej_l_armed\":" + str.tostring(audit_long_armed) + ",\"rej_s_armed\":" + str.tostring(audit_short_armed) + ",\"rej_l_opp\":" + str.tostring(audit_long_opposing_fvg) + ",\"rej_s_opp\":" + str.tostring(audit_short_opposing_fvg) + ",\"rej_l_stop\":" + str.tostring(audit_long_stop_close) + ",\"rej_s_stop\":" + str.tostring(audit_short_stop_close) + ",\"rej_l_timeout\":" + str.tostring(audit_long_timeout) + ",\"rej_s_timeout\":" + str.tostring(audit_short_timeout) + ",\"rej_l_vwap\":" + str.tostring(audit_long_vwap) + ",\"rej_s_vwap\":" + str.tostring(audit_short_vwap) + ",\"rej_l_adx\":" + str.tostring(audit_long_adx) + ",\"rej_s_adx\":" + str.tostring(audit_short_adx) + ",\"rej_l_exhaust\":" + str.tostring(audit_long_exhaustion) + ",\"rej_s_exhaust\":" + str.tostring(audit_short_exhaustion) + ",\"rej_l_nyorb\":" + str.tostring(audit_long_ny_orb_extension) + ",\"rej_s_nyorb\":" + str.tostring(audit_short_ny_orb_extension) + ",\"rej_l_pbv\":" + str.tostring(audit_long_pb_vol) + ",\"rej_l_min_rvol\":" + str.tostring(audit_long_min_rvol) + ",\"rej_snapshot\":\"true"
        float form_open = is_long ? pending_long_form_open : pending_short_form_open
        float form_high = is_long ? pending_long_form_high : pending_short_form_high
        float form_low = is_long ? pending_long_form_low : pending_short_form_low
        float form_close = is_long ? pending_long_form_close : pending_short_form_close
        float break_level = is_long ? pending_long_break_level : pending_short_break_level
        int form_tod = is_long ? pending_long_form_tod : pending_short_form_tod
        float form_range = form_high - form_low
        float form_body_pct = form_range > 0 ? math.abs(form_close - form_open) / form_range * 100 : 0
        float form_close_location = form_range > 0 ? (form_close - form_low) / form_range * 100 : 0
        float form_directional_close_location = is_long ? form_close_location : 100 - form_close_location
        float form_upper_wick = form_range > 0 ? (form_high - math.max(form_open, form_close)) / form_range * 100 : 0
        float form_lower_wick = form_range > 0 ? (math.min(form_open, form_close) - form_low) / form_range * 100 : 0
        float break_distance_atr = not na(break_level) and atr_s > 0 ? (is_long ? form_close - break_level : break_level - form_close) / atr_s : na
        float fvg_height = math.abs(fvg_top - fvg_bottom)
        float fvg_midpoint = math.avg(fvg_top, fvg_bottom)
        float fvg_height_atr = atr_s > 0 ? fvg_height / atr_s : 0
        float fvg_mid_to_break_atr = not na(break_level) and atr_s > 0 ? (is_long ? fvg_midpoint - break_level : break_level - fvg_midpoint) / atr_s : na
        int fvg_bar = is_long ? bar_of_bull_fvg : bar_of_bear_fvg
        int entry_delay_bars = not na(fvg_bar) ? bar_index - fvg_bar : na
        float entry_range = high - low
        float entry_body_pct = entry_range > 0 ? math.abs(close - open) / entry_range * 100 : 0
        float entry_close_location = entry_range > 0 ? (close - low) / entry_range * 100 : 0
        float entry_directional_close_location = is_long ? entry_close_location : 100 - entry_close_location
        float entry_upper_wick = entry_range > 0 ? (high - math.max(open, close)) / entry_range * 100 : 0
        float entry_lower_wick = entry_range > 0 ? (math.min(open, close) - low) / entry_range * 100 : 0
        float entry_penetration = fvg_height > 0 ? (is_long ? (fvg_top - low) : (high - fvg_bottom)) / fvg_height * 100 : 0
        float max_penetration_price = is_long ? nz(pending_long_max_pen_price, low) : nz(pending_short_max_pen_price, high)
        float max_penetration = fvg_height > 0 ? (is_long ? (fvg_top - max_penetration_price) : (max_penetration_price - fvg_bottom)) / fvg_height * 100 : 0
        float entry_rvol = chart_vol_ma > 0 ? volume / chart_vol_ma : 0
        float entry_vwap_atr = chart_atr > 0 ? (close - vwapValue) / chart_atr : 0
        float entry_adx_slope = current_adx - current_adx[1]
        float orb_atr = atr_s > 0 ? orb_sz / atr_s : na
        float daily_range = not na(current_dh) and not na(current_dl) ? current_dh - current_dl : na
        float daily_range_atr = not na(daily_range) and chart_atr > 0 ? daily_range / chart_atr : na
        float entry_day_position = not na(daily_range) and daily_range > 0 ? (close - current_dl) / daily_range * 100 : na
        float distance_daily_high_atr = not na(current_dh) and chart_atr > 0 ? (current_dh - close) / chart_atr : na
        float distance_daily_low_atr = not na(current_dl) and chart_atr > 0 ? (close - current_dl) / chart_atr : na
        float return_5_bars_atr = chart_atr > 0 ? (close - close[5]) / chart_atr : na
        float return_15_bars_atr = chart_atr > 0 ? (close - close[15]) / chart_atr : na
        float vwap_slope_5_bars_atr = chart_atr > 0 ? (vwapValue - vwapValue[5]) / chart_atr : na
        string entry_session = is_ny_orb_window ? "NY_ORB" : is_ldn_orb_window ? "LONDON_ORB" : in_ny_valid_session ? "NY" : in_london_valid_session ? "LONDON" : "OTHER"
        string entry_mode = entryType == 0 ? "Rejection" : entryType == 1 ? "BlindLimit" : "RejectionLimit"
        bool entry_vwap_ok = is_long ? vwapLongOk : vwapShortOk
        

        float crg_mult = atr_s > 0 ? (crg_s / atr_s) : 0
        bool entry_exhaustion = useExhaustionGuard and not na(time(timeframe.period, exhaustionSessionStr, "America/New_York")) and math.abs(vwap_s) >= exhaustionVwapAtr and rvol_s >= exhaustionRvol
        "{\"dir\":\"" + dir_str + "\",\"fvg_time\":" + str.tostring(fvg_time_s) + ",\"tot\":" + str.tostring(score, "#.##") + ",\"atr\":" + str.tostring(atr_s, "#.##") + ",\"vol\":" + str.tostring(vol_s, "#.##") + ",\"disp\":" + str.tostring(ratio_s, "#.##") + ",\"gap\":" + str.tostring(gap, "#.##") + ",\"sl\":" + str.tostring(sl_dist, "#.##") + ",\"orb\":" + str.tostring(orb_sz, "#.##") + ",\"brk\":\"" + str.tostring(b_type) + "\",\"rsi\":" + str.tostring(rsi_s, "#.##") + ",\"adx\":" + str.tostring(adx_s, "#.##") + ",\"crg_mult\":" + str.tostring(crg_mult, "#.##") + ",\"rvol\":" + str.tostring(rvol_s, "#.##") + ",\"vwap\":" + str.tostring(vwap_s, "#.##") + ",\"rej_wck\":" + str.tostring(rej_wck_s, "#.##") + ",\"wck\":" + str.tostring(wick_s, "#.##") + ",\"news\":\"" + news_str + "\",\"sweep\":\"" + swp_str + "\",\"fo\":" + str.tostring(form_open, "#.##") + ",\"fh\":" + str.tostring(form_high, "#.##") + ",\"fl\":" + str.tostring(form_low, "#.##") + ",\"fc\":" + str.tostring(form_close, "#.##") + ",\"fbody\":" + str.tostring(form_body_pct, "#.##") + ",\"fclv\":" + str.tostring(form_close_location, "#.##") + ",\"fdir_clv\":" + str.tostring(form_directional_close_location, "#.##") + ",\"fuw\":" + str.tostring(form_upper_wick, "#.##") + ",\"flw\":" + str.tostring(form_lower_wick, "#.##") + ",\"brk_lvl\":" + str.tostring(nz(break_level), "#.##") + ",\"brk_known\":" + str.tostring(not na(break_level)) + ",\"brk_atr\":" + str.tostring(nz(break_distance_atr), "#.##") + ",\"fvg_h_atr\":" + str.tostring(fvg_height_atr, "#.##") + ",\"mid_brk_atr\":" + str.tostring(nz(fvg_mid_to_break_atr), "#.##") + ",\"f_tod\":" + str.tostring(form_tod) + ",\"e_mode\":\"" + entry_mode + "\",\"e_delay\":" + str.tostring(nz(entry_delay_bars)) + ",\"e_pen\":" + str.tostring(entry_penetration, "#.##") + ",\"max_pen\":" + str.tostring(max_penetration, "#.##") + ",\"eo\":" + str.tostring(open, "#.##") + ",\"eh\":" + str.tostring(high, "#.##") + ",\"el\":" + str.tostring(low, "#.##") + ",\"ec\":" + str.tostring(close, "#.##") + ",\"ebody\":" + str.tostring(entry_body_pct, "#.##") + ",\"eclv\":" + str.tostring(entry_close_location, "#.##") + ",\"edir_clv\":" + str.tostring(entry_directional_close_location, "#.##") + ",\"euw\":" + str.tostring(entry_upper_wick, "#.##") + ",\"elw\":" + str.tostring(entry_lower_wick, "#.##") + ",\"ervol\":" + str.tostring(entry_rvol, "#.##") + ",\"evwap\":" + str.tostring(entry_vwap_atr, "#.##") + ",\"eadx\":" + str.tostring(current_adx, "#.##") + ",\"eadx_d\":" + str.tostring(entry_adx_slope, "#.##") + ",\"e_tod\":" + str.tostring(hour(time, "America/New_York") * 60 + minute(time, "America/New_York")) + ",\"session\":\"" + entry_session + "\",\"orb_atr\":" + str.tostring(nz(orb_atr), "#.##") + ",\"day_rng_atr\":" + str.tostring(nz(daily_range_atr), "#.##") + ",\"day_pos\":" + str.tostring(nz(entry_day_position), "#.##") + ",\"dist_dh_atr\":" + str.tostring(nz(distance_daily_high_atr), "#.##") + ",\"dist_dl_atr\":" + str.tostring(nz(distance_daily_low_atr), "#.##") + ",\"ret5b_atr\":" + str.tostring(nz(return_5_bars_atr), "#.##") + ",\"ret15b_atr\":" + str.tostring(nz(return_15_bars_atr), "#.##") + ",\"vwap_slp5_atr\":" + str.tostring(nz(vwap_slope_5_bars_atr), "#.##") + ",\"vwap_ok\":" + str.tostring(entry_vwap_ok) + ",\"adx_ok\":" + str.tostring(adxOk) + ",\"exhaustion\":" + str.tostring(entry_exhaustion) + ",\"pb_v_rat\":" + str.tostring(pb_v_rat, "#.##") + ",\"gap_dom\":" + str.tostring(pending_gap_dom, "#.##") + ",\"onh_atr\":" + str.tostring(nz(dist_onh_atr), "#.##") + ",\"onl_atr\":" + str.tostring(nz(dist_onl_atr), "#.##") + ",\"ema20_atr\":" + str.tostring(chart_atr > 0 ? (close - chart_ema20) / chart_atr : na, "#.##") + ",\"sma50_atr\":" + str.tostring(chart_atr > 0 ? (close - chart_sma50) / chart_atr : na, "#.##") + ",\"sma200_atr\":" + str.tostring(chart_atr > 0 ? (close - chart_sma200) / chart_atr : na, "#.##") + ",\"pdh_atr\":" + str.tostring(chart_atr > 0 ? (pdh - close) / chart_atr : na, "#.##") + ",\"pdl_atr\":" + str.tostring(chart_atr > 0 ? (close - pdl) / chart_atr : na, "#.##") + ",\"pdc_atr\":" + str.tostring(chart_atr > 0 ? (close - pdc) / chart_atr : na, "#.##") + ",\"atr_slp\":" + str.tostring(nz(atr_slope_5), "#.##") + ",\"cons_grn\":" + str.tostring(nz(consecutive_green)) + ",\"cons_red\":" + str.tostring(nz(consecutive_red)) + "}"
// ------------------------------

// --- OPPOSING FVG BYPASS LOGIC ---
// -----------------------------------







// --- SMART EXHAUSTION GUARD ---
bool in_exhaustion_window = not na(time(timeframe.period, exhaustionSessionStr, "America/New_York"))

bool long_exhaustion_triggered = useExhaustionGuard and in_exhaustion_window and math.abs(pending_long_vwap_dist) >= exhaustionVwapAtr and pending_long_rvol >= exhaustionRvol
bool short_exhaustion_triggered = useExhaustionGuard and in_exhaustion_window and math.abs(pending_short_vwap_dist) >= exhaustionVwapAtr and pending_short_rvol >= exhaustionRvol

float current_pb_v_rat_long = pending_long_raw_vol > 0 ? volume / pending_long_raw_vol : 0
bool long_pb_vol_blocked = useLongPbVolFilter and current_pb_v_rat_long > maxLongPbVolRatio

float current_dist_onh_atr = not na(current_onh) and chart_atr > 0 ? (current_onh - close) / chart_atr : na
bool long_onh_trap_blocked = useLongOnhTrapFilter and not na(current_dist_onh_atr) and current_dist_onh_atr >= longOnhTrapMinAtr and current_dist_onh_atr <= longOnhTrapMaxAtr


float pending_long_break_atr = not na(pending_long_break_level) and pending_long_atr_score > 0 ? (pending_long_form_close - pending_long_break_level) / pending_long_atr_score : na
float pending_short_break_atr = not na(pending_short_break_level) and pending_short_atr_score > 0 ? (pending_short_break_level - pending_short_form_close) / pending_short_atr_score : na
// --- EXHAUSTION SCALING VARIABLES ---
bool long_ny_orb_overextended = useNyOrbOverextensionGuard and pending_long_break_type == "NY_ORB" and not na(pending_long_break_atr) and pending_long_break_atr >= nyOrbMaxBreakAtr
bool short_ny_orb_overextended = useNyOrbOverextensionGuard and pending_short_break_type == "NY_ORB" and not na(pending_short_break_atr) and pending_short_break_atr >= nyOrbMaxBreakAtr

var float trade_entry_qty = na
var float bbb_trail_sl_long = na
var float bbb_trail_sl_short = na
var bool bbb_trail_active = false




// Limit Order Logic
if entryType == 1 and waiting_bullish_pullback and inSession and strategy.position_size <= 0 and not dailyKillswitch and vwapLongOk and adxOk and not long_exhaustion_triggered and not long_ny_orb_overextended and not long_pb_vol_blocked and not long_onh_trap_blocked and pending_long_fib_ok
    if stopLossType == 5
        sl_price := req_pen_price - (pending_long_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(req_pen_price - sl_price)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_long_score) * long_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, req_pen_price)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = req_pen_price - failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(req_pen_price - sl_price)
    float riskAmount = strategy.equity * (f_get_risk(pending_long_score) * long_quality_risk_multiplier / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, req_pen_price, sl_price, chart_atr, true)
        trade_entry_qty := qty
        string dbg = "Limit Entry Long @ " + str.tostring(req_pen_price) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_long_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_long_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_long_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_long_uuid
            f_execute_entry("Long", req_pen_price, sl_price, qty, f_build_data_string(true, f_entry_debug_suffix(true, req_pen_price, sl_price, qty), req_pen_price, sl_price), dbg, current_trade_uuid, "bullish", "limit")
        else
            f_cancel_all("Long")

if entryType == 1 and waiting_bearish_pullback and inSession and strategy.position_size >= 0 and not dailyKillswitch and vwapShortOk and adxOk and not short_exhaustion_triggered and not short_ny_orb_overextended and pending_short_fib_ok
    if stopLossType == 5
        sl_price := req_pen_price + (pending_short_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(sl_price - req_pen_price)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_short_score) * short_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, req_pen_price)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = req_pen_price + failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(sl_price - req_pen_price)
    float riskAmount = strategy.equity * (f_get_risk(pending_short_score) * short_quality_risk_multiplier / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, req_pen_price, sl_price, chart_atr, false)
        trade_entry_qty := qty
        string dbg = "Limit Entry Short @ " + str.tostring(req_pen_price) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_short_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_short_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_short_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_short_uuid
            f_execute_entry("Short", req_pen_price, sl_price, qty, f_build_data_string(false, f_entry_debug_suffix(false, req_pen_price, sl_price, qty), req_pen_price, sl_price), dbg, current_trade_uuid, "bearish", "limit")
        else
            f_cancel_all("Short")

// A touch normally remains latched. When enabled, only a touch from this bar or the configured number of prior bars is eligible.
bool long_fvg_touch_ok = bullish_box_touched and (not useFvgTouchRefresh or (not na(bullish_fvg_touch_bar) and bar_index - bullish_fvg_touch_bar <= fvgTouchRefreshBars))
bool short_fvg_touch_ok = bearish_box_touched and (not useFvgTouchRefresh or (not na(bearish_fvg_touch_bar) and bar_index - bearish_fvg_touch_bar <= fvgTouchRefreshBars))

// Must not hit daily killswitch to enter
// v7.4: FIB BUY / FIB SELL is now actionable. A Fib-qualified setup can use a
// continuation confirmation path when momentum leaves the FVG without giving the
// strategy its normal deep penetration. This does NOT bypass the core safety filters.
float fibActionBody = math.abs(close - open)
bool fibActionLongQuality = pending_long_fib_directional and (not fibActionRequireGolden or pending_long_fib_golden)
bool fibActionShortQuality = pending_short_fib_directional and (not fibActionRequireGolden or pending_short_fib_golden)
bool fibLongContinuationConfirm = useFibActionEntry and waiting_bullish_pullback and bar_index > bar_of_bull_fvg and bar_index - bar_of_bull_fvg <= fibActionConfirmBars and fibActionLongQuality and pending_long_fib_ok and nz(pending_long_score, 0) >= fibActionMinScore and close > open and close > high[1] and close > req_pen_price and fibActionBody >= chart_atr * fibActionBodyAtr
bool fibShortContinuationConfirm = useFibActionEntry and waiting_bearish_pullback and bar_index > bar_of_bear_fvg and bar_index - bar_of_bear_fvg <= fibActionConfirmBars and fibActionShortQuality and pending_short_fib_ok and nz(pending_short_score, 0) >= fibActionMinScore and close < open and close < low[1] and close < req_pen_price and fibActionBody >= chart_atr * fibActionBodyAtr

long_cond = entryType == 0 and waiting_bullish_pullback and long_fvg_touch_ok and (close >= sl_price) and is_rejection_long and inSession and strategy.position_size <= 0 and not dailyKillswitch and vwapLongOk and adxOk and not long_exhaustion_triggered and not long_ny_orb_overextended and not long_pb_vol_blocked and not long_onh_trap_blocked and pending_long_fib_ok
short_cond = entryType == 0 and waiting_bearish_pullback and short_fvg_touch_ok and (close <= sl_price) and is_rejection_short and inSession and strategy.position_size >= 0 and not dailyKillswitch and vwapShortOk and adxOk and not short_exhaustion_triggered and not short_ny_orb_overextended and pending_short_fib_ok

bool fib_direct_long_cond = fibLongContinuationConfirm and inSession and strategy.position_size <= 0 and not dailyKillswitch and vwapLongOk and adxOk and not long_exhaustion_triggered and not long_ny_orb_overextended and not long_pb_vol_blocked and not long_onh_trap_blocked
bool fib_direct_short_cond = fibShortContinuationConfirm and inSession and strategy.position_size >= 0 and not dailyKillswitch and vwapShortOk and adxOk and not short_exhaustion_triggered and not short_ny_orb_overextended

plotshape(showFibSignals and fib_direct_long_cond, title="Actionable FIB BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
plotshape(showFibSignals and fib_direct_short_cond, title="Actionable FIB SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

bool long_rej_limit_cond = entryType == 2 and waiting_bullish_pullback and long_fvg_touch_ok and (close >= sl_price) and is_rejection_long and inSession and strategy.position_size <= 0 and not dailyKillswitch and vwapLongOk and adxOk and not long_exhaustion_triggered and not long_ny_orb_overextended and not long_pb_vol_blocked and not long_onh_trap_blocked and pending_long_fib_ok
bool short_rej_limit_cond = entryType == 2 and waiting_bearish_pullback and short_fvg_touch_ok and (close <= sl_price) and is_rejection_short and inSession and strategy.position_size >= 0 and not dailyKillswitch and vwapShortOk and adxOk and not short_exhaustion_triggered and not short_ny_orb_overextended and pending_short_fib_ok

if long_rej_limit_cond
    waiting_long_rejection_limit := true
    waiting_bullish_pullback := false
if short_rej_limit_cond
    waiting_short_rejection_limit := true
    waiting_bearish_pullback := false
    
if waiting_long_rejection_limit and inSession and strategy.position_size <= 0 and not dailyKillswitch and pending_long_fib_ok
    float ep = math.min(req_pen_price + syminfo.mintick, close)
    if stopLossType == 5
        sl_price := ep - (pending_long_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(ep - sl_price)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_long_score) * long_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, ep)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = ep - failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(ep - sl_price)
    float riskAmount = strategy.equity * (f_get_risk(pending_long_score) * long_quality_risk_multiplier / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, ep, sl_price, chart_atr, true)
        trade_entry_qty := qty
        string dbg = "Rejection Limit Long @ " + str.tostring(ep) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_long_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_long_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_long_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_long_uuid
            f_execute_entry("Long", ep, sl_price, qty, f_build_data_string(true, f_entry_debug_suffix(true, ep, sl_price, qty), ep, sl_price), dbg, current_trade_uuid, "bullish", "limit")
        else
            f_cancel_all("Long")

if waiting_short_rejection_limit and inSession and strategy.position_size >= 0 and not dailyKillswitch and pending_short_fib_ok
    float ep = math.max(req_pen_price - syminfo.mintick, close)
    if stopLossType == 5
        sl_price := ep + (pending_short_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(sl_price - ep)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_short_score) * short_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, ep)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = ep + failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(sl_price - ep)
    float riskAmount = strategy.equity * (f_get_risk(pending_short_score) * short_quality_risk_multiplier / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, ep, sl_price, chart_atr, false)
        trade_entry_qty := qty
        string dbg = "Rejection Limit Short @ " + str.tostring(ep) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_short_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_short_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_short_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_short_uuid
            f_execute_entry("Short", ep, sl_price, qty, f_build_data_string(false, f_entry_debug_suffix(false, ep, sl_price, qty), ep, sl_price), dbg, current_trade_uuid, "bearish", "limit")
        else
            f_cancel_all("Short")

// Fibonacci is snapshotted when the setup arms. Do not cancel a valid pending setup
// merely because the rolling Fib impulse changes later. Strict/weighted qualification
// has already been applied at setup creation and pending_*_fib_ok is preserved through entry.

// Limit Order Filter Guard
if (waiting_bullish_pullback or waiting_long_rejection_limit) and not (vwapLongOk and adxOk and not long_exhaustion_triggered and not long_ny_orb_overextended)
    if long_ny_orb_overextended
        audit_long_ny_orb_extension += 1
    else if long_exhaustion_triggered
        audit_long_exhaustion += 1
    else if not vwapLongOk
        audit_long_vwap += 1
    else
        audit_long_adx += 1
    string cancel_reason_long = long_ny_orb_overextended ? "Cancelled by NY ORB Extension (>=" + str.tostring(nyOrbMaxBreakAtr) + " ATR)" : long_exhaustion_triggered ? "Cancelled by Exhaustion Guard" : not vwapLongOk ? "Cancelled by VWAP Guard" : "Cancelled by ADX Guard [" + str.tostring(math.round(current_adx, 1)) + "]"
    f_draw_cancel_marker(true, cancel_reason_long)
    f_cancel_all("Long")
    if not na(bull_fvg_box)
        box.set_right(bull_fvg_box, bar_index)
    waiting_bullish_pullback := false
    waiting_long_rejection_limit := false
    active_fvg_score := na
    pending_long_score := na
    pending_long_atr := na

if (waiting_bearish_pullback or waiting_short_rejection_limit) and not (vwapShortOk and adxOk and not short_exhaustion_triggered and not short_ny_orb_overextended)
    if short_ny_orb_overextended
        audit_short_ny_orb_extension += 1
    else if short_exhaustion_triggered
        audit_short_exhaustion += 1
    else if not vwapShortOk
        audit_short_vwap += 1
    else
        audit_short_adx += 1
    string cancel_reason_short = short_ny_orb_overextended ? "Cancelled by NY ORB Extension (>=" + str.tostring(nyOrbMaxBreakAtr) + " ATR)" : short_exhaustion_triggered ? "Cancelled by Exhaustion Guard" : not vwapShortOk ? "Cancelled by VWAP Guard" : "Cancelled by ADX Guard [" + str.tostring(math.round(current_adx, 1)) + "]"
    f_draw_cancel_marker(false, cancel_reason_short)
    f_cancel_all("Short")
    if not na(bear_fvg_box)
        box.set_right(bear_fvg_box, bar_index)
    waiting_bearish_pullback := false
    waiting_short_rejection_limit := false
    active_fvg_score := na
    pending_short_score := na
    pending_short_atr := na

var float tp_price = na
var float trail_act_price = na
var float trail_offset_ticks = na
var float partial_tp1_price = na
var float partial_tp2_price = na
var bool partial_tp1_hit = false
var bool trail_act_hit = false
var bool partial_tp2_hit = false



var box risk_box = na
var box reward_box = na
var line tp1_line = na
var line tp2_line = na
var line trail_act_line = na
var label tp1_label = na
var label tp2_label = na
var label trail_act_label = na
var line current_bbb_line = na



// Limit Order Fill Detection
var float trade_entry_equity = na
var float trade_fvg_score = na

var int current_trade_dir = 0
if strategy.position_size == 0
    trade_entry_equity := na
    bbb_trail_sl_long := na
    bbb_trail_sl_short := na
    bbb_trail_active := false
    current_bbb_line := na
    trade_fvg_score := na
    trade_entry_qty := na
    trade_q1 := na
    trade_q2 := na
    trade_qR := na
    trade_sl_price := na
    current_trade_dir := 0
else if strategy.position_size > 0 and current_trade_dir != 1
    trade_sl_price := na
    current_trade_dir := 1
else if strategy.position_size < 0 and current_trade_dir != -1
    trade_sl_price := na
    current_trade_dir := -1

if math.abs(strategy.position_size) > nz(trade_entry_qty, 0)
    trade_entry_qty := math.abs(strategy.position_size)

bool just_entered_long = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool just_entered_short = strategy.position_size < 0 and strategy.position_size[1] >= 0

var float trade_netprofit_before_entry = na
if just_entered_long or just_entered_short
    trade_netprofit_before_entry := strategy.netprofit
else if strategy.position_size == 0
    trade_netprofit_before_entry := na

if just_entered_long
    trade_entry_equity := closed_equity_before_trade
    trade_fvg_score := nz(pending_long_score, active_fvg_score)
    float execution_price = strategy.opentrades.entry_price(0)
    if na(trade_sl_price)
        trade_sl_price := sl_price
    float risk = math.abs(execution_price - trade_sl_price)
    
    // Dynamic Exit Adjustments
                

    tp_price := execution_price + (risk * riskReward)
    if usePerTradeProfitKillswitch and perTradeProfitLimit > 0
        float max_dollar_profit = dailyLimitType == "Percentage %" ? nz(trade_entry_equity, strategy.equity) * (perTradeProfitLimit / 100) : perTradeProfitLimit
        float points_profit = (max_dollar_profit / math.abs(strategy.position_size)) / syminfo.pointvalue
        float emergency_tp = execution_price + points_profit
        tp_price := math.min(tp_price, emergency_tp)
    float exit_dist_L1 = exitDistanceType == 1 ? chart_atr : risk
    trail_act_price := execution_price + (exit_dist_L1 * trailActivation)
    partial_tp1_price := execution_price + (exit_dist_L1 * tp1Target)
    partial_tp2_price := execution_price + (exit_dist_L1 * tp2Target)
    trail_offset_ticks := math.max(1, math.round((exit_dist_L1 * trailOffsetMult) / syminfo.mintick))
    partial_tp1_hit := false
    partial_tp2_hit := false
    trail_act_hit := false
    waiting_bullish_pullback := false
    waiting_long_rejection_limit := false
    if showTradeBoxes
        risk_box := box.new(left=bar_index, top=execution_price, right=bar_index + 1, bottom=sl_price, border_color=color.new(color.red, 100), bgcolor=color.new(color.red, 85))
        float visual_tp = tp_price
        if exitStrategyType == "Bar-by-Bar Trail"
            visual_tp := partial_tp1_price
            reward_box := box.new(left=bar_index, top=visual_tp, right=bar_index + 1, bottom=execution_price, border_color=color.new(color.green, 100), bgcolor=color.new(color.green, 85))
            trail_act_line := line.new(x1=bar_index, y1=partial_tp1_price, x2=bar_index + 1, y2=partial_tp1_price, color=color.new(color.orange, 0), style=line.style_dashed, width=1)
            trail_act_label := label.new(x=bar_index + 1, y=partial_tp1_price, text="Trail Act", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.orange, 0), size=size.small)
        else
            if useTrailingStop
                visual_tp := trail_act_price
            if partialMode >= 1
                visual_tp := math.max(visual_tp, partial_tp1_price)
            if partialMode == 2
                visual_tp := math.max(visual_tp, partial_tp2_price)
            reward_box := box.new(left=bar_index, top=visual_tp, right=bar_index + 1, bottom=execution_price, border_color=color.new(color.green, 100), bgcolor=color.new(color.green, 85))
            if partialMode >= 1
                tp1_line := line.new(x1=bar_index, y1=partial_tp1_price, x2=bar_index + 1, y2=partial_tp1_price, color=color.new(color.white, 20), style=line.style_dashed, width=1)
                tp1_label := label.new(x=bar_index + 1, y=partial_tp1_price, text="TP1", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.white, 20), size=size.small)
            if partialMode == 2
                tp2_line := line.new(x1=bar_index, y1=partial_tp2_price, x2=bar_index + 1, y2=partial_tp2_price, color=color.new(color.white, 20), style=line.style_dashed, width=1)
                tp2_label := label.new(x=bar_index + 1, y=partial_tp2_price, text="TP2", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.white, 20), size=size.small)
            if useTrailingStop
                trail_act_line := line.new(x1=bar_index, y1=trail_act_price, x2=bar_index + 1, y2=trail_act_price, color=color.new(color.orange, 0), style=line.style_solid, width=1)
                trail_act_label := label.new(x=bar_index + 1, y=trail_act_price, text="Trail Act", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.orange, 0), size=size.small)

if just_entered_short
    trade_entry_equity := closed_equity_before_trade
    trade_fvg_score := nz(pending_short_score, active_fvg_score)
    float execution_price = strategy.opentrades.entry_price(0)
    if na(trade_sl_price)
        trade_sl_price := sl_price
    float risk = math.abs(trade_sl_price - execution_price)
    
    // Dynamic Exit Adjustments
                

    tp_price := execution_price - (risk * riskReward)
    if usePerTradeProfitKillswitch and perTradeProfitLimit > 0
        float max_dollar_profit = dailyLimitType == "Percentage %" ? nz(trade_entry_equity, strategy.equity) * (perTradeProfitLimit / 100) : perTradeProfitLimit
        float points_profit = (max_dollar_profit / math.abs(strategy.position_size)) / syminfo.pointvalue
        float emergency_tp = execution_price - points_profit
        tp_price := math.max(tp_price, emergency_tp)
    float exit_dist_S1 = exitDistanceType == 1 ? chart_atr : risk
    trail_act_price := execution_price - (exit_dist_S1 * trailActivation)
    partial_tp1_price := execution_price - (exit_dist_S1 * tp1Target)
    partial_tp2_price := execution_price - (exit_dist_S1 * tp2Target)
    trail_offset_ticks := math.max(1, math.round((exit_dist_S1 * trailOffsetMult) / syminfo.mintick))
    partial_tp1_hit := false
    partial_tp2_hit := false
    trail_act_hit := false
    waiting_bearish_pullback := false
    waiting_short_rejection_limit := false
    if showTradeBoxes
        risk_box := box.new(left=bar_index, top=sl_price, right=bar_index + 1, bottom=execution_price, border_color=color.new(color.red, 100), bgcolor=color.new(color.red, 85))
        float visual_tp = tp_price
        if exitStrategyType == "Bar-by-Bar Trail"
            visual_tp := partial_tp1_price
            reward_box := box.new(left=bar_index, top=execution_price, right=bar_index + 1, bottom=visual_tp, border_color=color.new(color.green, 100), bgcolor=color.new(color.green, 85))
            trail_act_line := line.new(x1=bar_index, y1=partial_tp1_price, x2=bar_index + 1, y2=partial_tp1_price, color=color.new(color.orange, 0), style=line.style_dashed, width=1)
            trail_act_label := label.new(x=bar_index + 1, y=partial_tp1_price, text="Trail Act", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.orange, 0), size=size.small)
        else
            if useTrailingStop
                visual_tp := trail_act_price
            if partialMode >= 1
                visual_tp := math.min(visual_tp, partial_tp1_price)
            if partialMode == 2
                visual_tp := math.min(visual_tp, partial_tp2_price)
            reward_box := box.new(left=bar_index, top=execution_price, right=bar_index + 1, bottom=visual_tp, border_color=color.new(color.green, 100), bgcolor=color.new(color.green, 85))
            if partialMode >= 1
                tp1_line := line.new(x1=bar_index, y1=partial_tp1_price, x2=bar_index + 1, y2=partial_tp1_price, color=color.new(color.white, 20), style=line.style_dashed, width=1)
                tp1_label := label.new(x=bar_index + 1, y=partial_tp1_price, text="TP1", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.white, 20), size=size.small)
            if partialMode == 2
                tp2_line := line.new(x1=bar_index, y1=partial_tp2_price, x2=bar_index + 1, y2=partial_tp2_price, color=color.new(color.white, 20), style=line.style_dashed, width=1)
                tp2_label := label.new(x=bar_index + 1, y=partial_tp2_price, text="TP2", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.white, 20), size=size.small)
            if useTrailingStop
                trail_act_line := line.new(x1=bar_index, y1=trail_act_price, x2=bar_index + 1, y2=trail_act_price, color=color.new(color.orange, 0), style=line.style_solid, width=1)
                trail_act_label := label.new(x=bar_index + 1, y=trail_act_price, text="Trail Act", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.new(color.orange, 0), size=size.small)

if long_cond or fib_direct_long_cond
    if stopLossType == 5
        sl_price := close - (pending_long_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(close - sl_price)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_long_score) * long_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, close)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = close - failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(close - sl_price)
    
    float riskAmount = strategy.equity * (actualLongRisk / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, close, sl_price, chart_atr, true)
        trade_entry_qty := qty
        string dbg = (fib_direct_long_cond ? "FIB Action Long @ " : "Market Entry Long @ ") + str.tostring(close) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_long_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_long_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_long_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_long_uuid
            f_execute_entry("Long", close, sl_price, qty, f_build_data_string(true, f_entry_debug_suffix(true, close, sl_price, qty), close, sl_price), dbg, current_trade_uuid, "bullish", "market")
        else
            f_cancel_all("Long")
    waiting_bullish_pullback := false 

if short_cond or fib_direct_short_cond
    if stopLossType == 5
        sl_price := close + (pending_short_atr  * effAtrStopMult)
        if showStopLine and not na(debug_sl_line)
            line.set_y1(debug_sl_line, sl_price)
            line.set_y2(debug_sl_line, sl_price)
            label.set_y(debug_sl_label, sl_price)
        if showEslLine and not na(debug_esl_line) and usePerTradeHardStop and perTradeHardStopLimit > 0
            float est_risk = math.abs(sl_price - close)
            float est_riskAmount = strategy.equity * (f_get_risk(pending_short_score) * short_quality_risk_multiplier / 100)
            float est_qtyRaw = est_risk > 0 ? f_floor_qty(est_riskAmount / (est_risk * syminfo.pointvalue)) : 0.0
            float est_qty = f_position_qty(est_qtyRaw, close)
            if est_qty > 0
                float failsafe_dist = (strategy.equity * (perTradeHardStopLimit / 100)) / (est_qty * syminfo.pointvalue)
                float esl_price = close + failsafe_dist
                line.set_y1(debug_esl_line, esl_price)
                line.set_y2(debug_esl_line, esl_price)
                label.set_y(debug_esl_label, esl_price)
    float risk = math.abs(sl_price - close)
    
    float riskAmount = strategy.equity * (actualShortRisk / 100)
    float qtyRaw = risk > 0 ? f_floor_qty(riskAmount / (risk * syminfo.pointvalue)) : 0.0
    if not useDynamicSizing or qtyRaw >= btcQtyStep
        float qty = f_entry_qty(qtyRaw, close, sl_price, chart_atr, false)
        trade_entry_qty := qty
        string dbg = (fib_direct_short_cond ? "FIB Action Short @ " : "Market Entry Short @ ") + str.tostring(close) + " | Score: " + str.tostring(active_fvg_score, "#.##") + " | Vol: " + str.tostring(pending_short_vol_score, "#.##") + " | VWAP: " + str.tostring(math.abs(pending_short_vwap_dist), "#.##") + " | ATR: " + str.tostring(pending_short_atr, "#.##")
        if qty > 0
            current_trade_uuid := pending_short_uuid
            f_execute_entry("Short", close, sl_price, qty, f_build_data_string(false, f_entry_debug_suffix(false, close, sl_price, qty), close, sl_price), dbg, current_trade_uuid, "bearish", "market")
        else
            f_cancel_all("Short")
    waiting_bearish_pullback := false

float profit_cap_limit = usePerTradeProfitKillswitch and not na(tp_price) ? tp_price : na
float long_tp1_exit_limit = usePerTradeProfitKillswitch and not na(tp_price) ? math.min(partial_tp1_price, tp_price) : partial_tp1_price
float long_tp2_exit_limit = usePerTradeProfitKillswitch and not na(tp_price) ? math.min(partial_tp2_price, tp_price) : partial_tp2_price
float short_tp1_exit_limit = usePerTradeProfitKillswitch and not na(tp_price) ? math.max(partial_tp1_price, tp_price) : partial_tp1_price
float short_tp2_exit_limit = usePerTradeProfitKillswitch and not na(tp_price) ? math.max(partial_tp2_price, tp_price) : partial_tp2_price

// ==========================
// Break-Even & Partial TP State
// ==========================
if strategy.position_size > 0
    bool tp1_filled = false
    if exitStrategyType == "Bar-by-Bar Trail"
        tp1_filled := high >= long_tp1_exit_limit
    else
        tp1_filled := not na(trade_q1) and trade_q1 > 0 and math.abs(strategy.position_size) <= (trade_entry_qty - trade_q1 + btcQtyStep * 1e-6)
    if tp1_filled
        partial_tp1_hit := true
    bool tp2_filled = not na(trade_q2) and trade_q2 > 0 and math.abs(strategy.position_size) <= (trade_entry_qty - trade_q1 - trade_q2 + btcQtyStep * 1e-6)
    if tp2_filled
        partial_tp2_hit := true
    bool trail_cond = beActivationMode == 1 ? close >= trail_act_price : high >= trail_act_price
    if not na(trail_act_price) and trail_cond
        trail_act_hit := true

if strategy.position_size < 0
    bool tp1_filled = false
    if exitStrategyType == "Bar-by-Bar Trail"
        tp1_filled := low <= short_tp1_exit_limit
    else
        tp1_filled := not na(trade_q1) and trade_q1 > 0 and math.abs(strategy.position_size) <= (trade_entry_qty - trade_q1 + btcQtyStep * 1e-6)
    if tp1_filled
        partial_tp1_hit := true
    bool tp2_filled = not na(trade_q2) and trade_q2 > 0 and math.abs(strategy.position_size) <= (trade_entry_qty - trade_q1 - trade_q2 + btcQtyStep * 1e-6)
    if tp2_filled
        partial_tp2_hit := true
    bool trail_cond = beActivationMode == 1 ? close <= trail_act_price : low <= trail_act_price
    if not na(trail_act_price) and trail_cond
        trail_act_hit := true

// ==========================
// (Break Even Logic Removed)
// ==========================

// FVG Continuation Trail Logic Removed

// Close-based Stop Loss & Opposing FVG Emergency Exit

bool opp_fvg_kill_long = (exitOnOppFvgInt == 1 and bear_fvg_trigger) or (exitOnOppFvgInt == 2 and bear_fvg_trigger and bear_score >= (trade_fvg_score * oppFvgStrengthFactor))
bool opp_fvg_kill_short = (exitOnOppFvgInt == 1 and bull_fvg_trigger) or (exitOnOppFvgInt == 2 and bull_fvg_trigger and bull_score >= (trade_fvg_score * oppFvgStrengthFactor))


if strategy.position_size > 0 and (close < trade_sl_price or opp_fvg_kill_long)
    string dbg = "Emergency Exit Long | Close<SL: " + str.tostring(close < trade_sl_price) + " | OppFVG: " + str.tostring(opp_fvg_kill_long)
    f_close_all("Long", "Exit Long", f_tp_json(false, dbg, current_trade_uuid + "-SL"))
    if opp_fvg_kill_long
        box opp_fvg_box = box.new(left=bar_index, top=low[2], right=bar_index+5, bottom=high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 80))
        box.set_text(opp_fvg_box, "FVG Kill (" + str.tostring(math.round(bear_score)) + ")")
        box.set_text_color(opp_fvg_box, color.white)
        box.set_text_size(opp_fvg_box, size.normal)

if strategy.position_size < 0 and (close > trade_sl_price or opp_fvg_kill_short)
    string dbg = "Emergency Exit Short | Close>SL: " + str.tostring(close > trade_sl_price) + " | OppFVG: " + str.tostring(opp_fvg_kill_short)
    f_close_all("Short", "Exit Short", f_tp_json(false, dbg, current_trade_uuid + "-SL"))
    if opp_fvg_kill_short
        box opp_fvg_box = box.new(left=bar_index, top=low, right=bar_index+5, bottom=high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80))
        box.set_text(opp_fvg_box, "FVG Kill (" + str.tostring(math.round(bull_score)) + ")")
        box.set_text_color(opp_fvg_box, color.white)
        box.set_text_size(opp_fvg_box, size.normal)

// ==========================
// Prop Firm Drawdown Metrics Tracking
// ==========================
var float peak_closed_equity = strategy.initial_capital // Matches strategy() initial_capital
var float lowest_closed_equity = strategy.initial_capital
var float max_closed_drawdown = 0.0
var float lowest_buffer = propFirmDrawdownLimit // Starts with full buffer

if strategy.closedtrades > nz(strategy.closedtrades[1])
    float current_closed_equity = strategy.initial_capital + strategy.netprofit
    if current_closed_equity > peak_closed_equity
        peak_closed_equity := current_closed_equity
    if current_closed_equity < lowest_closed_equity
        lowest_closed_equity := current_closed_equity
    
    float current_drawdown = peak_closed_equity - current_closed_equity
    if current_drawdown > max_closed_drawdown
        max_closed_drawdown := current_drawdown
    
    // Threshold calculation (Trails up behind peak, caps at initial capital)
    float threshold = math.min(strategy.initial_capital, peak_closed_equity - propFirmDrawdownLimit)
    float current_buffer = current_closed_equity - threshold
    if current_buffer < lowest_buffer
        lowest_buffer := current_buffer

// Target, Break-Even, or Trailing Stop Exit Engine
float eff_sl_exit_long = stopLossBehavior == 1 ? trade_sl_price : na
string reason_sl_long = stopLossBehavior == 1 ? "Standard SL" : "Unknown SL"
if usePerTradeHardStop and perTradeHardStopLimit > 0 and strategy.position_size > 0
    float max_dollar_loss = nz(trade_entry_equity, strategy.equity) * (perTradeHardStopLimit / 100)
    float points_allowed = (max_dollar_loss / nz(trade_entry_qty, math.abs(strategy.position_size))) / syminfo.pointvalue
    float emergency_sl = strategy.opentrades.entry_price(0) - points_allowed
    if na(eff_sl_exit_long) or emergency_sl > eff_sl_exit_long
        reason_sl_long := "Hard Stop (" + str.tostring(perTradeHardStopLimit) + "%)"
    eff_sl_exit_long := na(eff_sl_exit_long) ? emergency_sl : math.max(eff_sl_exit_long, emergency_sl)

bool beTriggered = (slToBreakevenInt == 1 and partial_tp1_hit) or (slToBreakevenInt == 2 and partial_tp2_hit) or (slToBreakevenInt == 3 and partial_tp1_hit) or (slToBreakevenInt == 5 and trail_act_hit)
bool stepToTp1 = (slToBreakevenInt == 3 and partial_tp2_hit)
bool halfRiskTriggered = (slToBreakevenInt == 4 and partial_tp1_hit) or (slToBreakevenInt == 6 and partial_tp2_hit)

if strategy.position_size > 0
    if stepToTp1
        if na(eff_sl_exit_long) or partial_tp1_price > eff_sl_exit_long
            reason_sl_long := "Step BE Hit (TP1)"
        eff_sl_exit_long := na(eff_sl_exit_long) ? partial_tp1_price : math.max(eff_sl_exit_long, partial_tp1_price)
    else if beTriggered
        float be_entry = strategy.opentrades.entry_price(0)
        float be_cost = useCostBreakeven ? (be_entry * 2.0 * estFeePct / 100.0 + syminfo.mintick * estSlippageTicks * 2.0) / math.max(0.000001, 1.0 - estFeePct / 100.0) : 0.0
        float be_price = math.ceil((be_entry + be_cost + beOffsetTicks * syminfo.mintick) / syminfo.mintick) * syminfo.mintick
        if na(eff_sl_exit_long) or be_price > eff_sl_exit_long
            reason_sl_long := "Breakeven SL"
        eff_sl_exit_long := na(eff_sl_exit_long) ? be_price : math.max(eff_sl_exit_long, be_price)
    else if halfRiskTriggered
        float half_risk_price = strategy.opentrades.entry_price(0) - ((strategy.opentrades.entry_price(0) - trade_sl_price) / 2)
        if na(eff_sl_exit_long) or half_risk_price > eff_sl_exit_long
            reason_sl_long := "Half-Risk SL"
        eff_sl_exit_long := na(eff_sl_exit_long) ? half_risk_price : math.max(eff_sl_exit_long, half_risk_price)
    if not exportDataToComments
        reason_sl_long := na

float eff_sl_exit_short = stopLossBehavior == 1 ? trade_sl_price : na
string reason_sl_short = stopLossBehavior == 1 ? "Standard SL" : "Unknown SL"
if usePerTradeHardStop and perTradeHardStopLimit > 0 and strategy.position_size < 0
    float max_dollar_loss = nz(trade_entry_equity, strategy.equity) * (perTradeHardStopLimit / 100)
    float points_allowed = (max_dollar_loss / nz(trade_entry_qty, math.abs(strategy.position_size))) / syminfo.pointvalue
    float emergency_sl = strategy.opentrades.entry_price(0) + points_allowed
    if na(eff_sl_exit_short) or emergency_sl < eff_sl_exit_short
        reason_sl_short := "Hard Stop (" + str.tostring(perTradeHardStopLimit) + "%)"
    eff_sl_exit_short := na(eff_sl_exit_short) ? emergency_sl : math.min(eff_sl_exit_short, emergency_sl)

if strategy.position_size < 0
    if stepToTp1
        if na(eff_sl_exit_short) or partial_tp1_price < eff_sl_exit_short
            reason_sl_short := "Step BE Hit (TP1)"
        eff_sl_exit_short := na(eff_sl_exit_short) ? partial_tp1_price : math.min(eff_sl_exit_short, partial_tp1_price)
    else if beTriggered
        float be_entry = strategy.opentrades.entry_price(0)
        float be_cost = useCostBreakeven ? (be_entry * 2.0 * estFeePct / 100.0 + syminfo.mintick * estSlippageTicks * 2.0) / (1.0 + estFeePct / 100.0) : 0.0
        float be_price = math.floor((be_entry - be_cost - beOffsetTicks * syminfo.mintick) / syminfo.mintick) * syminfo.mintick
        if na(eff_sl_exit_short) or be_price < eff_sl_exit_short
            reason_sl_short := "Breakeven SL"
        eff_sl_exit_short := na(eff_sl_exit_short) ? be_price : math.min(eff_sl_exit_short, be_price)
    else if halfRiskTriggered
        float half_risk_price = strategy.opentrades.entry_price(0) + ((trade_sl_price - strategy.opentrades.entry_price(0)) / 2)
        if na(eff_sl_exit_short) or half_risk_price < eff_sl_exit_short
            reason_sl_short := "Half-Risk SL"
        eff_sl_exit_short := na(eff_sl_exit_short) ? half_risk_price : math.min(eff_sl_exit_short, half_risk_price)
    if not exportDataToComments
        reason_sl_short := na

var int entryTimeMs = na
var float lastPosSize = 0.0

if strategy.position_size != 0 and lastPosSize == 0
    entryTimeMs := timenow
else if strategy.position_size > 0 and lastPosSize < 0
    entryTimeMs := timenow
else if strategy.position_size < 0 and lastPosSize > 0
    entryTimeMs := timenow
else if strategy.position_size == 0
    entryTimeMs := na

lastPosSize := strategy.position_size

bool canPlaceExits = not barstate.isrealtime or na(entryTimeMs) or (timenow - entryTimeMs >= exitPlacementDelay)

float trade_realized_pnl = strategy.position_size != 0 and not na(trade_netprofit_before_entry) ? strategy.netprofit - trade_netprofit_before_entry : 0.0
float trade_total_pnl = strategy.position_size != 0 ? trade_realized_pnl + strategy.openprofit : 0.0
float trade_remaining_qty = math.abs(strategy.position_size)
float trade_entry_price = strategy.position_size != 0 ? strategy.opentrades.entry_price(0) : na
float trade_initial_risk_dollars = strategy.position_size != 0 and not na(trade_entry_price) and not na(trade_sl_price) ? math.abs(trade_entry_price - trade_sl_price) * nz(trade_entry_qty, trade_remaining_qty) * syminfo.pointvalue : na

float runner_trail_price = trail_act_price
float runner_trail_offset_ticks = trail_offset_ticks

var bool exits_placed = false
if strategy.position_size == 0
    exits_placed := false
if canPlaceExits
    if not exits_placed and strategy.position_size != 0
        [q1, q2, qR] = f_get_qtys(trade_entry_qty)
        trade_q1 := q1
        trade_q2 := q2
        trade_qR := qR
        exits_placed := true
    if strategy.position_size > 0
        if exitStrategyType == "Bar-by-Bar Trail"
            if not bbb_trail_active and high >= long_tp1_exit_limit
                bbb_trail_active := true
                float initial_anchor = math.min(low, low[1])
                bbb_trail_sl_long := math.max(nz(eff_sl_exit_long, trade_sl_price), initial_anchor - (barTrailBufferTicks * syminfo.mintick))
            
            if bbb_trail_active and barstate.isconfirmed
                float trail_anchor = math.min(low[0], low[1])
                float proposed_sl = trail_anchor - (barTrailBufferTicks * syminfo.mintick)
                if na(bbb_trail_sl_long) or proposed_sl > bbb_trail_sl_long
                    bbb_trail_sl_long := proposed_sl
            
            float active_sl = na(bbb_trail_sl_long) ? nz(eff_sl_exit_long, trade_sl_price) : bbb_trail_sl_long
            
            if stopLossBehavior == 0
                if not na(profit_cap_limit)
                    strategy.exit("Profit Cap", from_entry="Long", qty=trade_qR, limit=profit_cap_limit, comment_profit="Exit Long (Profit Cap)", alert_message=f_tp_json(false, "Exit Long | BBB Profit Cap", current_trade_uuid + "-CAP"))
                if close < active_sl
                    strategy.close("Long", comment="Exit Long (BBB)", alert_message=f_tp_json(false, "Exit Long | BBB Trail Close", current_trade_uuid + "-BBB"))
            else
                strategy.exit("Runner", from_entry="Long", qty=trade_qR, stop=active_sl, limit=profit_cap_limit, comment_loss="Exit Long (BBB Touch)", comment_profit="Runner Exit", alert_message=f_tp_json(false, "Exit Long | BBB Trail Touch", current_trade_uuid + "-BBB"))
        else if partialMode > 0
            string dbg_p1 = "Exit Long | TP1"
            string dbg_p2 = "Exit Long | TP2"
            string dbg_r = "Exit Long | Runner Trail/SL"
            if partialMode > 0
                if trade_q1 > 0
                    f_do_partial_exit("TP1", "Long", trade_q1, trade_q2 + trade_qR, long_tp1_exit_limit, eff_sl_exit_long, "TP1", reason_sl_long, dbg_p1, current_trade_uuid + "-TP1", "bullish")
            if partialMode == 2
                if trade_q2 > 0
                    f_do_partial_exit("TP2", "Long", trade_q2, trade_qR, long_tp2_exit_limit, eff_sl_exit_long, "TP2", reason_sl_long, dbg_p2, current_trade_uuid + "-TP2", "bullish")
            
            if useTrailingStop
                if trade_qR > 0
                    f_do_trailing_exit("Runner", "Long", trade_qR, 0, profit_cap_limit, eff_sl_exit_long, runner_trail_price, runner_trail_offset_ticks, "Runner Exit", reason_sl_long, dbg_r, current_trade_uuid + "-R", "bullish")
            else
                if trade_qR > 0
                    f_do_partial_exit("Runner", "Long", trade_qR, 0, tp_price, eff_sl_exit_long, "Runner Exit", reason_sl_long, dbg_r, current_trade_uuid + "-R", "bullish")
        else
            if useTrailingStop
                string dbg = "Exit Long | Stop/Trail Active"
                if trade_q1 > 0
                    f_do_trailing_exit("Exit Long 1", "Long", trade_q1, trade_q2 + trade_qR, profit_cap_limit, eff_sl_exit_long, runner_trail_price, runner_trail_offset_ticks, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SL1", "bullish")
                if trade_q2 > 0
                    f_do_trailing_exit("Exit Long 2", "Long", trade_q2, trade_qR, profit_cap_limit, eff_sl_exit_long, runner_trail_price, runner_trail_offset_ticks, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SL2", "bullish")
                if trade_qR > 0
                    f_do_trailing_exit("Exit Long R", "Long", trade_qR, 0, profit_cap_limit, eff_sl_exit_long, runner_trail_price, runner_trail_offset_ticks, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SLR", "bullish")
            else
                string dbg = "Exit Long | Stop/TP Active"
                if trade_q1 > 0
                    f_do_partial_exit("Exit Long 1", "Long", trade_q1, trade_q2 + trade_qR, tp_price, eff_sl_exit_long, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SL1", "bullish")
                if trade_q2 > 0
                    f_do_partial_exit("Exit Long 2", "Long", trade_q2, trade_qR, tp_price, eff_sl_exit_long, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SL2", "bullish")
                if trade_qR > 0
                    f_do_partial_exit("Exit Long R", "Long", trade_qR, 0, tp_price, eff_sl_exit_long, "Exit Long", reason_sl_long, dbg, current_trade_uuid + "-SLR", "bullish")
        
    if strategy.position_size < 0
        if exitStrategyType == "Bar-by-Bar Trail"
            if not bbb_trail_active and low <= short_tp1_exit_limit
                bbb_trail_active := true
                float initial_anchor = math.max(high, high[1])
                bbb_trail_sl_short := math.min(nz(eff_sl_exit_short, trade_sl_price), initial_anchor + (barTrailBufferTicks * syminfo.mintick))
            
            if bbb_trail_active and barstate.isconfirmed
                float trail_anchor = math.max(high[0], high[1])
                float proposed_sl = trail_anchor + (barTrailBufferTicks * syminfo.mintick)
                if na(bbb_trail_sl_short) or proposed_sl < bbb_trail_sl_short
                    bbb_trail_sl_short := proposed_sl
            
            float active_sl = na(bbb_trail_sl_short) ? nz(eff_sl_exit_short, trade_sl_price) : bbb_trail_sl_short
            
            if stopLossBehavior == 0
                if not na(profit_cap_limit)
                    strategy.exit("Profit Cap", from_entry="Short", qty=trade_qR, limit=profit_cap_limit, comment_profit="Exit Short (Profit Cap)", alert_message=f_tp_json(false, "Exit Short | BBB Profit Cap", current_trade_uuid + "-CAP"))
                if close > active_sl
                    strategy.close("Short", comment="Exit Short (BBB)", alert_message=f_tp_json(false, "Exit Short | BBB Trail Close", current_trade_uuid + "-BBB"))
            else
                strategy.exit("Runner", from_entry="Short", qty=trade_qR, stop=active_sl, limit=profit_cap_limit, comment_loss="Exit Short (BBB Touch)", comment_profit="Runner Exit", alert_message=f_tp_json(false, "Exit Short | BBB Trail Touch", current_trade_uuid + "-BBB"))
        else if partialMode > 0
            string dbg_p1 = "Exit Short | TP1"
            string dbg_p2 = "Exit Short | TP2"
            string dbg_r = "Exit Short | Runner Trail/SL"
            if partialMode > 0
                if trade_q1 > 0
                    f_do_partial_exit("TP1", "Short", trade_q1, trade_q2 + trade_qR, short_tp1_exit_limit, eff_sl_exit_short, "TP1", reason_sl_short, dbg_p1, current_trade_uuid + "-TP1", "bearish")
            if partialMode == 2
                if trade_q2 > 0
                    f_do_partial_exit("TP2", "Short", trade_q2, trade_qR, short_tp2_exit_limit, eff_sl_exit_short, "TP2", reason_sl_short, dbg_p2, current_trade_uuid + "-TP2", "bearish")
            
            if useTrailingStop
                if trade_qR > 0
                    f_do_trailing_exit("Runner", "Short", trade_qR, 0, profit_cap_limit, eff_sl_exit_short, runner_trail_price, runner_trail_offset_ticks, "Runner Exit", reason_sl_short, dbg_r, current_trade_uuid + "-R", "bearish")
            else
                if trade_qR > 0
                    f_do_partial_exit("Runner", "Short", trade_qR, 0, tp_price, eff_sl_exit_short, "Runner Exit", reason_sl_short, dbg_r, current_trade_uuid + "-R", "bearish")
        else
            if useTrailingStop
                string dbg = "Exit Short | Stop/Trail Active"
                if trade_q1 > 0
                    f_do_trailing_exit("Exit Short 1", "Short", trade_q1, trade_q2 + trade_qR, profit_cap_limit, eff_sl_exit_short, runner_trail_price, runner_trail_offset_ticks, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SL1", "bearish")
                if trade_q2 > 0
                    f_do_trailing_exit("Exit Short 2", "Short", trade_q2, trade_qR, profit_cap_limit, eff_sl_exit_short, runner_trail_price, runner_trail_offset_ticks, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SL2", "bearish")
                if trade_qR > 0
                    f_do_trailing_exit("Exit Short R", "Short", trade_qR, 0, profit_cap_limit, eff_sl_exit_short, runner_trail_price, runner_trail_offset_ticks, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SLR", "bearish")
            else
                string dbg = "Exit Short | Stop/TP Active"
                if trade_q1 > 0
                    f_do_partial_exit("Exit Short 1", "Short", trade_q1, trade_q2 + trade_qR, tp_price, eff_sl_exit_short, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SL1", "bearish")
                if trade_q2 > 0
                    f_do_partial_exit("Exit Short 2", "Short", trade_q2, trade_qR, tp_price, eff_sl_exit_short, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SL2", "bearish")
                if trade_qR > 0
                    f_do_partial_exit("Exit Short R", "Short", trade_qR, 0, tp_price, eff_sl_exit_short, "Exit Short", reason_sl_short, dbg, current_trade_uuid + "-SLR", "bearish")

if strategy.position_size != 0
    if showTradeBoxes and not na(risk_box)
        if not bbb_trail_active
            box.set_right(risk_box, bar_index + 1)
    if showTradeBoxes and not na(reward_box)
        if not bbb_trail_active
            box.set_right(reward_box, bar_index + 1)
    if showTradeBoxes and not na(tp1_line)
        line.set_x2(tp1_line, bar_index + 1)
        label.set_x(tp1_label, bar_index + 1)
    if showTradeBoxes and not na(tp2_line)
        line.set_x2(tp2_line, bar_index + 1)
        label.set_x(tp2_label, bar_index + 1)
    if showTradeBoxes and not na(trail_act_line)
        if not bbb_trail_active
            line.set_x2(trail_act_line, bar_index + 1)
            label.set_x(trail_act_label, bar_index + 1)
    
    if bbb_trail_active
        float current_sl = strategy.position_size > 0 ? bbb_trail_sl_long : bbb_trail_sl_short
        if not na(current_sl)
            if na(current_bbb_line)
                current_bbb_line := line.new(bar_index, current_sl, bar_index + 1, current_sl, color=color.orange, style=line.style_dashed, width=2)
            else
                float prev_sl = line.get_y1(current_bbb_line)
                if current_sl == prev_sl
                    line.set_x2(current_bbb_line, bar_index + 1)
                else
                    line.new(bar_index, prev_sl, bar_index, current_sl, color=color.orange, style=line.style_dashed, width=2)
                    current_bbb_line := line.new(bar_index, current_sl, bar_index + 1, current_sl, color=color.orange, style=line.style_dashed, width=2)

bool is_time_out_of_bounds = isNewsDay or isWindowExcluded or isNearingWindow or not is_allowed_dow or isBlockedSession or (useTimeRestrictions and na(time(timeframe.period, allowedSession + ":1234567", "America/New_York")))
bool shouldForceCloseSession = forceCloseOnSessionEnd and is_time_out_of_bounds // Decoupled from max_losses_hit
if strategy.position_size != 0 and isFomcLiquidationTime
    f_cancel_all("Long")
    f_cancel_all("Short")
    string fomc_dbg = "FOMC Decision-Day Close | 15 Minutes Before 2:00 PM ET Release"
    if strategy.position_size > 0
        f_close_all("Long", "FOMC Pre-Release Close", f_tp_json(false, fomc_dbg, current_trade_uuid + "-FOMC"))
    if strategy.position_size < 0
        f_close_all("Short", "FOMC Pre-Release Close", f_tp_json(false, fomc_dbg, current_trade_uuid + "-FOMC"))
else if strategy.position_size != 0 and (isEod or shouldForceCloseSession or isNearingWindow)
    f_cancel_all("Long")
    f_cancel_all("Short")
    string dbg = "Force Close | EOD:" + str.tostring(isEod) + " Killswitch:" + str.tostring(dailyKillswitch) + " HardStop:" + str.tostring(hardStopHit) + " MaxLoss:" + str.tostring(max_losses_hit)
    if strategy.position_size > 0
        f_close_all("Long", "EOD Close", f_tp_json(false, dbg, current_trade_uuid + "-EOD"))
    if strategy.position_size < 0
        f_close_all("Short", "EOD Close", f_tp_json(false, dbg, current_trade_uuid + "-EOD"))

if strategy.position_size == 0 and not waiting_bullish_pullback and not waiting_bearish_pullback and not waiting_long_rejection_limit and not waiting_short_rejection_limit and not long_cond and not short_cond and not fib_direct_long_cond and not fib_direct_short_cond
    active_fvg_score := na



// ==========================
// Online/Offline Bot Labels
// ==========================
bool isOffline = dailyKillswitch or hardStopHit or maxProfitHit or max_losses_hit or isNewsDay or isFomcDecisionWindow or isWindowExcluded or isNearingWindow or isEod or isBlockedSession or (useTimeRestrictions and not inSession)
var bool wasOffline = true

if isOffline and not wasOffline
    string offline_reason = "Bot Offline"
    if maxProfitHit
        offline_reason := "Offline: Daily Max Profit Hit"
    else if hardStopHit
        offline_reason := "Offline: Daily Liquidation Hit"
    else if dailyKillswitch
        offline_reason := "Offline: Daily Loss Entry Lockout"
    else if max_losses_hit
        offline_reason := "Offline: Max Losses Hit"
    else if isNewsDay
        offline_reason := "Offline: News Day Blocked"
    else if isWindowExcluded
        offline_reason := "Offline: News Exclusion Window"
    else if isNearingWindow
        offline_reason := "Offline: Nearing News Window"
    else if isEod
        offline_reason := "Offline: EOD Liquidation"
    else if isBlockedSession
        offline_reason := "Offline: Blocked Intra-Day Session"
    else if useTimeRestrictions and not inSession
        offline_reason := "Offline: Outside Allowed Session"

    if showOfflineDots and strategy.position_size == 0
        label.new(bar_index, low, "🔴", yloc=yloc.belowbar, style=label.style_none, textcolor=color.red, size=size.small, tooltip=offline_reason)
else if not isOffline and wasOffline
    if showOfflineDots and strategy.position_size == 0
        label.new(bar_index, low, "🟢", yloc=yloc.belowbar, style=label.style_none, textcolor=color.lime, size=size.small, tooltip="Bot Online")

wasOffline := isOffline

// ==========================
// Status Dashboard UI
// ==========================
var table status_tbl = table.new(position.bottom_right, 1, 1, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast
    string status_txt = "Bot Online"
    color status_col = color.lime
    if dailyKillswitch or hardStopHit or max_losses_hit or maxProfitHit
        status_txt := "Bot Offline"
        status_col := maxProfitHit ? color.lime : color.red
    else if isOffline
        status_txt := "Bot Offline"
        status_col := color.orange
    table.cell(status_tbl, 0, 0, status_txt, text_color=status_col, text_size=size.normal)

var int first_bar_time = time
var table dd_tbl = table.new(position.bottom_left, 2, 8, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast and showPropFirmMetrics
    table.cell(dd_tbl, 0, 0, "Prop Firm Metrics (Closed Trade)", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 70))
    table.merge_cells(dd_tbl, 0, 0, 1, 0)
    
    string date_range = str.format("{0,date,yyyy-MM-dd}", first_bar_time) + " to " + str.format("{0,date,yyyy-MM-dd}", time)
    table.cell(dd_tbl, 0, 1, "Date Range:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 1, date_range, text_color=color.white, text_size=size.small)
    
    table.cell(dd_tbl, 0, 2, "Total Closed Trades:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    
    float win_rate = strategy.closedtrades > 0 ? (strategy.wintrades / float(strategy.closedtrades)) * 100.0 : 0.0
    table.cell(dd_tbl, 0, 3, "Win Rate:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 3, str.tostring(win_rate, "#.##") + "%", text_color=color.white, text_size=size.small)

    table.cell(dd_tbl, 0, 4, "Peak / Lowest Closed:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 4, str.tostring(peak_closed_equity, "$#,###") + " / " + str.tostring(lowest_closed_equity, "$#,###"), text_color=color.white, text_size=size.small)
    
    table.cell(dd_tbl, 0, 5, "Max Closed Drawdown:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 5, str.tostring(max_closed_drawdown, "$#,###.00"), text_color=color.red, text_size=size.small)
    
    table.cell(dd_tbl, 0, 6, "Lowest Buffer Left:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 6, str.tostring(lowest_buffer, "$#,###.00"), text_color=lowest_buffer > 0 ? color.lime : color.red, text_size=size.small)
    
    float final_threshold = math.min(strategy.initial_capital, peak_closed_equity - propFirmDrawdownLimit)
    float final_buffer = (strategy.initial_capital + strategy.netprofit) - final_threshold
    table.cell(dd_tbl, 0, 7, "Current Buffer Left:", text_color=color.gray, text_size=size.small)
    table.cell(dd_tbl, 1, 7, str.tostring(final_buffer, "$#,###.00"), text_color=final_buffer > 0 ? color.lime : color.red, text_size=size.small)

// ==========================
// VWAP Plotting
// ==========================
plot(showVwapLine ? vwapValue : na, color=color.new(color.blue, 0), linewidth=3, title="VWAP")




// =========================================================================
// TradersPost Webhook Replacement Stop Trigger
// =========================================================================
// This detects when a partial Take Profit is filled and fires the replacement
// stop payload via the alert() function, allowing it to bypass TradingView's
// batching limits and utilize TradersPost's 3-second delay.

var float tp_last_pos_size = 0.0
float tp_current_pos_size = strategy.position_size

bool is_long_partial = tp_current_pos_size > 0 and tp_last_pos_size > 0 and tp_current_pos_size < tp_last_pos_size
bool is_short_partial = tp_current_pos_size < 0 and tp_last_pos_size < 0 and tp_current_pos_size > tp_last_pos_size

if (is_long_partial or is_short_partial) and webhookStopMode == 1
    float active_webhook_sl = array.get(active_webhook_sl_arr, 0)
    float remaining_qty = math.round(math.abs(tp_current_pos_size), 8)
    if remaining_qty > 0 and not na(active_webhook_sl)
        string stop_json = f_replacement_stop_json(remaining_qty, active_webhook_sl)
        alert(stop_json, alert.freq_all)

// Update state AFTER evaluation so it only fires on the exact tick/bar of the fill
tp_last_pos_size := tp_current_pos_size
