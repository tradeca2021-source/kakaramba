dbgPos = "top_right"
dbgSize = "small"

G_N = "News filter (PropFirm_News_Dates library)"
useNewsIn = false
blockCPI = true
blockNFP = true
blockFOMC = true
fomcMode = "Decision day 12:00-16:00 ET"
blockPPI = false
