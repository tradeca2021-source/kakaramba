//@version=6
// COMPLETE V102 STANDALONE RECONSTRUCTION. Not a certified original clone.
// Uses the existing repository's v2 anchored/multi-series model, not RBO.
// Working rules: moving terminal, 23.6% reversal, freeze, continuation clones,
// origin violation and opposite series, 50% limits and 38.2%/61.8% brackets.
// Freeze/clone/selection behavior remains an unverified screenshot hypothesis.
// One completed-candle update replaces the artificial two-point high/low walk.
// At most one tracker reversal per candle; original tick behavior is still unknown.
// Default price scaling adapts source distance settings to BTC. Turn autoScale
// OFF for literal source ticks/points on the original instrument and feed.
// StartAnchor0 seeds from the first eligible chart bar; set the reference seed
// and date explicitly for comparisons. Earlier loaded history changes the seed.
// No RBO/SMC/VWAP/volume/news/regime or discretionary trailing filters are applied.
// Pyramiding1 and one OCA entry group allow one fill at a time.
// Bitcoin cost defaults:0.06%/side,2ticks. These do not reproduce source costs.
// Native compilation, original signal parity and performance are unverified.
strategy("CFL Screenshot Reconstruction v102", shorttitle = "CFL v102", overlay = true,
     calc_on_every_tick = false, pyramiding = 1, use_bar_magnifier = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000,
     default_qty_type = strategy.fixed, default_qty_value = 1, margin_long = 0, margin_short = 0,
     initial_capital = 100000, commission_type = strategy.commission.percent, commission_value = 0.06, slippage = 2)

G_T = "Trading (MultiCharts inputs)"
mcMode = true
tickSizeIn = input.float(0, "TickSize (0 = symbol min tick)", minval = 0, group = G_T)
startAnchor = input.float(0.0, "StartAnchor (0 = auto from first bar)", group = G_T)
targetLossTicks = input.int(200, "TargetLossInTicks", minval = 1, group = G_T)
presetIn = "None (use inputs below)"
useRiskSizingIn = input.bool(true, "Size from TargetLossInTicks (hypothesis)", group = G_T)
fixedQtyIn = input.int(1, "Fixed contracts (when risk sizing off)", minval = 1, group = G_T)
maxSlTicksIn = input.int(150, "MaxSlFromEntryInTicks", minval = 1, group = G_T)
minSlTicks = input.int(20, "MinSlFromEntryInTicks", minval = 0, group = G_T)
fr50Ticks = input.int(2, "NumTicksToFrontRun50", minval = 0, group = G_T)
frPtTicks = input.int(4, "NumTicksToFrontRunPt", minval = 0, group = G_T)
ptLevel = input.float(0.382, "Target fib level (working model)", step = 0.001, group = G_T)
stopLevel = input.float(0.618, "Stop fib level (working model)", step = 0.001, group = G_T)
autoScale = input.bool(true, "Auto-scale MinMove / MinSl / MaxSl to price", group = G_T)
scaleRefPx = input.float(7730, "Scale reference price", minval = 1, group = G_T)
fibEngine = "v2 (MC reconstruction)"
zzConfirmation = "Swing retracement"
zzRetracement = 0.236
zzEntryMode = "50% rejection candle"
zzDeviation = 2.5
engineTf = input.timeframe("", "Fib engine timeframe", group = G_T)
v3Htf = false
v3Freeze = 0.5
v3Clone = 0.236
v3ExtRule = false
v3NoClone = false
v3RevPts = 80.0
v4Hours = 250
v4Freeze = 0.236
v4Ext = 0.236
freezePts = input.float(20.0, "v2 freeze: min pullback (points, auto-scaled)", minval = 0, group = G_T)
minMove = input.float(10.0, "MinMove (points)", minval = 0, group = G_T)
extensionLevel = input.float(-0.382, "ExtensionLevel", maxval = 0, group = G_T)
