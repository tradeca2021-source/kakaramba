//@version=6
// Independent approximation: confirmed Supertrend flips, not proprietary logic.
strategy("EngineeringRobo AI - Crypto Strategy", overlay=true, pyramiding=0,
     process_orders_on_close=true, calc_on_order_fills=false, calc_on_every_tick=false,
     use_bar_magnifier=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=100000, margin_long=100, margin_short=100,
     commission_type=strategy.commission.percent, commission_value=0.07, slippage=2,
     max_labels_count=300, max_lines_count=100, max_bars_back=1000,
     behind_chart=false)

enabled = input.bool(true, ">>---------------- EngineeringRobo AI ------------<<")
mult = input.float(2.5, "AI POWER", minval=0.1)
colorCandles = input.bool(true, "CHANGE CANDLE COLOR")
showHold = input.bool(false, "HODL LINE")
showSignals = input.bool(true, "SHOW AI BUY / SELL LABELS")
tradeMode = input.string("Long & Short", "Trade direction", options=["Long & Short", "Long Only", "Short Only"], group="STRATEGY")
useTarget = input.bool(true, "Use take profit", group="STRATEGY")
targetAtr = input.float(2.0, "Target ATR multiple", minval=0.1, step=0.1, group="STRATEGY")
useStop = input.bool(true, "Use stop loss", group="STRATEGY")
stopAtr = input.float(1.0, "Stop-loss ATR multiple", minval=0.1, step=0.1, group="STRATEGY")
closeOnOpposite = input.bool(true, "Close/reverse on opposite signal", group="STRATEGY")
signalAtrLength = input.int(10, "Signal ATR length (chart bars)", minval=1, group="STRATEGY")
riskAtrLength = input.int(14, "Risk ATR length (chart bars)", minval=1, group="STRATEGY")

atr = ta.atr(riskAtrLength)
[st, direction] = ta.supertrend(mult, signalAtrLength)
// Calculate both cross functions on every bar, including when disabled.
rawBuy = ta.crossunder(direction, 0)
rawSell = ta.crossover(direction, 0)
buy = enabled and barstate.isconfirmed and rawBuy
sell = enabled and barstate.isconfirmed and rawSell
longAllowed = tradeMode != "Short Only"
shortAllowed = tradeMode != "Long Only"
ready = not na(atr) and atr > 0 and syminfo.mintick > 0 and close > 0
stopTicks = ready ? math.max(1.0, math.ceil(atr * stopAtr / syminfo.mintick)) : na
targetTicks = ready ? math.max(1.0, math.ceil(atr * targetAtr / syminfo.mintick)) : na
// Reject a projected non-positive long stop or short target on extreme bars.
longValid = ready and (not useStop or close - stopTicks * syminfo.mintick > 0)
shortValid = ready and (not useTarget or close - targetTicks * syminfo.mintick > 0)

var float longStopTicks = na
var float longTargetTicks = na
var float shortStopTicks = na
var float shortTargetTicks = na
bool submittedLong = false
bool submittedShort = false

// Store distances only when submitting a new position; never reset on ignored signals.
if buy
    if longAllowed and longValid and strategy.position_size <= 0 and (closeOnOpposite or strategy.position_size == 0)
        longStopTicks := useStop ? stopTicks : na
        longTargetTicks := useTarget ? targetTicks : na
        strategy.entry("Long", strategy.long, comment="AI BUY", alert_message="EngineeringRobo: target position LONG")
        submittedLong := true
    else if closeOnOpposite and strategy.position_size < 0
        strategy.close("Short", comment="Opposite BUY", alert_message="EngineeringRobo: close SHORT")
if sell
    if shortAllowed and shortValid and strategy.position_size >= 0 and (closeOnOpposite or strategy.position_size == 0)
        shortStopTicks := useStop ? stopTicks : na
        shortTargetTicks := useTarget ? targetTicks : na
        strategy.entry("Short", strategy.short, comment="AI SELL", alert_message="EngineeringRobo: target position SHORT")
        submittedShort := true
    else if closeOnOpposite and strategy.position_size > 0
        strategy.close("Long", comment="Opposite SELL", alert_message="EngineeringRobo: close LONG")

// Submit the bracket WITH the entry; relative ticks anchor to the actual fill.
// No fill recalculation is needed, avoiding historical intrabar re-entry loops.
if (submittedLong or strategy.position_size > 0) and (useTarget or useStop)
    strategy.exit("Long bracket", from_entry="Long", profit=longTargetTicks, loss=longStopTicks,
         comment_profit="Long TP", comment_loss="Long SL", alert_message="EngineeringRobo: LONG bracket exit")
if (submittedShort or strategy.position_size < 0) and (useTarget or useStop)
    strategy.exit("Short bracket", from_entry="Short", profit=shortTargetTicks, loss=shortStopTicks,
         comment_profit="Short TP", comment_loss="Short SL", alert_message="EngineeringRobo: SHORT bracket exit")

plot(enabled and showHold ? st : na, title="HODL Line", color=color.orange, linewidth=2, style=plot.style_linebr)
plotshape(showSignals and buy, title="AI BUY", text="AI BUY", style=shape.labelup,
     location=location.belowbar, color=color.lime, textcolor=color.black, size=size.small)
plotshape(showSignals and sell, title="AI SELL", text="AI SELL", style=shape.labeldown,
     location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
barcolor(enabled and colorCandles ? na(direction) ? color.white : close == open ? color.gray : direction > 0 ? color.red : color.lime : na, title="AI Colors")
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "Filled entry", color=color.gray, style=plot.style_linebr)
float activeStop = strategy.position_size > 0 and useStop ? strategy.position_avg_price - longStopTicks * syminfo.mintick : strategy.position_size < 0 and useStop ? strategy.position_avg_price + shortStopTicks * syminfo.mintick : na
float activeTarget = strategy.position_size > 0 and useTarget ? strategy.position_avg_price + longTargetTicks * syminfo.mintick : strategy.position_size < 0 and useTarget ? strategy.position_avg_price - shortTargetTicks * syminfo.mintick : na
plot(activeStop, "Active stop", color=color.red, style=plot.style_linebr)
plot(activeTarget, "Active target", color=color.lime, style=plot.style_linebr)
plotchar((buy and longAllowed and not longValid) or (sell and shortAllowed and not shortValid), "Invalid ATR / non-positive projected bracket", "!", location=location.top, color=color.orange)
// In strategies, use alert() for confirmed signal alerts and order-fill alerts for executions.
if buy
    alert("EngineeringRobo approximation: confirmed BUY", alert.freq_once_per_bar_close)
if sell
    alert("EngineeringRobo approximation: confirmed SELL", alert.freq_once_per_bar_close)
